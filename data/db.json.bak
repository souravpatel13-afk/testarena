      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "हिन्दी व्याकरण",
      "topic": "तत्सम-तद्भव",
      "exam": "",
      "explanation_hi": "क्षीर' संस्कृत का तत्सम शब्द है, जिसका हिन्दी में परिवर्तित (तद्भव) रूप 'खीर' होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989432-1150-8u8m",
      "text_hi": "दुग्ध' का तद्भव रूप क्या होगा?",
      "text_en": "",
      "options_hi": [
