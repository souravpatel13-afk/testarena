    },
    {
      "id": "q-sheet-1785335989404-1050-b87s",
      "text_hi": "व्याकरणिक विश्लेषण के आधार पर भाषा की इकाइयों को सबसे छोटी इकाई से बड़ी इकाई के क्रम में व्यवस्थित करें- (K) ध्वनि/वर्ण (L) पद/शब्द (M) वाक्य (N) पद्यांश/वाक्यांश",
      "text_en": "",
      "options_hi": [
        "K -> L -> N -> M",
        "L -> K -> M -> N",
        "K -> N -> L -> M",
        "M -> N -> L -> K"
