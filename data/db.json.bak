        "तद्भव",
        "देशज",
        "विदेशज"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "हिन्दी व्याकरण",
      "topic": "तत्सम-तद्भव",
      "exam": "",
      "explanation_hi": "ता' प्रत्ययांत भाववाचक संज्ञाएँ (जैसे- नम्रता, सुंदरता, प्रभुता) तत्सम शब्द होती हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989436-1163-niw9",
      "text_hi": "चढ़ाव' और 'बहाव' शब्द किस श्रेणी में आते हैं?",
      "text_en": "",
      "options_hi": [
        "तत्सम",
        "तद्भव",
        "देशज",
        "विदेशी"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "तत्सम-तद्भव",
      "exam": "",
      "explanation_hi": "जिन भाववाचक संज्ञाओं के अंत में 'आव' होता है (जैसे- बहाव, चढ़ाव), वे तद्भव शब्द कहलाते हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989436-1164-qcsg",
      "text_hi": "इनमें से कौन सा शब्द तत्सम है?",
      "text_en": "",
      "options_hi": [
        "पहिया",
        "आटा",
        "चमड़ा",
        "सरोज"
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "हिन्दी व्याकरण",
      "topic": "तत्सम-तद्भव",
      "exam": "",
      "explanation_hi": "सरोज' ('ज' प्रत्ययांत) तत्सम शब्द है, जबकि पहिया, आटा, चमड़ा तद्भव (हिन्दी) शब्द हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989436-1165-3mn6",
      "text_hi": "नदी' शब्द उद्गम की दृष्टि से किस प्रकार का शब्द है?",
      "text_en": "",
      "options_hi": [
        "तत्सम",
        "तद्भव",
        "विदेशी",
        "देशज"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "तत्सम-तद्भव",
      "exam": "",
      "explanation_hi": "ईकारांत शब्द 'नदी' (तथा टोपी, चिट्ठी आदि) को हिन्दी व्याकरण में तद्भव शब्दों की श्रेणी में रखा गया है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989436-1166-7sdw",
      "text_hi": "बिजली' का पर्यायवाची शब्द निम्नलिखित में से कौन सा है?",
      "text_en": "",
      "options_hi": [
        "खड्ग",
        "चाप",
        "सुधी",
        "चपला"
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "हिन्दी व्याकरण",
      "topic": "पर्यायवाची",
      "exam": "",
      "explanation_hi": "ईएमआरएस परीक्षा के प्रश्नपत्र के अनुसार 'चपला' बिजली का सही पर्यायवाची है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989437-1167-xpsi",
      "text_hi": "परुष' का विलोम शब्द क्या है?",
      "text_en": "",
      "options_hi": [
        "कठोर",
        "सरल",
        "अपौरुष",
        "कोमल"
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "हिन्दी व्याकरण",
      "topic": "विलोम शब्द",
      "exam": "",
      "explanation_hi": "परुष' का अर्थ कठोर होता है, अतः इसका विपरीत अर्थ देने वाला शब्द 'कोमल' है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989437-1168-74fn",
      "text_hi": "निम्नलिखित में से कौन सा विलोमार्थी शब्द-युग्म असंगत (गलत) है?",
      "text_en": "",
      "options_hi": [
        "औरस - जारज",
        "प्राचीन - अर्वाचीन",
        "अज्ञात - अविदित",
        "आसक्त - विरक्त"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "हिन्दी व्याकरण",
      "topic": "विलोम शब्द",
      "exam": "",
      "explanation_hi": "अज्ञात' और 'अविदित' दोनों का अर्थ 'जो ज्ञात न हो' है, अतः ये पर्यायवाची हैं। अन्य सभी युग्म सही विलोम हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989437-1169-g0oo",
      "text_hi": "औरस' का सही विलोम शब्द क्या है?",
      "text_en": "",
      "options_hi": [
        "जारज",
        "विरक्त",
        "अविदित",
        "अर्वाचीन"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "हिन्दी व्याकरण",
      "topic": "विलोम शब्द",
      "exam": "",
      "explanation_hi": "परीक्षा के विकल्पों के सटीक युग्म के आधार पर 'औरस' का सही विलोम शब्द 'जारज' होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989437-1170-3enb",
      "text_hi": "प्राचीन' शब्द का विलोम क्या होगा?",
      "text_en": "",
      "options_hi": [
        "नवीन",
        "अर्वाचीन",
        "पुराना",
        "ऐतिहासिक"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "विलोम शब्द",
      "exam": "",
      "explanation_hi": "प्राचीन' (पुराना) का सटीक विलोम 'अर्वाचीन' (नया/आधुनिक) होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989437-1171-lqq5",
      "text_hi": "आसक्त' का विलोमार्थी शब्द क्या है?",
      "text_en": "",
      "options_hi": [
        "अनासक्त",
        "विरक्त",
        "अविदित",
        "जारज"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "विलोम शब्द",
      "exam": "",
      "explanation_hi": "आसक्त' (लगाव रखने वाला) का सही विलोम शब्द 'विरक्त' होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989438-1172-22pb",
      "text_hi": "अंग्रेजी शब्द 'HEFTY' का सही विलोम (Opposite) क्या है?",
      "text_en": "",
      "options_hi": [
        "Slight",
        "Huge",
        "Dishonest",
        "Severe"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "General English",
      "topic": "Antonyms",
      "exam": "",
      "explanation_hi": "Hefty' (भारी/मोटा) का विपरीतार्थी 'Slight' (हल्का/थोड़ा) होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989438-1173-su2s",
      "text_hi": "अंग्रेजी शब्द 'DART' का निकटतम अर्थ (Synonym) क्या है?",
      "text_en": "",
      "options_hi": [
        "Daub",
        "Flee",
        "Dash",
        "Deter"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Synonyms",
      "exam": "",
      "explanation_hi": "Dart' का अर्थ तेजी से आगे बढ़ना या झपटना होता है, जिसका समानार्थी 'Dash' है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989438-1174-yht0",
      "text_hi": "Gullible' शब्द के सबसे निकटतम अर्थ (Synonym) वाला शब्द चुनें-",
      "text_en": "",
      "options_hi": [
        "Naïve",
        "Distrustful",
        "Complicated",
        "Cacophony"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "General English",
      "topic": "Synonyms",
      "exam": "",
      "explanation_hi": "हाई कोर्ट डीईओ (High court DEO) परीक्षा के अनुसार 'Gullible' (आसानी से धोखा खाने वाला) का समानार्थी 'Naïve' (भोला-भाला) है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989438-1175-3cis",
      "text_hi": "Impervious' शब्द का सबसे विपरीत (Opposite) अर्थ वाला शब्द कौन सा है?",
      "text_en": "",
      "options_hi": [
        "Tolerable",
        "Penetrable",
        "Parsimonious",
        "Impertinent"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Antonyms",
      "exam": "",
      "explanation_hi": "Impervious' (अभेद्य/जिसमें प्रवेश न किया जा सके) का विलोम 'Penetrable' (भेद्य) होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989439-1176-2j0b",
      "text_hi": "Keen' शब्द के सही समानार्थी (Synonyms) शब्दों का समूह चुनें-",
      "text_en": "",
      "options_hi": [
        "Sharp और Eager",
        "Sharp, Eager और Intense",
        "Eager और Sensitive",
        "Sharp और Intense"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Synonyms",
      "exam": "",
      "explanation_hi": "Keen' के समानार्थी के रूप में Sharp, Eager और Intense तीनों शब्दों को सही माना गया है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989439-1177-c53d",
      "text_hi": "गुण स्वर संधि के नियमानुसार, यदि 'अ' या 'आ' के बाद 'इ' या 'ई' आए तो दोनों मिलकर क्या हो जाते हैं?",
      "text_en": "",
      "options_hi": [
        "ऐ",
        "ए",
        "ओ",
        "अर्"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "संधि के नियम",
      "exam": "",
      "explanation_hi": "यदि 'अ' या 'आ' के बाद 'इ' या 'ई' आये तो दोनों मिलकर 'ए' हो जाते हैं। जैसे- देव + इंद्र = देवेन्द्र।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989439-1178-d5eu",
      "text_hi": "यदि 'इ' या 'ई' के बाद कोई भिन्न स्वर आए तो 'इ/ई' का परिवर्तन किस वर्ण में हो जाता है?",
      "text_en": "",
      "options_hi": [
        "य्",
        "व्",
        "र्",
        "ल्"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "हिन्दी व्याकरण",
      "topic": "संधि के नियम",
      "exam": "",
      "explanation_hi": "यह यण स्वर संधि का नियम है, जिसमें इ/ई का परिवर्तन 'य्' में हो जाता है (जैसे- अति + अधिक = अत्यधिक)।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989439-1179-mqmc",
      "text_hi": "यदि 'ए', 'ऐ', 'ओ', 'औ' के बाद कोई भिन्न स्वर आए, तो 'ए' का क्या हो जाता है?",
      "text_en": "",
      "options_hi": [
        "आय",
        "आव",
        "अय",
        "अव"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "हिन्दी व्याकरण",
      "topic": "संधि के नियम",
      "exam": "",
      "explanation_hi": "अयादि स्वर संधि के नियमानुसार 'ए' का 'अय', 'ऐ' का 'आय', 'ओ' का 'अव' तथा 'औ' का 'आव' हो जाता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989440-1180-3ar4",
      "text_hi": "व्यंजन संधि के पहले नियम के अनुसार, यदि वर्ग के पहले वर्ण (क, च, ट, त, प) का मेल किसी स्वर से हो तो वह अपने वर्ग के किस वर्ण में बदल जाता है?",
      "text_en": "",
      "options_hi": [
        "दूसरे",
        "तीसरे",
        "चौथे",
        "पाँचवें"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "संधि के नियम",
      "exam": "",
      "explanation_hi": "वर्ग का पहला वर्ण अपने ही वर्ग के तीसरे वर्ण में बदल जाता है (जैसे क् का ग्, त् का द्)। उदाहरण- वाक् + ईश = वागीश।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989440-1181-8hpe",
      "text_hi": "व्यंजन संधि के नियमानुसार, यदि 'क्' का मेल 'म्' या 'न्' (अनुनासिक वर्ण) से हो, तो 'क्' किसमें परिवर्तित होगा?",
      "text_en": "",
      "options_hi": [
        "ग्",
        "ङ्",
        "च्",
        "ण्"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "संधि के नियम",
      "exam": "",
      "explanation_hi": "यदि वर्ग के पहले वर्ण का मेल अनुनासिक वर्ण से हो तो वह अपने ही वर्ग के पाँचवें वर्ण में बदल जाता है (क् का ङ्)। जैसे- वाक् + मय = वाङ्मय।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989440-1182-a2ih",
      "text_hi": "यदि 'त्' के बाद 'ल्' आए, तो 'त्' का परिवर्तन किसमें हो जाता है? (जैसे- उत् + लास)",
      "text_en": "",
      "options_hi": [
        "ज्",
        "च्",
        "ल्",
        "ड्"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "हिन्दी व्याकरण",
      "topic": "संधि के नियम",
      "exam": "",
      "explanation_hi": "त्' संबंधी नियम के अनुसार, 'त्' का मेल यदि 'ल्' से हो रहा हो तो 'त्' वर्ण 'ल्' में बदल जाता है (उत् + लास = उल्लास)।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989440-1183-y712",
      "text_hi": "सम् + कल्प = संकल्प' में 'म्' का मेल 'क्' से होने पर 'म्' का क्या बन जाता है?",
      "text_en": "",
      "options_hi": [
        "न्",
        "अनुस्वार (ं)",
        "ल्",
        "च्"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "संधि के नियम",
      "exam": "",
      "explanation_hi": "म्' संबंधी नियम: यदि 'म्' का मेल 'क्' से लेकर 'भ्' तक के किसी भी व्यंजन से होता है, तो 'म्' अनुस्वार (ं) में बदल जाता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989441-1184-8uxx",
      "text_hi": "विसर्ग (:) के बाद यदि 'च' या 'छ' हो तो विसर्ग का परिवर्तन किस वर्ण में होता है?",
      "text_en": "",
      "options_hi": [
        "स्",
        "ष्",
        "श्",
        "र्"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "हिन्दी व्याकरण",
      "topic": "संधि के नियम",
      "exam": "",
      "explanation_hi": "विसर्ग के बाद 'च' या 'छ' हो तो विसर्ग का 'श्' हो जाता है। जैसे- नि: + चय = निश्चय।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989441-1185-m64g",
      "text_hi": "व्यंजन संधि के 'छ' संबंधी नियम के अनुसार, यदि किसी स्वर का मेल 'छ' से हो, तो 'छ' के स्थान पर क्या हो जाता है?",
      "text_en": "",
      "options_hi": [
        "च्छ",
        "श्छ",
        "क्छ",
        "त्छ"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "हिन्दी व्याकरण",
      "topic": "संधि के नियम",
      "exam": "",
      "explanation_hi": "यदि पहले पद के अंत में कोई स्वर हो और दूसरे पद के प्रारम्भ में 'छ' हो, तो 'छ' के स्थान पर 'च्छ' हो जाता है। जैसे- आ + छादन = आच्छादन।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989441-1186-qu6m",
      "text_hi": "वृद्धि स्वर संधि के नियम के अनुसार, 'अ' या 'आ' के बाद यदि 'ओ' या 'औ' आए, तो दोनों के स्थान पर क्या हो जाता है?",
      "text_en": "",
      "options_hi": [
        "ए",
        "ऐ",
        "ओ",
        "औ"
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "हिन्दी व्याकरण",
      "topic": "संधि के नियम",
      "exam": "",
      "explanation_hi": "अ या आ के बाद ओ या औ आए तो दोनों मिलकर 'औ' हो जाते हैं। जैसे- महा + ओजस्वी = महौजस्वी।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989441-1187-rnyg",
      "text_hi": "पो + अन = पवन' में 'ओ + अ' मिलकर 'अव' हो जाता है। यह किस संधि का नियम है?",
      "text_en": "",
      "options_hi": [
        "गुण स्वर संधि",
        "यण स्वर संधि",
        "अयादि स्वर संधि",
        "वृद्धि स्वर संधि"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "हिन्दी व्याकरण",
      "topic": "संधि के नियम",
      "exam": "",
      "explanation_hi": "यह अयादि स्वर संधि का नियम है जहाँ 'ओ' के बाद भिन्न स्वर 'अ' आने पर वह 'अव' में बदल गया है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989442-1188-if00",
      "text_hi": "विसर्ग संधि के नियम के अनुसार, 'निः + चल' मिलकर क्या बनेगा?",
      "text_en": "",
      "options_hi": [
        "निश्छल",
        "निश्चल",
        "निसचल",
        "निष्चल"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "संधि के नियम",
      "exam": "",
      "explanation_hi": "चूँकि विसर्ग के बाद 'च' है, इसलिए विसर्ग 'श्' में बदल जाएगा और सही शब्द 'निश्चल' बनेगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989443-1189-z6gz",
      "text_hi": "यदि 'त्' या 'द्' के बाद 'च' या 'छ' हो, तो 'त्/द्' का क्या हो जाता है?",
      "text_en": "",
      "options_hi": [
        "ज्",
        "श्",
        "च्",
        "ट्"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "हिन्दी व्याकरण",
      "topic": "संधि के नियम",
      "exam": "",
      "explanation_hi": "त्' के बाद यदि 'च' या 'छ' हो तो 'त्' का 'च्' हो जाता है। जैसे- उत् + चारण = उच्चारण।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989443-1190-jln5",
      "text_hi": "यदि विसर्ग के पूर्व 'अ' हो तथा बाद में वर्गों का तीसरा, चौथा, पाँचवाँ वर्ण या य, र, ल, व, ह हो, तो विसर्ग का क्या हो जाता है?",
      "text_en": "",
      "options_hi": [
        "र्",
        "ओ",
        "श्",
        "लोप हो जाता है"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "संधि के नियम",
      "exam": "",
      "explanation_hi": "यह विसर्ग संधि का एक प्रमुख नियम है जहाँ विसर्ग 'ओ' में बदल जाता है। जैसे- मनः + योग = मनोयोग।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989443-1191-xybn",
      "text_hi": "यदि 'ऋ' के बाद कोई भिन्न स्वर आए तो 'ऋ' का परिवर्तन किसमें हो जाता है? (जैसे- पितृ + आदेश)",
      "text_en": "",
      "options_hi": [
        "र्",
        "ल्",
        "य्",
        "व्"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "हिन्दी व्याकरण",
      "topic": "संधि के नियम",
      "exam": "",
      "explanation_hi": "यण संधि के नियमानुसार यदि 'ऋ' के बाद कोई भिन्न स्वर आये तो 'ऋ' का 'र्' हो जाता है (पितृ + आदेश = पित्रादेश)।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989443-1192-bng6",
      "text_hi": "जो शब्दांश किसी शब्द के पहले जुड़कर नया सार्थक शब्द बनाते हैं, उन्हें क्या कहा जाता है?",
      "text_en": "",
      "options_hi": [
        "प्रत्यय",
        "समास",
        "उपसर्ग",
        "संधि"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "हिन्दी व्याकरण",
      "topic": "उपसर्ग",
      "exam": "",
      "explanation_hi": "ऐसे शब्दांश जो किसी अन्य शब्द के पहले (आरंभ में) जुड़कर नया सार्थक शब्द बनाते हैं, उन्हें उपसर्ग कहते हैं। (पृष्ठ 150)",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989444-1193-4yeu",
      "text_hi": "हिन्दी भाषा में मुख्य रूप से कितने प्रकार के उपसर्गों का प्रयोग होता है?",
      "text_en": "",
      "options_hi": [
        "दो",
        "तीन",
        "चार",
        "पाँच"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "उपसर्ग",
      "exam": "",
      "explanation_hi": "हिन्दी में मुख्यतः तीन प्रकार के उपसर्ग प्रयुक्त होते हैं- 1. तत्सम (संस्कृत) 2. तद्भव (हिन्दी) और 3. विदेशज (अरबी-फारसी एवं अंग्रेजी)।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989444-1194-55km",
      "text_hi": "अत्यंत' शब्द में किस उपसर्ग का प्रयोग हुआ है?",
      "text_en": "",
      "options_hi": [
        "अत",
        "अति",
        "अ",
        "अत्य"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "उपसर्ग",
      "exam": "",
      "explanation_hi": "अत्यंत' शब्द 'अति + अंत' से मिलकर बना है, जिसमें 'अति' एक संस्कृत (तत्सम) उपसर्ग है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989444-1195-zgy9",
      "text_hi": "अध्यक्ष' शब्द का निर्माण किस उपसर्ग के योग से हुआ है?",
      "text_en": "",
      "options_hi": [
        "अ",
        "अध",
        "अधि",
        "आ"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "हिन्दी व्याकरण",
      "topic": "उपसर्ग",
      "exam": "",
      "explanation_hi": "अध्यक्ष' शब्द 'अधि + अक्ष' से बना है। यहाँ 'अधि' (जिसका अर्थ ऊँचा या श्रेष्ठ होता है) उपसर्ग का प्रयोग हुआ है। (पृष्ठ 151)",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989444-1196-b3wm",
      "text_hi": "अनजान' और 'अनपढ़' शब्दों में किस प्रकार के उपसर्ग का प्रयोग हुआ है?",
      "text_en": "",
      "options_hi": [
        "संस्कृत (तत्सम)",
        "हिन्दी (तद्भव)",
        "अरबी-फारसी",
        "अंग्रेजी"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "उपसर्ग",
      "exam": "",
      "explanation_hi": "अन' (जैसे- अनजान, अनपढ़) एक हिन्दी (तद्भव) उपसर्ग है जिसका अर्थ 'निषेध' या 'अभाव' होता है। (पृष्ठ 157)",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989445-1197-xz97",
      "text_hi": "अपयश' और 'अपमान' शब्दों में प्रयुक्त 'अप' उपसर्ग का मुख्य अर्थ क्या होता है?",
      "text_en": "",
      "options_hi": [
        "श्रेष्ठ या ऊपर",
        "अनुचित, बुरा या हीनता",
        "पीछे या समान",
        "अधिकता या पूर्णता"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "उपसर्ग",
      "exam": "",
      "explanation_hi": "अप' एक तत्सम उपसर्ग है, जिसका प्रयोग प्रायः अनुचित, बुरे, विरुद्ध या हीनता के अर्थ में होता है (जैसे- अप+यश = अपयश)।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989445-1198-n8on",
      "text_hi": "खुशबू' और 'खुशखबरी' शब्दों में प्रयुक्त 'खुश' किस भाषा का उपसर्ग है?",
      "text_en": "",
      "options_hi": [
        "हिन्दी",
        "संस्कृत",
        "अरबी-फारसी",
        "अंग्रेजी"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "हिन्दी व्याकरण",
      "topic": "उपसर्ग",
      "exam": "",
      "explanation_hi": "खुश' (जिसका अर्थ 'अच्छा' होता है) एक अरबी-फारसी (विदेशज) भाषा का उपसर्ग है। (पृष्ठ 158)",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989445-1199-rqlw",
      "text_hi": "सब-इंस्पेक्टर' और 'डिप्टी-कलेक्टर' में प्रयुक्त 'सब' (Sub) और 'डिप्टी' (Deputy) किस श्रेणी के उपसर्ग हैं?",
      "text_en": "",
      "options_hi": [
        "तत्सम",
        "तद्भव",
        "अरबी",
        "अंग्रेजी (विदेशज)"
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "हिन्दी व्याकरण",
      "topic": "उपसर्ग",
      "exam": "",
      "explanation_hi": "सब' (अधीन/नीचे) और 'डिप्टी' (सहायक) अंग्रेजी भाषा के विदेशज उपसर्ग हैं जो हिन्दी में प्रयुक्त होते हैं। (पृष्ठ 159)",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989446-1200-slpp",
      "text_hi": "निर्बल' शब्द में कौन सा उपसर्ग प्रयुक्त हुआ है?",
      "text_en": "",
      "options_hi": [
        "नि",
        "निर्",
        "नि:",
        "नी"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "उपसर्ग",
      "exam": "",
      "explanation_hi": "निर्बल' शब्द 'निर्' (उपसर्ग) और 'बल' (मूल शब्द) के योग से बना है। (निर् + बल = निर्बल) (पृष्ठ 150)",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989446-1201-3dms",
      "text_hi": "जो शब्दांश शब्द या धातु (क्रिया) के अंत में जुड़कर नए सार्थक शब्द का निर्माण करते हैं, उन्हें क्या कहते हैं?",
      "text_en": "",
      "options_hi": [
        "उपसर्ग",
        "संधि",
        "प्रत्यय",
        "अव्यय"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "हिन्दी व्याकरण",
      "topic": "प्रत्यय",
      "exam": "",
      "explanation_hi": "प्रत्यय वे शब्दांश हैं जो किसी शब्द या धातु (क्रिया) के अंत में जोड़े जाते हैं (जैसे- जल + आऊ = जलाऊ)। (पृष्ठ 160)",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989446-1202-5qu6",
      "text_hi": "हिन्दी व्याकरण में प्रत्यय मुख्य रूप से कितने प्रकार के होते हैं?",
      "text_en": "",
      "options_hi": [
        "दो",
        "तीन",
        "चार",
        "पाँच"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "हिन्दी व्याकरण",
      "topic": "प्रत्यय",
      "exam": "",
      "explanation_hi": "प्रत्यय मुख्य रूप से दो प्रकार के होते हैं: 1. कृत् प्रत्यय और 2. तद्धित प्रत्यय।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989446-1203-6ez0",
      "text_hi": "जो प्रत्यय धातु या क्रिया के मूल रूप के अंत में जोड़े जाते हैं, उन्हें क्या कहा जाता है?",
      "text_en": "",
      "options_hi": [
        "तद्धित प्रत्यय",
        "कृत् प्रत्यय",
        "देशज प्रत्यय",
        "विदेशी प्रत्यय"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "प्रत्यय",
      "exam": "",
      "explanation_hi": "क्रिया या धातु के अंत में लगने वाले प्रत्ययों को 'कृत् प्रत्यय' कहते हैं और इनसे बने शब्द 'कृदन्त' कहलाते हैं। (पृष्ठ 160)",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989446-1204-yael",
      "text_hi": "संज्ञा, सर्वनाम या विशेषण शब्दों के अंत में जुड़ने वाले प्रत्यय क्या कहलाते हैं?",
      "text_en": "",
      "options_hi": [
        "कृत् प्रत्यय",
        "तद्धित प्रत्यय",
        "स्त्री प्रत्यय",
        "उपसर्ग"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "प्रत्यय",
      "exam": "",
      "explanation_hi": "क्रिया (धातु) को छोड़कर अन्य शब्दों (संज्ञा, सर्वनाम, विशेषण) के अंत में लगने वाले प्रत्यय 'तद्धित प्रत्यय' कहलाते हैं। (पृष्ठ 163)",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989447-1205-58cw",
      "text_hi": "तैराक' शब्द में कौन सा प्रत्यय जुड़ा हुआ है?",
      "text_en": "",
      "options_hi": [
        "क",
        "आक",
        "राक",
        "तैरा"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "प्रत्यय",
      "exam": "",
      "explanation_hi": "तैर' (धातु) में 'आक' कृत् प्रत्यय जुड़ने से 'तैराक' शब्द बनता है। (तैर + आक = तैराक) (पृष्ठ 161)",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989447-1206-1ya2",
      "text_hi": "बुढ़ापा' और 'मोटापा' शब्दों में किस प्रत्यय का प्रयोग हुआ है?",
      "text_en": "",
      "options_hi": [
        "पा",
        "आप",
        "आपा",
        "बूढ़ा"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "हिन्दी व्याकरण",
      "topic": "प्रत्यय",
      "exam": "",
      "explanation_hi": "बूढ़ा' तथा 'मोटा' (विशेषण) शब्द में 'आपा' तद्धित प्रत्यय जुड़ने से क्रमशः बुढ़ापा और मोटापा भाववाचक संज्ञाएँ बनती हैं। (पृष्ठ 164)",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989447-1207-ga0t",
      "text_hi": "लिखावट' और 'थकावट' शब्दों में कौन सा प्रत्यय मौजूद है?",
      "text_en": "",
      "options_hi": [
        "वट",
        "आवट",
        "ट",
        "आहट"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "प्रत्यय",
      "exam": "",
      "explanation_hi": "लिख' और 'थक' धातुओं में 'आवट' कृत् प्रत्यय जुड़ने से क्रमशः लिखावट और थकावट शब्द बनते हैं। (पृष्ठ 162)",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989447-1208-t82s",
      "text_hi": "घबराहट' और 'चिल्लाहट' में किस प्रत्यय का प्रयोग किया गया है?",
      "text_en": "",
      "options_hi": [
        "हट",
        "आहट",
        "आवट",
        "राहट"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "प्रत्यय",
      "exam": "",
      "explanation_hi": "घबरा' धातु में 'आहट' प्रत्यय जुड़ने से भाववाचक कृदन्त 'घबराहट' बनता है। (घबरा + आहट = घबराहट)",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989448-1209-xeuk",
      "text_hi": "डिबिया' और 'खटिया' शब्दों में प्रयुक्त प्रत्यय कौन सा है?",
      "text_en": "",
      "options_hi": [
        "या",
        "इया",
        "ईया",
        "आया"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "प्रत्यय",
      "exam": "",
      "explanation_hi": "डिब्बा तथा खाट जैसे शब्दों में ऊनतावाचक (छोटापन दर्शाने वाला) 'इया' तद्धित प्रत्यय लगने से 'डिबिया' और 'खटिया' बनते हैं। (पृष्ठ 173)",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989448-1210-16bo",
      "text_hi": "बाघिन' और 'मालकिन' शब्दों में स्त्रीलिंग बनाने के लिए किस प्रत्यय का प्रयोग हुआ है?",
      "text_en": "",
      "options_hi": [
        "नी",
        "आनी",
        "इन",
        "आइन"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "हिन्दी व्याकरण",
      "topic": "प्रत्यय",
      "exam": "",
      "explanation_hi": "पुर्लिंग शब्दों को स्त्रीलिंग बनाने के लिए 'इन' (स्त्री प्रत्यय) का प्रयोग किया गया है (जैसे: बाघ + इन = बाघिन)। (पृष्ठ 177)",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989448-1211-l4sl",
      "text_hi": "प्रत्यय के नियमों के अनुसार, जब 'धर्म' शब्द में 'इक' प्रत्यय जुड़ता है, तो कौन सा नया शब्द बनता है?",
      "text_en": "",
      "options_hi": [
        "धर्मिक",
        "धार्मिक",
        "धार्मीक",
        "धर्माक"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "प्रत्यय",
      "exam": "",
      "explanation_hi": "व्याकरण के नियमानुसार, 'इक' प्रत्यय लगने पर अनेक शब्दों के प्रारंभिक स्वर 'अ' का 'आ' हो जाता है। अतः धर्म + इक = धार्मिक बनता है। (पृष्ठ 165)",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989448-1212-o6bg",
      "text_hi": "Bread and butter _______ my favourite breakfast.",
      "text_en": "",
      "options_hi": [
        "are",
        "is",
        "have",
        "has"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Syntax (Subject-Verb Agreement)",
      "exam": "",
      "explanation_hi": "जब दो Singular Nouns 'and' से जुड़कर एक ही वस्तु या भाव (Pair words) का बोध कराते हैं, तो इसके साथ Singular Verb का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989448-1213-dfam",
      "text_hi": "Many a boy _______ to college in time.",
      "text_en": "",
      "options_hi": [
        "go",
        "goes",
        "going",
        "gone"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Syntax (Subject-Verb Agreement)",
      "exam": "",
      "explanation_hi": "Many a' या 'Many an' के बाद Singular Countable Noun तथा Singular Verb का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989449-1214-ecoy",
      "text_hi": "_______ water of this well is fresh.",
      "text_en": "",
      "options_hi": [
        "A",
        "An",
        "The",
        "No Article"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Articles",
      "exam": "",
      "explanation_hi": "Noun + of + Noun के Structure (बनावट) में first Noun (जैसे यहाँ water) के पहले हमेशा 'The' का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989449-1215-slu8",
      "text_hi": "He is _______ honest man.",
      "text_en": "",
      "options_hi": [
        "a",
        "an",
        "the",
        "no article"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Articles",
      "exam": "",
      "explanation_hi": "Honest' शब्द consonant 'h' से शुरू होता है लेकिन इसका उच्चारण vowel sound (ऑनेस्ट) से होता है, इसलिए इसके पहले 'An' का प्रयोग होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989450-1216-3elj",
      "text_hi": "Choose the correct sentence:",
      "text_en": "",
      "options_hi": [
        "He gave me an advice.",
        "He gave me advices.",
        "He gave me a piece of advice.",
        "He give me a advice."
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Noun",
      "exam": "",
      "explanation_hi": "Advice एक Singular Uncountable Noun है। इसे Singular Countable बनाने के लिए 'A piece of advice' का प्रयोग किया जाता है, सीधे A/An का नहीं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989450-1217-tigm",
      "text_hi": "The cattle _______ grazing in the field.",
      "text_en": "",
      "options_hi": [
        "is",
        "was",
        "has",
        "are"
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "General English",
      "topic": "Noun",
      "exam": "",
      "explanation_hi": "Cattle (मवेशी) देखने में singular लगता है, लेकिन यह Plural Noun है। इसलिए इसके साथ हमेशा Plural verb (are) का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989450-1218-h5mf",
      "text_hi": "It is I who _______ helped you.",
      "text_en": "",
      "options_hi": [
        "has",
        "have",
        "is",
        "had"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Pronoun",
      "exam": "",
      "explanation_hi": "Relative Pronoun (who/which/that) के बाद आने वाला verb हमेशा उसके Antecedent (यहाँ 'I') के अनुसार होता है। 'I' के साथ 'have' लगता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989451-1219-62ph",
      "text_hi": "One should love _______ country.",
      "text_en": "",
      "options_hi": [
        "his",
        "her",
        "one's",
        "their"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Pronoun",
      "exam": "",
      "explanation_hi": "जब 'One' का प्रयोग sentence के Subject के रूप में होता है, तो इसके लिए Possessive Adjective के रूप में 'one's' का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989451-1220-65xu",
      "text_hi": "Mukesh is senior _______ his brothers.",
      "text_en": "",
      "options_hi": [
        "than",
        "to",
        "from",
        "by"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Adjective",
      "exam": "",
      "explanation_hi": "Latin Adjectives (जैसे- Junior, Senior, Inferior, Superior, Prior) के बाद Comparative degree में 'than' की जगह preposition 'to' का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989451-1221-c86k",
      "text_hi": "He _______ to Mumbai yesterday.",
      "text_en": "",
      "options_hi": [
        "go",
        "goes",
        "went",
        "has gone"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Time and Tense",
      "exam": "",
      "explanation_hi": "Yesterday, last night, last week जैसे बीते हुए समय (past time) का बोध कराने वाले शब्दों के साथ हमेशा Simple Past Tense (Verb का दूसरा रूप) का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989451-1222-r5ge",
      "text_hi": "Choose the correct sentence:",
      "text_en": "",
      "options_hi": [
        "The sceneries of Kashmir are beautiful.",
        "The scenery of Kashmir is beautiful.",
        "The scenery of Kashmir are beautiful.",
        "The sceneries of Kashmir is beautiful."
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Noun",
      "exam": "",
      "explanation_hi": "Scenery एक Uncountable Noun है, इसका Plural (sceneries) नहीं बनता और इसके साथ हमेशा Singular Verb का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989451-1223-0598",
      "text_hi": "I have bought two _______ pencils.",
      "text_en": "",
      "options_hi": [
        "dozens",
        "dozen",
        "of dozen",
        "of dozens"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Noun & Number",
      "exam": "",
      "explanation_hi": "जब Dozen, Hundred, Thousand आदि के पहले कोई Numeral Adjective (जैसे two, three) हो, तो इनमें 's' जोड़कर Plural नहीं बनाया जाता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989452-1224-7ka3",
      "text_hi": "Choose the correct phrase:",
      "text_en": "",
      "options_hi": [
        "The table's wood",
        "The wood of the table",
        "The tables wood",
        "The wood's table"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Noun & Case",
      "exam": "",
      "explanation_hi": "निर्जीव (Non-living) वस्तुओं के साथ Possessive दर्शाने के लिए apostrophe ('s) का प्रयोग नहीं होता, बल्कि 'of' का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989452-1225-dyc8",
      "text_hi": "The students must avail _______ of the opportunity.",
      "text_en": "",
      "options_hi": [
        "them",
        "their",
        "themselves",
        "theirs"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Pronoun",
      "exam": "",
      "explanation_hi": "Avail, enjoy, pride, absent आदि Verbs के बाद हमेशा Reflexive Pronoun (यहाँ students के लिए themselves) का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989452-1226-40nr",
      "text_hi": "The boy _______ came here is a player.",
      "text_en": "",
      "options_hi": [
        "who",
        "whom",
        "which",
        "whose"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "General English",
      "topic": "Pronoun (Relative)",
      "exam": "",
      "explanation_hi": "व्यक्तियों के लिए वाक्य में Subject के रूप में Relative Pronoun 'who' का प्रयोग किया जाता है, 'whom' का प्रयोग Object के लिए होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989452-1227-8htd",
      "text_hi": "All the students of the class help _______.",
      "text_en": "",
      "options_hi": [
        "each other",
        "one another",
        "themselves",
        "everyone"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Pronoun (Reciprocal)",
      "exam": "",
      "explanation_hi": "Each other' का प्रयोग दो व्यक्तियों के लिए होता है, जबकि दो से अधिक व्यक्तियों (All the students) के लिए 'one another' का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989453-1228-g2cw",
      "text_hi": "Let you and _______ try to solve this problem.",
      "text_en": "",
      "options_hi": [
        "I",
        "my",
        "me",
        "mine"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Pronoun",
      "exam": "",
      "explanation_hi": "Let' के बाद हमेशा Pronoun के Objective Case (me, him, her, them, us) का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989453-1229-1wl3",
      "text_hi": "A foolish student has _______ care for his life.",
      "text_en": "",
      "options_hi": [
        "a little",
        "little",
        "the little",
        "few"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Adjective",
      "exam": "",
      "explanation_hi": "Little' का अर्थ 'न के बराबर' (Negative meaning) होता है। मूर्ख छात्र को अपने जीवन की न के बराबर परवाह होती है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989453-1230-t2t6",
      "text_hi": "Mohan is my _______ brother.",
      "text_en": "",
      "options_hi": [
        "older",
        "elder",
        "oldest",
        "eldest"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Adjective",
      "exam": "",
      "explanation_hi": "एक ही परिवार के सदस्यों (जैसे भाई-बहन) के लिए 'elder' का प्रयोग होता है। 'Older' का प्रयोग परिवार से बाहर के व्यक्तियों या वस्तुओं के लिए होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989453-1231-02zi",
      "text_hi": "The weather is getting _______.",
      "text_en": "",
      "options_hi": [
        "hot and hot",
        "hotter and hotter",
        "hottest and hottest",
        "more hot"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Adjective",
      "exam": "",
      "explanation_hi": "लगातार वृद्धि या ह्रास (Gradual increase/decrease) का बोध कराने के लिए Comparative + and + Comparative (hotter and hotter) का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989454-1232-b5s3",
      "text_hi": "Coffee is preferable _______ tea.",
      "text_en": "",
      "options_hi": [
        "than",
        "to",
        "over",
        "from"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Adjective",
      "exam": "",
      "explanation_hi": "Preferable' और 'Prefer' के साथ तुलना करते समय हमेशा preposition 'to' का प्रयोग होता है, 'than' का नहीं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989454-1233-2uf3",
      "text_hi": "I have nothing _______ to say.",
      "text_en": "",
      "options_hi": [
        "farther",
        "further",
        "furthest",
        "farthest"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Adjective",
      "exam": "",
      "explanation_hi": "Further' का अर्थ है 'अतिरिक्त' या 'आगे कुछ और', जबकि 'Farther' भौतिक दूरी (distance) को दर्शाता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989454-1234-jafw",
      "text_hi": "If it rains, I _______ at home.",
      "text_en": "",
      "options_hi": [
        "stay",
        "stayed",
        "will stay",
        "would stay"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Time & Tense (Conditional)",
      "exam": "",
      "explanation_hi": "Conditional sentences में यदि If-clause 'Simple Present' में हो, तो Principal clause 'Simple Future' (will/shall + V1) में होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989454-1235-ql5p",
      "text_hi": "He has been sleeping _______ five hours.",
      "text_en": "",
      "options_hi": [
        "since",
        "for",
        "from",
        "by"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Time & Tense",
      "exam": "",
      "explanation_hi": "Five hours' एक Period of Time (समयावधि) है, इसलिए इसके पहले 'for' का प्रयोग होगा। 'Since' का प्रयोग Point of Time (निश्चित समय) के लिए होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989454-1236-bi4c",
      "text_hi": "I _______ a letter to him yesterday.",
      "text_en": "",
      "options_hi": [
        "have written",
        "write",
        "wrote",
        "had written"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Time & Tense",
      "exam": "",
      "explanation_hi": "वाक्य में 'yesterday', 'last night' आदि बीते हुए समय का बोध कराते हैं, इसलिए यहाँ Verb के दूसरे रूप (Simple Past Tense) का प्रयोग होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989455-1237-l0j8",
      "text_hi": "The train had departed before he _______ the station.",
      "text_en": "",
      "options_hi": [
        "reaches",
        "reached",
        "had reached",
        "was reaching"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Time & Tense",
      "exam": "",
      "explanation_hi": "भूतकाल में हुए दो कार्यों में से जो कार्य पहले समाप्त होता है वह Past Perfect (had+V3) में और जो बाद में होता है वह Simple Past Tense (V2) में होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989455-1238-no9y",
      "text_hi": "The teacher said, \"The earth moves round the sun.\" (Choose Indirect form)",
      "text_en": "",
      "options_hi": [
        "The teacher said that the earth moved round the sun.",
        "The teacher said that the earth has moved round the sun.",
        "The teacher said that the earth moves round the sun.",
        "The teacher asked that the earth moves round the sun."
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Narration",
      "exam": "",
      "explanation_hi": "यदि Inverted commas के भीतर कोई Universal Truth (सार्वभौमिक सत्य) हो, तो Indirect Speech में Tense में कोई परिवर्तन नहीं होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989455-1239-8xje",
      "text_hi": "He said to me, \"Are you going today?\" (Choose Indirect form)",
      "text_en": "",
      "options_hi": [
        "He asked me if I was going that day.",
        "He told me if I was going today.",
        "He asked me that I was going that day.",
        "He asked me whether I am going today."
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "General English",
      "topic": "Narration",
      "exam": "",
      "explanation_hi": "Interrogative sentence में 'said to' को 'asked' में, conjunction 'if/whether' लगाते हैं, Tense past में और 'today' को 'that day' में बदलते हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989455-1240-4xkk",
      "text_hi": "He said to his servant, \"Bring a glass of water.\" (Choose Indirect form)",
      "text_en": "",
      "options_hi": [
        "He requested his servant to bring a glass of water.",
        "He ordered his servant to bring a glass of water.",
        "He told his servant that bring a glass of water.",
        "He asked his servant if bring a glass of water."
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Narration",
      "exam": "",
      "explanation_hi": "Imperative sentence में आज्ञा (Order) होने पर reporting verb को 'ordered' में और inverted commas हटाकर conjunction के रूप में 'to' का प्रयोग करते हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989456-1241-6xvu",
      "text_hi": "He said, \"Alas! I am ruined.\" (Choose Indirect form)",
      "text_en": "",
      "options_hi": [
        "He exclaimed with sorrow that he was ruined.",
        "He exclaimed with joy that he was ruined.",
        "He told with sorrow that he is ruined.",
        "He exclaimed that he is ruined."
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "General English",
      "topic": "Narration",
      "exam": "",
      "explanation_hi": "Alas!' दुख (Sorrow) को प्रकट करता है, इसलिए reporting verb 'exclaimed with sorrow' में बदलता है और tense नियमानुसार Past में परिवर्तित होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989456-1242-7f20",
      "text_hi": "Twenty miles (1) / are (2) / a long way to walk (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "Twenty miles",
        "are",
        "a long way to walk",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Common Errors (Syntax)",
      "exam": "",
      "explanation_hi": "Twenty miles' एक निश्चित दूरी (certain distance) का बोध कराता है, इसलिए इसके साथ Plural verb 'are' की जगह Singular verb 'is' का प्रयोग होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989457-1243-etvf",
      "text_hi": "You and I (1) / has known each other (2) / for the last ten years (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "You and I",
        "has known each other",
        "for the last ten years",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Common Errors (Syntax)",
      "exam": "",
      "explanation_hi": "You' और 'I' मिलकर Plural Subject बनाते हैं, इसलिए इसके साथ 'has' की जगह 'have' का प्रयोग होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989457-1244-apa7",
      "text_hi": "He does not like (1) / this type of a man (2) / who does nothing (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "He does not like",
        "this type of a man",
        "who does nothing",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Common Errors (Articles)",
      "exam": "",
      "explanation_hi": "ल्यूसेंट के नियम अनुसार, type of / kind of / sort of के बाद प्रयोग होने वाले Noun के पहले 'a/an' आर्टिकल का प्रयोग नहीं होता है। अतः 'type of man' सही होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989457-1245-5mfp",
      "text_hi": "Only a few girls (1) / were above ground, the rest were (2) / under the ground. (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "Only a few girls",
        "were above ground, the rest were",
        "under the ground.",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Common Errors (Articles)",
      "exam": "",
      "explanation_hi": "यहाँ 'under the ground' की जगह 'under ground' (बिना 'the' आर्टिकल के) का प्रयोग होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989457-1246-e1c6",
      "text_hi": "A herd of horses (1) / has arrived (2) / to join the race. (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "A herd of horses",
        "has arrived",
        "to join the race.",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "General English",
      "topic": "Common Errors (Noun)",
      "exam": "",
      "explanation_hi": "घोड़ों के झुंड के लिए 'herd' का नहीं, बल्कि 'flight' का प्रयोग किया जाता है। अतः 'A flight of horses' सही होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989458-1247-e2l6",
      "text_hi": "Seven days' journey (1) / is (2) / a week journey. (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "Seven days' journey",
        "is",
        "a week journey.",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Common Errors (Noun & Case)",
      "exam": "",
      "explanation_hi": "समय (Time) दर्शाने वाले शब्दों के साथ अधिकार (Possession) बताने के लिए apostrophe ('s) लगता है। अतः 'a week journey' की जगह 'a week's journey' का प्रयोग होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989458-1248-7380",
      "text_hi": "Ours are (1) / the same problems (2) / that yours. (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "Ours are",
        "the same problems",
        "that yours.",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Common Errors (Pronoun)",
      "exam": "",
      "explanation_hi": "वाक्य के अर्थ और संरचना को पूरा करने के लिए 'that yours' की जगह 'that yours are' का प्रयोग होना चाहिए।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989458-1249-puug",
      "text_hi": "As sooner as (1) / you reach the port, (2) / report to the desk officer. (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "As sooner as",
        "you reach the port,",
        "report to the desk officer.",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "General English",
      "topic": "Common Errors (Adjective)",
      "exam": "",
      "explanation_hi": "As...as' के बीच हमेशा Positive degree के Adjective/Adverb का प्रयोग होता है। अतः 'sooner' की जगह 'soon' (As soon as) का प्रयोग होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989458-1250-xagi",
      "text_hi": "He told me (1) / that he wrote a letter (2) / to his superior for a certain reason. (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "He told me",
        "that he wrote a letter",
        "to his superior for a certain reason.",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Common Errors (Tense)",
      "exam": "",
      "explanation_hi": "चूँकि प्रिंसिपल क्लॉज (He told me) Past Tense में है और पत्र लिखने का काम उससे पहले ही हो चुका था, इसलिए यहाँ Simple Past (wrote) की जगह Past Perfect 'had written' का प्रयोग होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989458-1251-skd7",
      "text_hi": "His father would have been pleased (1) / to get him a wrist watch (2) / if he would have worked harder. (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "His father would have been pleased",
        "to get him a wrist watch",
        "if he would have worked harder.",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Common Errors (Tense)",
      "exam": "",
      "explanation_hi": "Conditional Sentences (शर्त वाले वाक्यों) में 'If' वाले क्लॉज में 'had + V3' (had worked) का प्रयोग होता है, 'would have' का नहीं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989459-1252-8uis",
      "text_hi": "I am working (1) / at my present job (2) / since the day a son was born to my brother. (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "I am working",
        "at my present job",
        "since the day a son was born...",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "General English",
      "topic": "Common Errors (Time & Tense)",
      "exam": "",
      "explanation_hi": "वाक्य में 'since/for + time' का प्रयोग होने पर Present Continuous (am working) की जगह Present Perfect Continuous (have been working) का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989459-1253-8sz5",
      "text_hi": "When the doctors found (1) / that the player has taken (2) / prohibited medicines, he reported the matter. (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "When the doctors found",
        "that the player has taken",
        "prohibited medicines, he reported...",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Common Errors (Time & Tense)",
      "exam": "",
      "explanation_hi": "चूँकि Principal Clause (found/reported) Past Tense में है, इसलिए Subordinate clause में भी Past Tense (had taken) का प्रयोग होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989459-1254-iw2h",
      "text_hi": "Had I realised (1) / that it was such a long way (2) / I would take a taxi. (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "Had I realised",
        "that it was such a long way",
        "I would take a taxi.",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Common Errors (Conditional Tense)",
      "exam": "",
      "explanation_hi": "Conditional sentences में यदि 'Had + Subject + V3' का प्रयोग हो, तो दूसरे क्लॉज में 'would have + V3' (would have taken) का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989459-1255-ifgh",
      "text_hi": "As I am suffering from fever since morning (1) / I shall not be able to attend (2) / the function this evening. (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "As I am suffering from fever since morning",
        "I shall not be able to attend",
        "the function this evening.",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "General English",
      "topic": "Common Errors (Time & Tense)",
      "exam": "",
      "explanation_hi": "Since morning' समय का बोध कराता है, अतः Present Continuous की जगह Present Perfect Continuous (have been suffering) का प्रयोग होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989460-1256-mt9t",
      "text_hi": "She wishes (1) / that she has studied literature instead of history (2) / when she was in college. (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "She wishes",
        "that she has studied literature...",
        "when she was in college.",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Common Errors (Time & Tense)",
      "exam": "",
      "explanation_hi": "when she was in college' (Past time) से स्पष्ट है कि बात भूतकाल की हो रही है, इसलिए 'has studied' की जगह 'had studied' का प्रयोग होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989460-1257-uw2w",
      "text_hi": "I found this ring as I dig in the garden, (1) / it looks very old. (2) / I wonder whom it belongs to. (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "I found this ring as I dig in the garden,",
        "it looks very old.",
        "I wonder whom it belongs to.",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "General English",
      "topic": "Common Errors (Time & Tense)",
      "exam": "",
      "explanation_hi": "जब कोई कार्य भूतकाल में जारी हो (लगातार चल रहा हो), तो Past Continuous Tense का प्रयोग होता है। अतः 'I was digging' सही होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989460-1258-mdq5",
      "text_hi": "The girls were playing (1) / outside the house whereas (2) / the boys were sitting inside and played cards. (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "The girls were playing",
        "outside the house whereas",
        "the boys were sitting inside and played cards.",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Common Errors (Time & Tense)",
      "exam": "",
      "explanation_hi": "And' से जुड़े दोनों Verbs समान Form में होने चाहिए। चूँकि पहला verb 'sitting' (V-ing) है, इसलिए 'played' की जगह 'playing cards' का प्रयोग होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989460-1259-ulv1",
      "text_hi": "Mohini washes all her clothes and cooks food (1) / for the family before (2) / she is going to the office. (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "Mohini washes all her clothes and cooks food",
        "for the family before",
        "she is going to the office.",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Common Errors (Time & Tense)",
      "exam": "",
      "explanation_hi": "यह एक Habitual Action (दैनिक आदत) है। Habitual actions को दर्शाने के लिए Simple Present Tense का प्रयोग होता है, Continuous का नहीं। अतः 'she goes' सही होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989461-1260-8ev9",
      "text_hi": "I know nothing (1) / about chess because my game's teacher also (2) / was not knowing nothing about it. (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "I know nothing",
        "about chess because my game's teacher also",
        "was not knowing nothing about it.",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Common Errors (Time & Tense)",
      "exam": "",
      "explanation_hi": "Know' जैसे Verbs of Perception का प्रयोग सामान्यतः Continuous (V-ing) रूप में नहीं होता है। अतः 'was not knowing' की जगह 'did not know' या 'knew' का प्रयोग होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989461-1261-elgk",
      "text_hi": "If you had read the relevant literature carefully, (1) / you would have answered (2) / most of the questions correctly. (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "If you had read the relevant literature carefully,",
        "you would have answered",
        "most of the questions correctly.",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "General English",
      "topic": "Common Errors (Conditional Tense)",
      "exam": "",
      "explanation_hi": "दिया गया वाक्य बिल्कुल सही है। यह Conditional sentence है जिसमें If clause (had + V3) में है और Principal Clause (would have + V3) में है, जो कि सही संरचना है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989461-1262-lwuq",
      "text_hi": "Mr. Thakur lived (1) / in the three-hundred year (2) / old house (3) / in Patna. (4)",
      "text_en": "",
      "options_hi": [
        "Mr. Thakur lived",
        "in the three-hundred year",
        "old house",
        "in Patna."
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Common Errors (Articles)",
      "exam": "",
      "explanation_hi": "the' की जगह 'a' का प्रयोग होगा। 'A three hundred year old house' का अर्थ है - एक तीन सौ वर्ष का पुराना घर।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989461-1263-4pv4",
      "text_hi": "The English (1) / defeated (2) / french (3) / in the battle of Waterloo. (4)",
      "text_en": "",
      "options_hi": [
        "The English",
        "defeated",
        "french",
        "in the battle of Waterloo."
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Common Errors (Articles)",
      "exam": "",
      "explanation_hi": "french' के पहले 'the' का प्रयोग होगा (the French), क्योंकि यहाँ 'French' का तात्पर्य फ्रेंच भाषा से नहीं बल्कि फ्रांस के लोगों/सेना से है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989462-1264-3ita",
      "text_hi": "An old man in the crowd (1) / warned Julius Caesar (2) / from the danger of death (3) / on certain day. (4)",
      "text_en": "",
      "options_hi": [
        "An old man in the crowd",
        "warned Julius Caesar",
        "from the danger of death",
        "on certain day."
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "General English",
      "topic": "Common Errors (Articles)",
      "exam": "",
      "explanation_hi": "certain day' के पहले 'a' का प्रयोग होगा (on a certain day)।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989462-1265-lhch",
      "text_hi": "Never have I listened (1) / to such a beautiful music (2) / as the piece we heard on radio (3) / last night. (4)",
      "text_en": "",
      "options_hi": [
        "Never have I listened",
        "to such a beautiful music",
        "as the piece we heard on radio",
        "last night."
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Common Errors (Articles)",
      "exam": "",
      "explanation_hi": "वाक्य में 'on radio' की जगह 'on the radio' का प्रयोग होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989462-1266-n2ve",
      "text_hi": "In the meeting (1) / Mr. Yadav was (2) / selected the chairman (3) / yesterday. (4)",
      "text_en": "",
      "options_hi": [
        "In the meeting",
        "Mr. Yadav was",
        "selected the chairman",
        "yesterday."
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Common Errors (Articles)",
      "exam": "",
      "explanation_hi": "Chairman' के पहले 'the' का प्रयोग नहीं होगा, क्योंकि 'selected' (चुनना) के बाद complement के रूप में प्रयुक्त Noun के पहले The का प्रयोग नहीं होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989462-1267-4gsg",
      "text_hi": "The Indian team (1) / defeated (2) / the Australian (3) / by an inning. (4)",
      "text_en": "",
      "options_hi": [
        "The Indian team",
        "defeated",
        "the Australian",
        "by an inning."
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "General English",
      "topic": "Common Errors (Noun & Number)",
      "exam": "",
      "explanation_hi": "inning' की जगह 'innings' का प्रयोग होगा, क्योंकि innings का प्रयोग Singular और Plural दोनों में 's' के साथ ही होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989463-1268-hh11",
      "text_hi": "They left (1) / their luggages (2) / at the railway (3) / station. (4)",
      "text_en": "",
      "options_hi": [
        "They left",
        "their luggages",
        "at the railway",
        "station."
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Common Errors (Noun & Number)",
      "exam": "",
      "explanation_hi": "luggages' की जगह 'luggage' का प्रयोग होगा, क्योंकि luggage एक Singular Uncountable Noun है तथा इसमें 's' जोड़कर Plural नहीं बनाया जाता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989463-1269-ndgf",
      "text_hi": "The customer (1) / handed over (2) / a hundred rupees note (3) / to the shopkeeper. (4)",
      "text_en": "",
      "options_hi": [
        "The customer",
        "handed over",
        "a hundred rupees note",
        "to the shopkeeper."
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Common Errors (Noun & Number)",
      "exam": "",
      "explanation_hi": "a hundred rupees note' की जगह 'a hundred-rupee note' का प्रयोग होगा, क्योंकि A + cardinal adjective (hundred) + hyphen (-) + Singular Noun का पैटर्न प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989463-1270-b3ev",
      "text_hi": "There (1) / was (2) / a boy's college (3) / in my village. (4)",
      "text_en": "",
      "options_hi": [
        "There",
        "was",
        "a boy's college",
        "in my village."
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Common Errors (Noun & Case)",
      "exam": "",
      "explanation_hi": "A boy's college' की जगह 'A boys' college' (लड़कों का महाविद्यालय) का प्रयोग होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989464-1271-auiw",
      "text_hi": "We should not (1) / try to develop (2) / any intimacy with (3) / a group of liars. (4)",
      "text_en": "",
      "options_hi": [
        "We should not",
        "try to develop",
        "any intimacy with",
        "a group of liars."
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "General English",
      "topic": "Common Errors (Noun)",
      "exam": "",
      "explanation_hi": "झूठों (liars) का समूह बताने के लिए 'a group' की जगह 'a pack of liars' का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989464-1272-i6rj",
      "text_hi": "Ten kilometres ....... a long way to walk.",
      "text_en": "",
      "options_hi": [
        "are",
        "is",
        "have",
        "has"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Syntax (Subject-Verb Agreement)",
      "exam": "",
      "explanation_hi": "Ten kilometres' एक निश्चित दूरी (certain distance) का बोध कराता है, इसलिए इसके साथ Plural verb की जगह Singular verb 'is' का प्रयोग होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989464-1273-r5nf",
      "text_hi": "One of the pupils in our class ....... a car.",
      "text_en": "",
      "options_hi": [
        "own",
        "owns",
        "is owning",
        "are owning"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Syntax (Subject-Verb Agreement)",
      "exam": "",
      "explanation_hi": "One of' + Plural Noun/Pronoun (the pupils) के बाद हमेशा Singular verb का प्रयोग होता है। अतः 'owns' सही है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989464-1274-5dj9",
      "text_hi": "He is ....... Indian but his wife is ....... European.",
      "text_en": "",
      "options_hi": [
        "a, an",
        "an, a",
        "an, an",
        "a, a"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Articles",
      "exam": "",
      "explanation_hi": "Indian' का उच्चारण Vowel sound (इ) से शुरू होता है इसलिए 'an' लगेगा, जबकि 'European' का उच्चारण Consonant sound (य) से होता है इसलिए 'a' लगेगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989465-1275-eqzf",
      "text_hi": "A ....... of bees flew out of the hive.",
      "text_en": "",
      "options_hi": [
        "flock",
        "herd",
        "swarm",
        "army"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Noun (Collective)",
      "exam": "",
      "explanation_hi": "ल्यूसेंट के Collective Noun नियमों के अनुसार, मधुमक्खियों (bees) के समूह या झुंड को अंग्रेजी में 'swarm' (A swarm of bees) कहा जाता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989465-1276-5tor",
      "text_hi": "Find the error: The customer (1) / handed over (2) / a hundred rupees note (3) / to the shopkeeper. (4)",
      "text_en": "",
      "options_hi": [
        "The customer",
        "handed over",
        "a hundred rupees note",
        "to the shopkeeper."
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Common Errors (Noun & Number)",
      "exam": "",
      "explanation_hi": "A + cardinal adjective (hundred) + hyphen (-) + Singular Noun का प्रयोग होता है। अतः 'a hundred rupees note' की जगह 'a hundred-rupee note' सही होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989465-1277-fxcz",
      "text_hi": "Find the error: The Indian team (1) / defeated (2) / the Australian (3) / by an inning. (4)",
      "text_en": "",
      "options_hi": [
        "The Indian team",
        "defeated",
        "the Australian",
        "by an inning."
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "General English",
      "topic": "Common Errors (Noun & Number)",
      "exam": "",
      "explanation_hi": "Innings' (पारी) का प्रयोग Singular और Plural दोनों में 's' के साथ ही होता है। अतः यहाँ 'inning' की जगह 'innings' का प्रयोग होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989465-1278-8fub",
      "text_hi": "Find the error: No one (1) / should (2) / oppress (3) / their neighbours. (4)",
      "text_en": "",
      "options_hi": [
        "No one",
        "should",
        "oppress",
        "their neighbours."
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "General English",
      "topic": "Common Errors (Pronoun)",
      "exam": "",
      "explanation_hi": "No one' एक Singular Indefinite Pronoun है, इसलिए इसके लिए possessive case में Singular Pronoun 'his' का प्रयोग होगा, 'their' का नहीं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989466-1279-4ipw",
      "text_hi": "Ramita Devi is the ....... woman in our village.",
      "text_en": "",
      "options_hi": [
        "older",
        "oldest",
        "elder",
        "eldest"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Adjective",
      "exam": "",
      "explanation_hi": "Village' में तुलना हो रही है (अर्थात् परिवार के बाहर के सदस्यों के बीच), और 'the' लगा है अतः Superlative degree 'oldest' का प्रयोग होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989466-1280-y11w",
      "text_hi": "He usually ....... Bhojpuri.",
      "text_en": "",
      "options_hi": [
        "speak",
        "is speaking",
        "speaks",
        "has spoken"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Time and Tense",
      "exam": "",
      "explanation_hi": "Usually', 'always', 'daily' जैसे समय सूचक शब्दों का प्रयोग Habitual action (आदत) बताने के लिए Simple Present Tense (Verb+s/es) में होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989466-1281-9qct",
      "text_hi": "Find the error: I am working (1) / at my present job (2) / since the day (3) / a son was born to my brother. (4)",
      "text_en": "",
      "options_hi": [
        "I am working",
        "at my present job",
        "since the day",
        "a son was born..."
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "General English",
      "topic": "Common Errors (Time and Tense)",
      "exam": "",
      "explanation_hi": "वाक्य में 'since' + past time का प्रयोग होने पर Present Continuous (am working) की जगह Present Perfect Continuous (have been working) का प्रयोग होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989466-1282-ugq1",
      "text_hi": "Let you and ....... try to solve this problem.",
      "text_en": "",
      "options_hi": [
        "I",
        "me",
        "my",
        "mine"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Pronoun",
      "exam": "",
      "explanation_hi": "ल्यूसेंट के नियम के अनुसार 'Let' के बाद हमेशा Pronoun के Objective Case (me, him, her, them, us) का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989467-1283-5dxw",
      "text_hi": "Mukesh is junior ....... all his brothers.",
      "text_en": "",
      "options_hi": [
        "than",
        "from",
        "to",
        "by"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Adjective",
      "exam": "",
      "explanation_hi": "Latin Adjectives (जैसे- Junior, Senior, Inferior, Superior, Prior) के बाद Comparative degree में 'than' की जगह preposition 'to' का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989467-1284-7o83",
      "text_hi": "All the students of the class help .......",
      "text_en": "",
      "options_hi": [
        "each other",
        "one another",
        "themselves",
        "everyone"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Pronoun",
      "exam": "",
      "explanation_hi": "Each other' का प्रयोग केवल दो व्यक्तियों के लिए होता है, जबकि दो से अधिक व्यक्तियों (All the students) के लिए reciprocal pronoun 'one another' का प्रयोग किया जाता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989467-1285-un00",
      "text_hi": "Coffee is preferable ....... tea.",
      "text_en": "",
      "options_hi": [
        "than",
        "to",
        "over",
        "from"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Adjective",
      "exam": "",
      "explanation_hi": "Prefer और Preferable के साथ तुलना करते समय हमेशा preposition 'to' का प्रयोग होता है, 'than' का नहीं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989467-1286-ropk",
      "text_hi": "Find the error: Everyone (1) / should love (2) / one's country. (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "Everyone",
        "should love",
        "one's country.",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Common Errors (Pronoun)",
      "exam": "",
      "explanation_hi": "Everyone, Everybody, Someone आदि Indefinite Pronouns के साथ singular pronoun (his/her) का प्रयोग होता है, 'one's' का नहीं। अतः यहाँ 'his country' सही होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989467-1287-yqf8",
      "text_hi": "Ramita Devi is the ....... woman in our village.",
      "text_en": "",
      "options_hi": [
        "older",
        "oldest",
        "elder",
        "eldest"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Adjective",
      "exam": "",
      "explanation_hi": "Village' में तुलना हो रही है (अर्थात् परिवार के बाहर के सदस्यों के बीच), इसलिए 'oldest' का प्रयोग होगा। एक ही परिवार के सदस्यों के लिए 'eldest' आता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989468-1288-2h3t",
      "text_hi": "It is I who ....... to blame.",
      "text_en": "",
      "options_hi": [
        "is",
        "am",
        "are",
        "was"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Pronoun",
      "exam": "",
      "explanation_hi": "Relative Pronoun (who/which/that) के बाद आने वाला verb हमेशा उसके Antecedent (यहाँ 'I') के अनुसार होता है। 'I' के साथ 'am' लगता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989468-1289-jffw",
      "text_hi": "Find the error: He is (1) / more smarter (2) / than his brother. (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "He is",
        "more smarter",
        "than his brother.",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Common Errors (Adjective)",
      "exam": "",
      "explanation_hi": "ल्यूसेंट के अनुसार वाक्य में दो Comparative degree का प्रयोग एक साथ नहीं होता है (Double comparatives)। 'smarter' पहले से ही comparative है, इसलिए 'more' का प्रयोग गलत है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989468-1290-7nt7",
      "text_hi": "The students must avail ....... of the opportunity.",
      "text_en": "",
      "options_hi": [
        "them",
        "their",
        "themselves",
        "theirs"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Pronoun",
      "exam": "",
      "explanation_hi": "Avail, pride, enjoy, absent आदि Verbs के बाद हमेशा Reflexive Pronoun (यहाँ students के लिए themselves) का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989468-1291-x2fg",
      "text_hi": "A foolish student has ....... care for his life.",
      "text_en": "",
      "options_hi": [
        "a little",
        "little",
        "the little",
        "few"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Adjective",
      "exam": "",
      "explanation_hi": "Little' का अर्थ 'न के बराबर' (Negative meaning) होता है। एक मूर्ख छात्र को अपने जीवन की न के बराबर परवाह होती है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989469-1292-xjll",
      "text_hi": "Between you and _______, I do not believe him.",
      "text_en": "",
      "options_hi": [
        "I",
        "me",
        "mine",
        "my"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Pronoun",
      "exam": "",
      "explanation_hi": "ल्यूसेंट के नियम अनुसार Preposition (जैसे- between, but, except) के बाद हमेशा Pronoun के Objective case (यहाँ 'me') का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989469-1293-anh4",
      "text_hi": "One must not praise _______ achievements.",
      "text_en": "",
      "options_hi": [
        "his",
        "her",
        "one's",
        "their"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Pronoun",
      "exam": "",
      "explanation_hi": "जब 'One' का प्रयोग sentence के Subject के रूप में होता है, तो इसके लिए Possessive Adjective के रूप में 'one's' का प्रयोग होता है, 'his/her' का नहीं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989469-1294-s3yw",
      "text_hi": "Find the error: He (1) / absented (2) / from the meeting. (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "He",
        "absented",
        "from the meeting.",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Common Errors (Pronoun)",
      "exam": "",
      "explanation_hi": "Absent, enjoy, pride, avail, introduce आदि Verbs के बाद Reflexive Pronoun का प्रयोग होता है। अतः यहाँ 'absented himself' सही होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989469-1295-n2aj",
      "text_hi": "He did not give me _______ milk.",
      "text_en": "",
      "options_hi": [
        "some",
        "any",
        "little",
        "much"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Adjective",
      "exam": "",
      "explanation_hi": "Negative (नकारात्मक) वाक्यों में मात्रा बताने के लिए 'any' का प्रयोग होता है, जबकि Affirmative (सकारात्मक) वाक्यों में 'some' का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989469-1296-i8fv",
      "text_hi": "_______ knowledge is a dangerous thing.",
      "text_en": "",
      "options_hi": [
        "Little",
        "A little",
        "The little",
        "Few"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Adjective",
      "exam": "",
      "explanation_hi": "A little' का प्रयोग सकारात्मक अर्थ (Positive meaning) में 'थोड़ा' या 'कुछ' के लिए होता है। 'Little' का अर्थ 'न के बराबर' (Negative meaning) होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989470-1297-i0sb",
      "text_hi": "Find the error: She is (1) / the most wisest (2) / girl in the class. (3) / No error (4)",
      "text_en": "",
      "options_hi": [
        "She is",
        "the most wisest",
        "girl in the class.",
        "No error"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Common Errors (Adjective)",
      "exam": "",
      "explanation_hi": "अंग्रेजी में दो Superlative degree ('most' और 'wisest') का प्रयोग एक साथ नहीं होता (Double superlatives गलत माने जाते हैं)। अतः सिर्फ 'wisest' सही होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989471-1298-2ex7",
      "text_hi": "I, _______ am your teacher, will teach you.",
      "text_en": "",
      "options_hi": [
        "who",
        "whom",
        "which",
        "whose"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "General English",
      "topic": "Pronoun (Relative)",
      "exam": "",
      "explanation_hi": "Relative Pronoun 'who' का प्रयोग व्यक्तियों के लिए Subject के रूप में होता है, और इसके बाद आने वाला Verb इसके antecedent ('I' के साथ 'am') के अनुसार आता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989471-1299-q918",
      "text_hi": "There are _______ boys in this class than in that one.",
      "text_en": "",
      "options_hi": [
        "less",
        "fewer",
        "lesser",
        "little"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Adjective",
      "exam": "",
      "explanation_hi": "Fewer' का प्रयोग संख्या (number) का बोध कराने के लिए Plural Countable Noun (boys) के साथ होता है। 'Less' का प्रयोग मात्रा (quantity) बताने के लिए होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989471-1300-pzzo",
      "text_hi": "Ajay is Binay's _______ brother.",
      "text_en": "",
      "options_hi": [
        "older",
        "elder",
        "oldest",
        "eldest"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Adjective",
      "exam": "",
      "explanation_hi": "एक ही परिवार के सदस्यों (रक्त संबंध) के बीच रिश्ता दर्शाने के लिए 'elder' का प्रयोग होता है। 'Older' का प्रयोग परिवार के बाहर के लिए होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989471-1301-hkho",
      "text_hi": "I don't know how _______ money he spent on his marriage.",
      "text_en": "",
      "options_hi": [
        "many",
        "much",
        "few",
        "a lot"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Adjective",
      "exam": "",
      "explanation_hi": "Money' एक Singular Uncountable Noun (अगणनीय संज्ञा) है, इसलिए इसके पहले मात्रा (quantity) का बोध कराने के लिए 'much' का प्रयोग होता है, 'many' का नहीं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989472-1302-x318",
      "text_hi": "A black and white cat _______ mewing.",
      "text_en": "",
      "options_hi": [
        "are",
        "were",
        "was",
        "have"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Verb (Syntax)",
      "exam": "",
      "explanation_hi": "यदि दो Adjectives 'and' से जुड़कर किसी Singular Common Noun के पहले प्रयुक्त हों और केवल पहले Adjective के पूर्व Article (A/An) हो, तो इससे एक ही वस्तु/जानवर का बोध होता है, अतः Singular Verb 'was' लगेगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989472-1303-vrr8",
      "text_hi": "A lot of money _______ been spent.",
      "text_en": "",
      "options_hi": [
        "have",
        "are",
        "were",
        "has"
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "General English",
      "topic": "Verb (Syntax)",
      "exam": "",
      "explanation_hi": "ल्यूसेंट के नियम के अनुसार, A lot of / Plenty of / Most of के बाद यदि Singular Uncountable Noun (जैसे- money) का प्रयोग हो, तो उसके साथ Singular Verb (has) का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989472-1304-ffdc",
      "text_hi": "He always _______ here on Sunday.",
      "text_en": "",
      "options_hi": [
        "come",
        "came",
        "comes",
        "is coming"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Verb (Tense)",
      "exam": "",
      "explanation_hi": "Habitual या regular action (आदत) को दर्शाने के लिए always, daily आदि शब्दों के साथ Simple Present Tense (V1/V5) का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989472-1305-12fw",
      "text_hi": "The train _______ departed when he reached the station.",
      "text_en": "",
      "options_hi": [
        "has",
        "had",
        "was",
        "is"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Verb (Tense)",
      "exam": "",
      "explanation_hi": "भूतकाल में जब दो कार्य हुए हों, तो जो कार्य पहले समाप्त होता है उसे Past Perfect Tense (had + V3) में रखा जाता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989472-1306-qhtg",
      "text_hi": "The jury _______ divided in their opinions.",
      "text_en": "",
      "options_hi": [
        "was",
        "is",
        "has",
        "were"
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "General English",
      "topic": "Verb (Syntax)",
      "exam": "",
      "explanation_hi": "Jury, committee आदि Collective Nouns से जब अलग-अलग व्यक्तियों या मतभेद (divided opinions) का बोध हो, तो इसे Plural माना जाता है और Plural Verb का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989473-1307-3a4o",
      "text_hi": "Divide these mangoes between her and _______.",
      "text_en": "",
      "options_hi": [
        "I",
        "mine",
        "my",
        "me"
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "General English",
      "topic": "Preposition",
      "exam": "",
      "explanation_hi": "ल्यूसेंट के सर्वनाम नियम के अनुसार, Preposition (जैसे यहाँ 'between') के बाद हमेशा Pronoun के Objective Case (me, him, her, us) का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989473-1308-7ixj",
      "text_hi": "Mukesh is junior _______ all his brothers.",
      "text_en": "",
      "options_hi": [
        "than",
        "from",
        "to",
        "by"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Preposition",
      "exam": "",
      "explanation_hi": "ल्यूसेंट के विशेषण नियमों के अनुसार, Latin Adjectives (Junior, Senior, Inferior, Prior) के बाद Comparative degree में 'than' की जगह Preposition 'to' का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989473-1309-ppa8",
      "text_hi": "Drinking is preferable _______ smoking.",
      "text_en": "",
      "options_hi": [
        "than",
        "over",
        "to",
        "for"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Preposition",
      "exam": "",
      "explanation_hi": "Preferable का प्रयोग Adjective के रूप में 'to be liked more' के अर्थ में होता है। इसके बाद हमेशा Preposition 'to' का प्रयोग होता है, 'than' का नहीं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989473-1310-n3ug",
      "text_hi": "The workers of this factory walked out this morning. They are _______ strike.",
      "text_en": "",
      "options_hi": [
        "in",
        "on",
        "at",
        "for"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Preposition",
      "exam": "",
      "explanation_hi": "अंग्रेजी में कुछ फिक्स Phrases होते हैं जिनमें निश्चित Preposition लगता है। हड़ताल पर होने के लिए 'on strike' का प्रयोग होता है (जैसे- on duty, on fire)।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989474-1311-h4lt",
      "text_hi": "He sent the letter _______ post.",
      "text_en": "",
      "options_hi": [
        "by",
        "through",
        "with",
        "from"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "General English",
      "topic": "Preposition",
      "exam": "",
      "explanation_hi": "ल्यूसेंट के 'Articles/Prepositions' के अभ्यास नियमों के अनुसार, संचार या भेजने के माध्यम को दर्शाने के लिए 'by' + words का प्रयोग होता है (जैसे- by post, by hand, by cheque)।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989474-1312-04lb",
      "text_hi": "Good students always _______ hard.",
      "text_en": "",
      "options_hi": [
        "works",
        "work",
        "is working",
        "has worked"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Verb (Correct Form) / Tense",
      "exam": "",
      "explanation_hi": "Always' शब्द Habitual action (आदत) को दर्शाता है, जिसके साथ Simple Present Tense का प्रयोग होता है। 'Good students' प्लुरल सब्जेक्ट है, इसलिए प्लुरल वर्ब 'work' आएगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989474-1313-9uux",
      "text_hi": "He usually _______ Bhojpuri.",
      "text_en": "",
      "options_hi": [
        "speak",
        "speaks",
        "is speaking",
        "spoke"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Verb (Correct Form) / Tense",
      "exam": "",
      "explanation_hi": "Usually' भी आदत (Habitual action) को व्यक्त करता है, अतः यहाँ Simple Present (V5) का प्रयोग होगा। 'He' के साथ 'speaks' सही है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989474-1314-1gx6",
      "text_hi": "He _______ to Muzaffarpur yesterday.",
      "text_en": "",
      "options_hi": [
        "go",
        "goes",
        "went",
        "has gone"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Verb (Correct Form) / Tense",
      "exam": "",
      "explanation_hi": "वाक्य में 'yesterday' बीते हुए समय (past time) का बोध कराता है, इसलिए यहाँ Simple Past Tense अर्थात् verb के दूसरे रूप 'went' का प्रयोग होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989475-1315-fpd3",
      "text_hi": "She _______ doing her home work for an hour.",
      "text_en": "",
      "options_hi": [
        "is",
        "was",
        "has been",
        "have been"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Verb (Correct Form) / Tense",
      "exam": "",
      "explanation_hi": "For an hour' समय की अवधि (Period of time) को दर्शाता है, इसलिए यहाँ Present Perfect Continuous Tense (has been) का प्रयोग होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989475-1316-4fqm",
      "text_hi": "My grandmother _______ me a story just now.",
      "text_en": "",
      "options_hi": [
        "told",
        "has told",
        "tells",
        "had told"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Verb (Correct Form) / Tense",
      "exam": "",
      "explanation_hi": "Just now' का प्रयोग हाल ही में समाप्त हुए कार्य (Present Perfect Tense) को व्यक्त करने के लिए होता है। अतः 'has told' सही विकल्प है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989475-1317-qg59",
      "text_hi": "I _______ here for a week.",
      "text_en": "",
      "options_hi": [
        "am living",
        "have been living",
        "was living",
        "live"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Verb (Correct Form) / Tense",
      "exam": "",
      "explanation_hi": "For a week' का प्रयोग होने के कारण यह कार्य पिछले कुछ समय से जारी है, अतः यहाँ Present Perfect Continuous Tense 'have been living' का प्रयोग होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989475-1318-am0g",
      "text_hi": "The train had left before they _______ the station.",
      "text_en": "",
      "options_hi": [
        "reached",
        "had reached",
        "reach",
        "reaches"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "General English",
      "topic": "Verb (Correct Form) / Tense",
      "exam": "",
      "explanation_hi": "भूतकाल में जब दो कार्य हुए हों, तो जो कार्य पहले समाप्त होता है वह Past Perfect (had left) में और जो बाद में समाप्त होता है वह Simple Past (reached) में लिखा जाता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989475-1319-4579",
      "text_hi": "He felt that he _______ resign his post.",
      "text_en": "",
      "options_hi": [
        "will",
        "shall",
        "would",
        "can"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Verb (Correct Form) / Tense",
      "exam": "",
      "explanation_hi": "यदि Principal Clause पास्ट टेंस (felt) में है, तो Subordinate clause में भी verb का पास्ट फॉर्म प्रयोग होता है। अतः 'will' की जगह 'would' सही होगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989476-1320-z3ah",
      "text_hi": "The train _______ just now.",
      "text_en": "",
      "options_hi": [
        "arrive",
        "arrived",
        "has arrived",
        "had arrived"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Verb (Correct Form) / Tense",
      "exam": "",
      "explanation_hi": "Just now', 'recently', 'already' आदि शब्दों के साथ सामान्यतः Present Perfect Tense (has/have + V3) का प्रयोग किया जाता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989476-1321-uund",
      "text_hi": "I suppose you _______ the latest news.",
      "text_en": "",
      "options_hi": [
        "hear",
        "heard",
        "have heard",
        "had heard"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "General English",
      "topic": "Verb (Correct Form) / Tense",
      "exam": "",
      "explanation_hi": "Latest news' (ताजा खबर) सुनने का कार्य अभी-अभी संपन्न हुआ माना जाता है, इसलिए ऐसे वाक्यों में Present Perfect (have heard) का प्रयोग किया जाता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989476-1322-bop6",
      "text_hi": "**Choose the correct indirect speech:**Father said, \"The earth moves round the sun.\"",
      "text_en": "",
      "options_hi": [
        "Father said that the earth moved round the sun.",
        "Father said that the earth moves round the sun.",
        "Father asked if the earth moves round the sun.",
        "Father told that the earth has moved round the sun."
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Narration",
      "exam": "",
      "explanation_hi": "ल्यूसेंट के अनुसार, यदि Inverted commas के भीतर कोई Universal Truth (सार्वभौमिक सत्य) हो, तो Indirect Speech में उसका Tense नहीं बदलता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989476-1323-k7u8",
      "text_hi": "**Choose the correct indirect speech:**Mukesh will say, \"Dinner is ready.\"",
      "text_en": "",
      "options_hi": [
        "Mukesh will say that dinner was ready.",
        "Mukesh will say that dinner is ready.",
        "Mukesh will tell that dinner is ready.",
        "Mukesh says that dinner is ready."
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Narration",
      "exam": "",
      "explanation_hi": "ल्यूसेंट के नियम (1) के अनुसार, यदि Reporting Verb Present या Future Tense (will say) में हो, तो Reported speech के Tense में कोई परिवर्तन नहीं होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989477-1324-y58t",
      "text_hi": "**Choose the correct indirect speech:**He said to me, \"Are you a student?\"",
      "text_en": "",
      "options_hi": [
        "He told me that I was a student.",
        "He asked me if I was a student.",
        "He asked me that I was a student.",
        "He asked me whether I am a student."
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Narration",
      "exam": "",
      "explanation_hi": "Yes/No Interrogative वाक्यों में 'said to' को 'asked' में बदलते हैं, Inverted commas हटाकर 'if' या 'whether' लगाते हैं, और वाक्य को Assertive बना देते हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989477-1325-4lpi",
      "text_hi": "**Choose the correct indirect speech:**He said to me, \"When will you return?\"",
      "text_en": "",
      "options_hi": [
        "He asked me when would I return.",
        "He asked me when I would return.",
        "He asked me when I will return.",
        "He asked me that when I would return."
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Narration",
      "exam": "",
      "explanation_hi": "Wh-questions में if/whether का प्रयोग नहीं होता, बल्कि Question word (When) ही conjunction बन जाता है और वाक्य Assertive हो जाता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989478-1326-boi4",
      "text_hi": "**Choose the correct indirect speech:**The captain said to the soldiers, \"Lay down the gun.\"",
      "text_en": "",
      "options_hi": [
        "The captain ordered the soldiers to lay down the gun.",
        "The captain commanded the soldiers to lay down the gun.",
        "The captain asked the soldiers that lay down the gun.",
        "The captain requested the soldiers to lay down the gun."
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Narration",
      "exam": "",
      "explanation_hi": "सेना या कप्तान के आदेश (Command) के लिए reporting verb 'commanded' का प्रयोग होता है और Imperative sentence में conjunction 'to' लगता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989478-1327-c18i",
      "text_hi": "**Choose the correct indirect speech:**Mohan said to his friends, \"Let us go to the cinema.\"",
      "text_en": "",
      "options_hi": [
        "Mohan ordered his friends to go to the cinema.",
        "Mohan proposed to his friends that they should go to the cinema.",
        "Mohan proposed his friends that let them go to the cinema.",
        "Mohan asked his friends that they should go to the cinema."
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Narration",
      "exam": "",
      "explanation_hi": "Let us' वाले वाक्यों से प्रस्ताव (proposal) का बोध होता है। अतः proposed/suggested to + Object + that + they/we should + V1 का प्रयोग होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989478-1328-5hny",
      "text_hi": "**Choose the correct indirect speech:**Vivek said, \"I shall write a letter tomorrow.\"",
      "text_en": "",
      "options_hi": [
        "Vivek said that he would write a letter tomorrow.",
        "Vivek said that he would write a letter the next day.",
        "Vivek said that he will write a letter the next day.",
        "Vivek told that he would write a letter the next day."
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Narration",
      "exam": "",
      "explanation_hi": "Reporting verb past tense में हो तो tense बदलता है (shall का would) और time expressing word 'tomorrow' को 'the next day' में बदला जाता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989478-1329-gvca",
      "text_hi": "**Choose the correct indirect speech:**Priyanka said, \"Alas! I am ruined.\"",
      "text_en": "",
      "options_hi": [
        "Priyanka exclaimed with sorrow that she was ruined.",
        "Priyanka exclaimed with sorrow that she is ruined.",
        "Priyanka exclaimed that she was ruined.",
        "Priyanka told with sorrow that she was ruined."
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "General English",
      "topic": "Narration",
      "exam": "",
      "explanation_hi": "Alas!' दुःख (sorrow) प्रकट करता है, अतः reporting verb 'exclaimed with sorrow' में बदलता है तथा tense नियमानुसार past में परिवर्तित होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989479-1330-1h0i",
      "text_hi": "**Choose the correct indirect speech:**He said to me, \"You are late.\"",
      "text_en": "",
      "options_hi": [
        "He told me that I was late.",
        "He said to me that you were late.",
        "He told me that you are late.",
        "He asked me that I was late."
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "General English",
      "topic": "Narration",
      "exam": "",
      "explanation_hi": "ल्यूसेंट के SON फॉर्मूले के अनुसार, Second Person (You) Object (me) के अनुसार 'I' में बदलता है। 'said to' को 'told' में बदला जाता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989479-1331-zhu5",
      "text_hi": "**Choose the correct indirect speech:**He said, \"May God bless you!\"",
      "text_en": "",
      "options_hi": [
        "He exclaimed that God might bless me.",
        "He prayed that God might bless him.",
        "He prayed that God may bless him.",
        "He asked God to bless you."
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "General English",
      "topic": "Narration",
      "exam": "",
      "explanation_hi": "यह Optative sentence है। इसमें reporting verb 'prayed' या 'wished' में बदलता है तथा 'May' को 'might' में बदला जाता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989479-1332-qgvb",
      "text_hi": "किसी अर्थव्यवस्था में 'मुद्रा गुणक' (Money Multiplier) निम्नलिखित में से किस कारण से बढ़ता है?",
      "text_en": "",
      "options_hi": [
        "नकद आरक्षित अनुपात (CRR) में वृद्धि",
        "लोगों की बैंकिंग आदतों (Banking habit) में वृद्धि",
        "वैधानिक तरलता अनुपात (SLR) में वृद्धि",
        "देश की जनसंख्या में वृद्धि"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "मुद्रा और बैंकिंग",
      "exam": "",
      "explanation_hi": "मुद्रा गुणक बैंकिंग प्रणाली में ऋण निर्माण को दर्शाता है। जब लोगों की बैंकिंग की आदतें बढ़ती हैं, तो बैंक जमा में वृद्धि होती है जिससे वे अधिक ऋण दे पाते हैं और मुद्रा गुणक बढ़ता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989480-1333-7kck",
      "text_hi": "मौद्रिक नीति समिति (MPC) के संदर्भ में कौन सा कथन सही है?",
      "text_en": "",
      "options_hi": [
        "यह 12 सदस्यीय निकाय है जिसका हर साल पुनर्गठन होता है",
        "इसका नेतृत्व केंद्रीय वित्त मंत्री करते हैं",
        "यह रिज़र्व बैंक की बेंचमार्क ब्याज दर (जैसे रेपो रेट) तय करती है",
        "इसके फैसले केवल आरबीआई गवर्नर द्वारा लिए जाते हैं"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "मौद्रिक नीति",
      "exam": "",
      "explanation_hi": "MPC एक 6 सदस्यीय वैधानिक समिति है जो मुद्रास्फीति को 2-6% के लक्ष्य के भीतर रखने के लिए नीतिगत दर (Repo rate) तय करती है। इसकी अध्यक्षता RBI गवर्नर करते हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989480-1334-hcm0",
      "text_hi": "मौद्रिक नीति में 'खुले बाजार की क्रियाएं' (Open Market Operations - OMO) का क्या अर्थ है?",
      "text_en": "",
      "options_hi": [
        "बैंकों द्वारा आरबीआई से कर्ज लेना",
        "आरबीआई द्वारा बाजार में सरकारी प्रतिभूतियों (G-Secs) की खरीद और बिक्री",
        "वाणिज्यिक बैंकों द्वारा उद्योग को ऋण देना",
        "सरकार द्वारा विदेशी निवेश आकर्षित करना"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "मौद्रिक नीति",
      "exam": "",
      "explanation_hi": "OMO के तहत आरबीआई मुद्रा आपूर्ति (Liquidity) को नियंत्रित करने के लिए खुले बाजार में सरकारी प्रतिभूतियों को खरीदता और बेचता है। जब तरलता बढ़ानी हो तो खरीदता है और कम करनी हो तो बेचता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989480-1335-7ha7",
      "text_hi": "ऑपरेशन ट्विस्ट' (Operation Twist) के तहत भारतीय रिज़र्व बैंक (RBI) क्या करता है?",
      "text_en": "",
      "options_hi": [
        "विदेशी मुद्रा भंडार बेचकर रुपया खरीदता है",
        "एक साथ छोटी अवधि की प्रतिभूतियां बेचता है और लंबी अवधि की प्रतिभूतियां खरीदता है",
        "बैंकों का नकद आरक्षित अनुपात (CRR) शून्य कर देता है",
        "केवल स्वर्ण बांड जारी करता है"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "मौद्रिक नीति",
      "exam": "",
      "explanation_hi": "यह RBI का एक विशेष OMO है, जिसमें वह अल्पकालिक G-Secs बेचता है और दीर्घकालिक G-Secs खरीदता है ताकि कॉरपोरेट्स के लिए दीर्घकालिक ऋण सस्ते हो सकें।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989480-1336-807m",
      "text_hi": "बेसल-III (BASEL-III) मानदंड मुख्य रूप से किस क्षेत्र से संबंधित हैं?",
      "text_en": "",
      "options_hi": [
        "शेयर बाजार में विदेशी निवेश",
        "कृषि क्षेत्र का आधुनिकीकरण",
        "वाणिज्यिक बैंकों की पूंजी पर्याप्तता और वित्तीय स्थिरता",
        "बीमा क्षेत्र का निजीकरण"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बैंकिंग प्रणाली",
      "exam": "",
      "explanation_hi": "बेसल मानदंड 'बैंक फॉर इंटरनेशनल सेटलमेंट्स' (BIS) द्वारा जारी किए जाते हैं ताकि बैंकों की पूंजी पर्याप्तता (Capital Sufficiency) सुनिश्चित की जा सके और वैश्विक वित्तीय स्थिरता बनी रहे।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989481-1337-2gmt",
      "text_hi": "15वें वित्त आयोग ने राज्यों के बीच करों के क्षैतिज वितरण (Horizontal Distribution) में किस मापदंड को सबसे अधिक भारांक (Weightage) दिया है?",
      "text_en": "",
      "options_hi": [
        "2011 की जनसंख्या",
        "वन आवरण (Forest Cover)",
        "क्षेत्रफल (Area)",
        "आय दूरी (Income Distance)"
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "वित्त आयोग",
      "exam": "",
      "explanation_hi": "15वें वित्त आयोग ने कर वितरण में 'आय दूरी' को सर्वाधिक 45% भारांक दिया है। इसके बाद जनसंख्या (2011) और क्षेत्रफल को 15-15% भारांक दिया गया है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989481-1338-ilx9",
      "text_hi": "कृषि क्षेत्र में 'प्रच्छन्न बेरोजगारी' (Disguised Unemployment) का क्या अर्थ है?",
      "text_en": "",
      "options_hi": [
        "मशीनों के कारण श्रमिकों की छंटनी",
        "जब श्रमिक साल के कुछ ही महीने काम करते हैं",
        "जब कार्य में लगे अतिरिक्त श्रमिकों की सीमांत उत्पादकता शून्य होती है",
        "जब श्रमिक अपनी इच्छा से काम नहीं करते"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बेरोजगारी",
      "exam": "",
      "explanation_hi": "प्रच्छन्न बेरोजगारी का अर्थ है कि किसी काम में आवश्यकता से अधिक लोग लगे हैं। यदि उनमें से कुछ को हटा भी दिया जाए, तो कुल उत्पादन पर कोई प्रभाव नहीं पड़ता।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989481-1339-v8ep",
      "text_hi": "फिलिप्स वक्र (Phillips Curve) किन दो आर्थिक चरों के बीच संबंध दर्शाता है?",
      "text_en": "",
      "options_hi": [
        "कर की दर और कर राजस्व",
        "मुद्रास्फीति और बेरोजगारी",
        "आर्थिक विकास और पर्यावरण प्रदूषण",
        "गरीबी और आय की असमानता"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "मुद्रास्फीति (Inflation)",
      "exam": "",
      "explanation_hi": "फिलिप्स वक्र के अनुसार मुद्रास्फीति (Inflation) और बेरोजगारी (Unemployment) के बीच विपरीत संबंध होता है। मुद्रास्फीति बढ़ने पर बेरोजगारी कम होती है और इसके विपरीत।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989481-1340-ypoi",
      "text_hi": "प्रभावी राजस्व घाटा' (Effective Revenue Deficit) का सही सूत्र क्या है?",
      "text_en": "",
      "options_hi": [
        "राजकोषीय घाटा - ब्याज भुगतान",
        "राजस्व व्यय - राजस्व प्राप्तियां",
        "राजस्व घाटा - पूंजीगत संपत्ति के सृजन के लिए अनुदान",
        "बजटीय घाटा + बाजार उधारी"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "सार्वजनिक वित्त (बजट)",
      "exam": "",
      "explanation_hi": "प्रभावी राजस्व घाटा (ERD) निकालने के लिए 'राजस्व घाटे' में से उन अनुदानों को घटाया जाता है जो केंद्र द्वारा राज्यों को दिए जाते हैं लेकिन उनका उपयोग पूंजीगत संपत्ति (जैसे स्कूल/अस्पताल) बनाने में होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989482-1341-3z3a",
      "text_hi": "प्राथमिक घाटा' (Primary Deficit) की गणना कैसे की जाती है?",
      "text_en": "",
      "options_hi": [
        "राजस्व घाटा - विदेशी अनुदान",
        "राजकोषीय घाटा - ब्याज भुगतान",
        "कुल व्यय - कुल प्राप्तियां",
        "राजकोषीय घाटा - पूंजीगत व्यय"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "सार्वजनिक वित्त (बजट)",
      "exam": "",
      "explanation_hi": "प्राथमिक घाटा यह दर्शाता है कि पुरानी उधारी पर ब्याज भुगतान को छोड़कर सरकार की वर्तमान उधारी आवश्यकता कितनी है (Primary Deficit = Fiscal Deficit - Interest Payments)।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989482-1342-npdj",
      "text_hi": "सकल घरेलू उत्पाद (GDP) और सकल मूल्य वर्धित (GVA) के बीच क्या संबंध है?",
      "text_en": "",
      "options_hi": [
        "GDP = GVA - मूल्यह्रास",
        "GDP = GVA + अप्रत्यक्ष कर - सब्सिडी",
        "GVA = GDP + प्रत्यक्ष कर",
        "GDP = GVA + विदेशी आय"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "राष्ट्रीय आय",
      "exam": "",
      "explanation_hi": "GVA उत्पादक के नजरिए से उत्पादन मापता है। बाज़ार मूल्य पर GDP प्राप्त करने के लिए बुनियादी मूल्य (Basic Price) पर GVA में अप्रत्यक्ष कर जोड़े जाते हैं और उत्पाद सब्सिडी घटाई जाती है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989482-1343-mlcq",
      "text_hi": "गिनी गुणांक' (Gini Coefficient) का उपयोग अर्थशास्त्र में क्या मापने के लिए किया जाता है?",
      "text_en": "",
      "options_hi": [
        "मुद्रास्फीति की दर",
        "आर्थिक विकास की दर",
        "आय या धन की असमानता (Inequality)",
        "बेरोजगारी की दर"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "गरीबी और असमानता",
      "exam": "",
      "explanation_hi": "गिनी गुणांक इतालवी सांख्यिकीविद् कोर्राडो गिनी द्वारा विकसित किया गया था। यह आय वितरण में असमानता मापता है (0% पूर्ण समानता और 100% पूर्ण असमानता को दर्शाता है)।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989483-1344-xcg6",
      "text_hi": "नीति आयोग (NITI Aayog) के संदर्भ में निम्नलिखित में से कौन सा कार्य इसका नहीं है?",
      "text_en": "",
      "options_hi": [
        "थिंक टैंक के रूप में कार्य करना",
        "राज्यों को पंचवर्षीय योजनाओं के लिए धन/फंड आवंटित करना",
