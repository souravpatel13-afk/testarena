      "topic": "विशेषण",
      "exam": "",
      "explanation_hi": "उच्चतम' सुपरलेटिव डिग्री है जिसे हिन्दी में उत्तमावस्था कहते हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989418-1101-x0bh",
      "text_hi": "रचना की दृष्टि से क्रिया के कितने भेद होते हैं?",
      "text_en": "",
      "options_hi": [
        "2",
        "3",
        "4",
        "5"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "हिन्दी व्याकरण",
      "topic": "क्रिया",
      "exam": "",
      "explanation_hi": "रचना की दृष्टि से क्रिया के दो भेद हैं- सकर्मक क्रिया और अकर्मक क्रिया।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989418-1102-ji7k",
      "text_hi": "जिस क्रिया का फल कर्म पर पड़ता है, उसे क्या कहते हैं?",
      "text_en": "",
      "options_hi": [
        "अकर्मक क्रिया",
        "सकर्मक क्रिया",
        "प्रेरणार्थक क्रिया",
        "नामधातु क्रिया"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "क्रिया",
      "exam": "",
      "explanation_hi": "जिस क्रिया का फल कर्म पर पड़ता है तथा जिसके प्रयोग में कर्म की अनिवार्यता बनी रहती है उसे सकर्मक क्रिया कहते हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989418-1103-7d4a",
      "text_hi": "हँसना' किस प्रकार की क्रिया है?",
      "text_en": "",
      "options_hi": [
        "सकर्मक",
        "द्विकर्मक",
        "अकर्मक",
        "प्रेरणार्थक"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "हिन्दी व्याकरण",
      "topic": "क्रिया",
      "exam": "",
      "explanation_hi": "जब क्रिया का फल कर्ता में ही निहित रहता है और कर्म की आवश्यकता नहीं होती (जैसे- हँसना, रोना), तो वह अकर्मक क्रिया है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989419-1104-cpmi",
      "text_hi": "वर्तमान काल के कितने भेद होते हैं?",
      "text_en": "",
      "options_hi": [
        "3",
        "4",
        "5",
        "6"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "हिन्दी व्याकरण",
      "topic": "काल",
      "exam": "",
      "explanation_hi": "वर्तमान काल के 5 भेद हैं- सामान्य, तात्कालिक, पूर्ण, संदिग्ध और संभाव्य वर्तमान काल।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989419-1105-hkbx",
      "text_hi": "भूतकाल के कितने भेद होते हैं?",
      "text_en": "",
      "options_hi": [
        "4",
        "5",
        "6",
        "7"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "हिन्दी व्याकरण",
      "topic": "काल",
      "exam": "",
      "explanation_hi": "भूतकाल के 6 भेद हैं- सामान्य, आसन्न, पूर्ण, अपूर्ण, संदिग्ध और हेतु हेतु मद भूतकाल।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989419-1106-8j6p",
      "text_hi": "अत्याचार' शब्द में कौन सा उपसर्ग है?",
      "text_en": "",
      "options_hi": [
        "अ",
        "अत",
        "अति",
        "अत्या"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "हिन्दी व्याकरण",
      "topic": "उपसर्ग",
      "exam": "",
      "explanation_hi": "अत्याचार' शब्द 'अति + आचार' से बना है, जिसमें 'अति' संस्कृत का उपसर्ग है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989420-1107-5irc",
      "text_hi": "निडर' शब्द में किस उपसर्ग का प्रयोग हुआ है?",
      "text_en": "",
      "options_hi": [
        "नि",
        "नि:",
        "निड",
        "नी"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "हिन्दी व्याकरण",
      "topic": "उपसर्ग",
      "exam": "",
      "explanation_hi": "निडर शब्द में हिन्दी का 'नि' (निषेध के अर्थ में) उपसर्ग लगा है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989420-1108-xhq5",
      "text_hi": "धातु या क्रिया के अंत में जुड़ने वाले प्रत्यय क्या कहलाते हैं?",
      "text_en": "",
      "options_hi": [
        "तद्धित प्रत्यय",
        "कृत् प्रत्यय",
        "देशज प्रत्यय",
        "विदेशज प्रत्यय"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "प्रत्यय",
      "exam": "",
      "explanation_hi": "जो प्रत्यय क्रिया या धातु के मूल रूप में अंत में जोड़े जाते हैं, उन्हें 'कृत्' प्रत्यय कहते हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989420-1109-u7xx",
      "text_hi": "तैराक' शब्द में कौन सा प्रत्यय जुड़ा है?",
      "text_en": "",
      "options_hi": [
        "आक",
        "राक",
        "क",
        "तैरा"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "हिन्दी व्याकरण",
      "topic": "प्रत्यय",
      "exam": "",
      "explanation_hi": "तैर + आक = तैराक', इसमें 'आक' कृत् प्रत्यय का प्रयोग हुआ है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989421-1110-v8sf",
      "text_hi": "बुढ़ापा' शब्द में कौन सा प्रत्यय लगा है?",
      "text_en": "",
      "options_hi": [
        "पा",
        "आपा",
        "बूढ़ा",
        "आप"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "प्रत्यय",
      "exam": "",
      "explanation_hi": "बूढ़ा + आपा = बुढ़ापा', यहाँ 'आपा' तद्धित प्रत्यय है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989421-1111-ag0n",
      "text_hi": "दो समीपवर्ती वर्णों के मेल से जो विकार उत्पन्न होता है, उसे क्या कहते हैं?",
      "text_en": "",
      "options_hi": [
        "समास",
        "संधि",
        "प्रत्यय",
        "उपसर्ग"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "संधि",
      "exam": "",
      "explanation_hi": "दो समीपवर्ती वर्णों के मेल से जो विकार (परिवर्तन) उत्पन्न होता है, उसे संधि कहते हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989421-1112-7613",
      "text_hi": "स्वर संधि के कितने भेद होते हैं?",
      "text_en": "",
      "options_hi": [
        "3",
        "4",
        "5",
        "6"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "हिन्दी व्याकरण",
      "topic": "संधि",
      "exam": "",
      "explanation_hi": "स्वर संधि के पाँच भेद हैं- दीर्घ, गुण, वृद्धि, यण और अयादि स्वर संधि।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989421-1113-yngb",
      "text_hi": "विद्यालय' शब्द में कौन सी संधि है?",
      "text_en": "",
      "options_hi": [
        "गुण स्वर संधि",
        "यण स्वर संधि",
        "अयादि स्वर संधि",
        "दीर्घ स्वर संधि"
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "हिन्दी व्याकरण",
      "topic": "संधि",
      "exam": "",
      "explanation_hi": "विद्या + आलय = विद्यालय' (आ + आ = आ), यह दीर्घ स्वर संधि का उदाहरण है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989422-1114-dk8e",
      "text_hi": "महोत्सव' का सही संधि विच्छेद क्या है?",
      "text_en": "",
      "options_hi": [
        "मह + उत्सव",
        "महा + उत्सव",
        "महो + त्सव",
        "महा + ओत्सव"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "संधि",
      "exam": "",
      "explanation_hi": "महा + उत्सव = महोत्सव' (आ + उ = ओ), यह गुण स्वर संधि का उदाहरण है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989422-1115-rfuk",
      "text_hi": "सज्जन' (सत् + जन) किस संधि का उदाहरण है?",
      "text_en": "",
      "options_hi": [
        "स्वर संधि",
        "व्यंजन संधि",
        "विसर्ग संधि",
        "इनमें से कोई नहीं"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "संधि",
      "exam": "",
      "explanation_hi": "त् का मेल ज से होने पर त् का ज् बन जाता है (सत् + जन = सज्जन), यह व्यंजन संधि है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989422-1116-5ayd",
      "text_hi": "पानी' शब्द हिन्दी व्याकरण में किस लिंग के अंतर्गत आता है?",
