      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "लिंग",
      "exam": "",
      "explanation_hi": "हिन्दी में द्रव पदार्थों के नाम जैसे पानी, तेल, पेट्रोल प्रायः पुर्लिंग होते हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989423-1117-mxxs",
      "text_hi": "दही' शब्द किस लिंग का उदाहरण है?",
