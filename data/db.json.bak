      "options_en": [],
      "correctAnswer": 0,
      "subject": "हिन्दी व्याकरण",
      "topic": "विशेषण",
      "exam": "",
      "explanation_hi": "विशेषण की तीन अवस्थाएँ होती हैं- मूलावस्था, उत्तरावस्था और उत्तमावस्था।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989418-1100-tc3p",
      "text_hi": "उच्चतम' विशेषण की कौन सी अवस्था है?",
      "text_en": "",
      "options_hi": [
