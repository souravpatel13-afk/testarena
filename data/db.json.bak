      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "शिवाजी ने अपनी आय बढ़ाने के लिए पड़ोसी मुगल क्षेत्रों से 'चौथ' नामक कर वसूला, जो कुल राजस्व का 25% था। [94]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989176-247-c1o1",
      "text_hi": "औरंगजेब ने किस वर्ष हिंदुओं पर पुनः 'जज़िया' (Jizyah) कर लगा दिया था?",
      "text_en": "",
      "options_hi": [
        "1669",
        "1675",
        "1679",
        "1681"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "औरंगजेब ने राजनीतिक कारणों और उलेमाओं को खुश करने के लिए अपने शासन के 22वें वर्ष (1679) में जज़िया पुनः लागू किया। [95]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989176-248-qpxn",
      "text_hi": "1675 में औरंगजेब के आदेश पर किस सिख गुरु को दिल्ली में मृत्युदंड दिया गया था?",
      "text_en": "",
      "options_hi": [
        "गुरु हर राय",
        "गुरु हर किशन",
        "गुरु तेग बहादुर",
        "गुरु गोबिंद सिंह"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "औरंगजेब ने गुरु तेग बहादुर को पकड़वाया और धर्म (Islam) स्वीकार न करने पर उन्हें मृत्युदंड दे दिया गया। [96]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989176-249-b4el",
      "text_hi": "1669 में मथुरा के आसपास के जाट किसानों ने किसके नेतृत्व में मुगलों के खिलाफ विद्रोह किया था?",
      "text_en": "",
      "options_hi": [
        "राजाराम",
        "चूड़ामन",
        "गोकुला (Gokla)",
        "बदन सिंह"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "स्थानीय जमींदार गोकुला के नेतृत्व में जाटों ने विद्रोह किया, जिसे दबाने के लिए औरंगजेब को स्वयं वहां जाना पड़ा। [97, 98]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989176-250-cx2c",
      "text_hi": "मुगल साम्राज्य के पतन का एक प्रमुख कारण 'जागीरदारी संकट' (Crisis of Jagirdari system) माना जाता है। इसका मुख्य अर्थ क्या था?",
      "text_en": "",
      "options_hi": [
        "जागीरदारों का विद्रोह",
        "कागजी आय और वास्तविक वसूली में भारी अंतर होना",
        "जागीरदारों का किसान बन जाना",
        "सवारी घोड़ों की कमी"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "सत्रहवीं सदी के अंत में जागीरों से वास्तविक आय कागजी आय से बहुत कम हो गई थी, जिससे मनसबदार सैनिक नहीं रख पाते थे। [99-101]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989177-251-acjq",
      "text_hi": "1686 ई. में औरंगजेब ने लंबी घेराबंदी के बाद दक्कन के किस प्रमुख राज्य को मुगल साम्राज्य में मिला लिया?",
      "text_en": "",
      "options_hi": [
        "गोलकुंडा",
        "बीजापुर",
        "अहमदनगर",
        "विजयनगर"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "औरंगजेब ने मराठों को मिलने वाले समर्थन को काटने के लिए 18 महीने की घेराबंदी के बाद बीजापुर पर विजय प्राप्त की। [102]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989177-252-zsuh",
      "text_hi": "महान सूफी विचारक इब्न-अरबी का 'तौहीद-ए-वजूदी' (Tauhid-i-Wajudi) सिद्धांत, जो भारत में भी लोकप्रिय हुआ, का क्या अर्थ है?",
      "text_en": "",
      "options_hi": [
        "कट्टरपंथी इस्लाम",
        "ईश्वर और निर्मित ब्रह्मांड अनिवार्य रूप से एक हैं",
        "पवित्र युद्ध",
        "धार्मिक एकांतवास"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "इस सिद्धांत (Unity of Being) ने माना कि सभी जीव अनिवार्य रूप से एक हैं, जिसने हिंदू-मुस्लिम समन्वय को बढ़ावा दिया। [103]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989177-253-yf7w",
      "text_hi": "शाहजहां द्वारा दिल्ली में बनाई गई प्रसिद्ध मस्जिद कौन सी है जो लाल बलुआ पत्थर से बनी है?",
      "text_en": "",
      "options_hi": [
        "मोती मस्जिद",
        "जामा मस्जिद",
        "फतेहपुरी मस्जिद",
        "बादशाही मस्जिद"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "शाहजहां ने लाल बलुआ पत्थर से दिल्ली में विशाल जामा मस्जिद का निर्माण करवाया जो मुगल वास्तुकला का उत्कृष्ट नमूना है। [104]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989178-254-is21",
      "text_hi": "अकबर के काल में मुगल चित्रकला को फारसी प्रभाव से मुक्त कर भारतीय रंग और 'थ्री-डायमेंशनल' प्रभाव देने में किस चित्रकार का नाम प्रमुख है?",
      "text_en": "",
      "options_hi": [
        "मंसूर",
        "बसावन",
        "अब्दुस समद",
        "मीर सैयद अली"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "अकबर के दरबार में दसवंत और बसावन जैसे भारतीय चित्रकारों ने मुगल चित्रकला में भारतीयता और गोलाई (Roundedness) का समावेश किया। [105]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989178-255-wi2i",
      "text_hi": "ताजमहल' और 'इतमादुद्दौला के मकबरे' में कीमती पत्थरों (अर्ध-रत्न) की जड़ाई वाली सजावट की शैली को क्या कहा जाता है?",
      "text_en": "",
      "options_hi": [
        "अरबेस्क (Arabesque)",
        "स्टुको (Stucco)",
        "पिएत्रा ड्यूरा (Pietra dura)",
        "भित्ति चित्र (Fresco)"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "संगमरमर की दीवारों को अर्ध-कीमती पत्थरों से सजाने की इस बारीक कला को 'पिएत्रा ड्यूरा' कहा जाता है। [777 - Reference context implied]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989178-256-1cmq",
      "text_hi": "किस मुगल शासक के काल में उपनिषदों और भगवद्गीता का फारसी में अनुवाद दारा शिकोह के प्रयासों से हुआ?",
      "text_en": "",
      "options_hi": [
        "अकबर",
        "जहांगीर",
        "शाहजहां",
        "औरंगजेब"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "शाहजहां के सबसे बड़े पुत्र दारा शिकोह ने बनारस के ब्राह्मणों की मदद से वेदों और गीता का फारसी में अनुवाद कराया। [106]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989179-257-v41q",
      "text_hi": "अकबर के शासनकाल के उत्तरार्ध में मनसबदारी व्यवस्था में किस नए वर्ग को बड़े पैमाने पर शामिल किया गया था, जो मुगल सेना की रीढ़ बने?",
      "text_en": "",
      "options_hi": [
        "तुर्क",
        "राजपूत",
        "हब्शी",
        "अफगान"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "अकबर ने राजपूत राजाओं से न केवल वैवाहिक संबंध बनाए बल्कि उन्हें उच्च मनसब (जैसे राजा मान सिंह को 7000) देकर साम्राज्य का मुख्य स्तंभ बनाया। [107]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989179-258-5z27",
      "text_hi": "दक्षिण भारत में गोलकुंडा राज्य (Qutb Shahi Dynasty) का प्रशासन 1672 से 1687 तक किन दो हिंदू भाइयों के हाथों में था?",
      "text_en": "",
      "options_hi": [
        "हरिहर और बुक्का",
        "मदन्ना और अखन्ना",
        "तानाशाह और रामदास",
        "शिवाजी और शंभाजी"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "मदन्ना और अखन्ना ने गोलकुंडा के प्रशासन पर नियंत्रण रखा और शिवाजी के साथ गठबंधन की नीति अपनाई। [108, 109]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989179-259-bl54",
      "text_hi": "17वीं शताब्दी में विदेशी व्यापार के संदर्भ में 'कोरोमंडल तट' से किस भारतीय वस्तु का सबसे ज्यादा निर्यात यूरोप को होता था?",
      "text_en": "",
      "options_hi": [
        "मसाले",
        "सूती कपड़ा (Textiles/Calico)",
        "शोरा (Saltpetre)",
        "रेशम"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "डच और अंग्रेजों ने पाया कि दक्षिण पूर्व एशिया में मसालों के बदले भारतीय सूती कपड़े की भारी मांग थी, जो कोरोमंडल तट से निर्यात होता था। [110]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989179-260-ohzz",
      "text_hi": "अकबर के काल में प्रांतीय प्रशासन के अंतर्गत कानून व्यवस्था (Law and Order) के लिए कौन सा अधिकारी जिम्मेदार होता था?",
      "text_en": "",
      "options_hi": [
