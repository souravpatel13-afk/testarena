      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "कामन्दक ने नीतिसार की रचना की थी, जो राजनीतिक नैतिकता और प्रशासन के अध्ययन के लिए बहुत लोकप्रिय थी।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989180-263-pfuc",
      "text_hi": "9वीं शताब्दी में बल्ख के किस प्रसिद्ध अरब खगोलशास्त्री ने बनारस (वाराणसी) में 10 वर्षों तक खगोलशास्त्र का अध्ययन किया था?",
      "text_en": "",
      "options_hi": [
        "अल-बरूनी",
        "सुलेमान",
        "अबू माशर (Abu Maashir)",
        "अल-मसूदी"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "अरब खगोलशास्त्री अबू माशर ने 9वीं शताब्दी में बनारस में 10 वर्षों तक रहकर भारतीय विज्ञान और खगोलशास्त्र का गहन अध्ययन किया था।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989180-264-b06z",
      "text_hi": "9वीं शताब्दी के अंत तक 'अल-हिंद' (भारत) का हिस्सा माने जाने वाले किस क्षेत्र में 53.5 मीटर ऊंची बुद्ध की विशाल प्रतिमा स्थित थी?",
      "text_en": "",
      "options_hi": [
        "कंधार",
        "काबुल",
        "बामियान",
        "मुल्तान"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "बामियान (अब अफगानिस्तान में) में बुद्ध की 53.5 मीटर विशाल प्रतिमा और हजार भिक्षुओं के रहने के लिए गुफाएं मौजूद थीं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989181-265-z446",
      "text_hi": "चौहान वंश के किस महान शासक ने 1151 ई. में तोमरों से दिल्ली (ढिल्लिका) छीनी और अजमेर में एक संस्कृत कॉलेज बनवाया?",
      "text_en": "",
      "options_hi": [
        "पृथ्वीराज तृतीय",
        "विग्रहराज",
        "अजयराज",
        "अर्णोराज"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "चौहान शासक विग्रहराज ने चित्तौड़ और दिल्ली पर कब्ज़ा किया, अजमेर को राजधानी बनाया और वहाँ एक संस्कृत कॉलेज का निर्माण करवाया।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989181-266-ceyn",
      "text_hi": "मोहम्मद बिन तुगलक के दरबार में किस प्रसिद्ध जैन संत ने उसके साथ धर्म और दर्शन पर चर्चा की थी?",
      "text_en": "",
      "options_hi": [
        "भद्रबाहु",
        "हेमचंद्र सूरी",
        "जिनप्रभा सूरी (Jinaprabha Suri)",
        "स्थूलभद्र"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "मोहम्मद बिन तुगलक का दृष्टिकोण खुला था और वह जिनप्रभा सूरी जैसे जैन संतों और हिंदू योगियों से भी विचार-विमर्श करता था।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989182-267-b20v",
      "text_hi": "दिल्ली सल्तनत के प्रशासन में 'परगना' (Pargana) का प्रमुख अधिकारी कौन होता था?",
      "text_en": "",
      "options_hi": [
        "मुकद्दम",
        "पटवारी",
        "आमिल (Amil)",
        "खूत"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "सल्तनत प्रशासन में शुक (Shiq) के नीचे परगना होता था जिसका प्रमुख अधिकारी 'आमिल' कहलाता था जो राजस्व वसूली देखता था।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989182-268-c7x1",
      "text_hi": "सल्तनत काल में 'खूत' (Khut) और 'मुकद्दम' (Muqaddam) शब्दों का प्रयोग किनके लिए किया जाता था?",
      "text_en": "",
      "options_hi": [
        "सैन्य अधिकारी",
        "गाँव के ज़मींदार और मुखिया",
        "धार्मिक गुरु",
        "बड़े व्यापारी"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "गाँव के स्तर पर सबसे महत्वपूर्ण व्यक्ति 'खूत' (ज़मींदार या भूस्वामी) और 'मुकद्दम' (गाँव का मुखिया) होते थे।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989182-269-hd70",
      "text_hi": "गुजरात के किस शक्तिशाली सुल्तान को 'बेगड़ा' कहा जाता था क्योंकि उसने गिरनार और चंपानेर के दो किले (गढ़) जीते थे?",
      "text_en": "",
      "options_hi": [
        "अहमद शाह",
        "महमूद बेगड़ा",
        "मुज़फ्फर शाह",
        "बहादुर शाह"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "महमूद बेगड़ा (1459-1511) ने सौराष्ट्र के गिरनार और दक्षिण गुजरात के चंपानेर किलों पर विजय प्राप्त की थी।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989182-270-6m56",
      "text_hi": "शर्की सुल्तानों की राजधानी 'जौनपुर' को उसकी उत्कृष्ट वास्तुकला और विद्या के कारण क्या उपाधि दी गई थी?",
      "text_en": "",
      "options_hi": [
        "पूरब का रोम",
        "पूरब का मक्का",
        "पूरब का शिराज (Shiraz of the East)",
        "उत्तर का एथेंस"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "जौनपुर विद्या, साहित्य और कला का महान केंद्र बन गया था, इसलिए इसे सांस्कृतिक गरिमा के कारण 'पूरब का शिराज' कहा जाने लगा।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989183-271-18cu",
      "text_hi": "प्रसिद्ध हिंदी महाकाव्य 'पद्मावत' (Padmavat) के रचयिता सूफी कवि मलिक मुहम्मद जायसी किस स्थान पर रहते थे?",
      "text_en": "",
      "options_hi": [
        "दिल्ली",
        "आगरा",
        "जौनपुर",
        "लाहौर"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "सूफी संत और कवि मलिक मुहम्मद जायसी शर्की सुल्तानों के संरक्षण में सांस्कृतिक शहर जौनपुर में रहते थे।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989183-272-7bxe",
      "text_hi": "1484 ई. में दिल्ली के किस सुल्तान ने जौनपुर पर कब्ज़ा कर शर्की साम्राज्य का स्थायी रूप से अंत कर दिया?",
      "text_en": "",
      "options_hi": [
