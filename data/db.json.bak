      "options_en": [],
      "correctAnswer": 2,
      "subject": "हिन्दी व्याकरण",
      "topic": "समास",
      "exam": "",
      "explanation_hi": "वीणापाणि' (सरस्वती) बहुव्रीहि समास और योगरूढ़ शब्द का एक प्रमुख उदाहरण है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989431-1144-a9u8",
      "text_hi": "हलधर' किस समास का उदाहरण है?",
      "text_en": "",
      "options_hi": [
