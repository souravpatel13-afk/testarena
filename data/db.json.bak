      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "सर्वनाम",
      "exam": "",
      "explanation_hi": "जो, सो' सर्वनाम शब्दों से दो भिन्न बातों में संबंध स्पष्ट होता है, अतः ये संबंधवाचक सर्वनाम हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989416-1095-598k",
      "text_hi": "यह' और 'वह' किस प्रकार के सर्वनाम हैं?",
      "text_en": "",
      "options_hi": [
