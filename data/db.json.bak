    },
    {
      "id": "q-sheet-1785335989410-1072-9gt5",
      "text_hi": "हिन्दी भाषा के क्रमिक विकास की अवस्थाओं को सही तार्किक क्रम में व्यवस्थित करें- (K) शौरसेनी अपभ्रंश (L) पालि (M) संस्कृत (N) खड़ी बोली (O) प्राकृत",
      "text_en": "",
      "options_hi": [
        "M -> L -> O -> K -> N",
        "M -> O -> L -> K -> N",
        "L -> M -> O -> K -> N",
        "M -> L -> K -> O -> N"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "हिन्दी व्याकरण",
      "topic": "भाषा विकास",
      "exam": "",
      "explanation_hi": "हिन्दी भाषा का क्रमिक विकास: संस्कृत -> पालि -> प्राकृत -> शौरसेनी अपभ्रंश -> पश्चिमी हिन्दी (खड़ी बोली) है। [पृष्ठ 112]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989410-1073-a6pu",
      "text_hi": "सर्वनाम के संबंध में निम्नलिखित कथनों पर विचार करें- (J) हिन्दी में मूल सर्वनामों की कुल संख्या 11 है। (K) 'जो' और 'सो' संबंधवाचक सर्वनाम हैं। (L) 'मैं' और 'हम' मध्यम पुरुषवाचक सर्वनाम के उदाहरण हैं।",
      "text_en": "",
      "options_hi": [
        "केवल J और K सत्य हैं।",
        "J, K और L तीनों सत्य हैं।",
        "केवल K और L सत्य हैं।",
        "केवल J और L सत्य हैं।"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "हिन्दी व्याकरण",
      "topic": "सर्वनाम",
      "exam": "",
      "explanation_hi": "कथन J और K सत्य हैं। कथन L असत्य है क्योंकि 'मैं' और 'हम' उत्तम पुरुषवाचक सर्वनाम हैं, मध्यम पुरुष (तू/तुम) नहीं। [पृष्ठ 215]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989410-1074-kmgy",
      "text_hi": "प्रत्यय के संबंध में निम्नलिखित कथनों का विश्लेषण करें- (J) जो शब्दांश धातु या क्रिया के अंत में जुड़ते हैं, उन्हें कृत् प्रत्यय कहते हैं। (K) संज्ञा, सर्वनाम या विशेषण के अंत में जुड़ने वाले प्रत्यय तद्धित प्रत्यय कहलाते हैं। (L) 'तैराक' शब्द में 'आक' तद्धित प्रत्यय का उदाहरण है।",
      "text_en": "",
      "options_hi": [
        "केवल J और K सत्य हैं।",
        "केवल J और L सत्य हैं।",
        "केवल K और L सत्य हैं।",
        "J, K और L तीनों सत्य हैं।"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "हिन्दी व्याकरण",
      "topic": "प्रत्यय",
      "exam": "",
      "explanation_hi": "J और K सत्य हैं। L असत्य है क्योंकि 'तैरना' एक क्रिया (धातु) है, अतः इसमें जुड़ा 'आक' प्रत्यय कृत् (कृदन्त) प्रत्यय होगा, तद्धित नहीं। [पृष्ठ 255]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989411-1075-uouw",
      "text_hi": "विशेषण की अवस्थाओं के संबंध में निम्नलिखित कथनों पर विचार करें- (J) विशेषण की तीन अवस्थाएँ होती हैं: मूलावस्था, उत्तरावस्था और उत्तमावस्था। (K) 'अधिकतर' विशेषण की उत्तमावस्था का रूप है। (L) परिमाणवाचक विशेषण से किसी वस्तु की नाप-तौल का बोध होता है।",
      "text_en": "",
      "options_hi": [
        "केवल J और L सत्य हैं।",
        "केवल J और K सत्य हैं।",
        "केवल K और L सत्य हैं।",
        "J, K और L तीनों सत्य हैं।"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "हिन्दी व्याकरण",
      "topic": "विशेषण",
      "exam": "",
      "explanation_hi": "J और L सत्य हैं। K असत्य है क्योंकि 'अधिकतर' उत्तरावस्था (Comparative) है, जबकि इसकी उत्तमावस्था 'अधिकतम' (Superlative) होती है। [पृष्ठ 220]",
      "explanation_en": ""
    },
