        "निजवाचक",
        "निश्चयवाचक",
        "संबंधवाचक"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "हिन्दी व्याकरण",
      "topic": "सर्वनाम",
      "exam": "",
      "explanation_hi": "दूर या समीप की वस्तुओं का निश्चयात्मक संकेत देने वाले शब्द निश्चयवाचक सर्वनाम कहलाते हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989416-1096-1c6z",
      "text_hi": "विशेषण के मुख्य रूप से कितने भेद होते हैं?",
      "text_en": "",
      "options_hi": [
        "3",
        "4",
        "5",
        "6"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "विशेषण",
      "exam": "",
      "explanation_hi": "हिंदी में विशेषण के मूलतः चार भेद होते हैं- गुणवाचक, संख्यावाचक, परिमाणवाचक और सार्वनामिक विशेषण।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989417-1097-euhp",
      "text_hi": "थोड़ा पानी' में कौन सा विशेषण है?",
      "text_en": "",
      "options_hi": [
        "गुणवाचक",
        "संख्यावाचक",
        "परिमाणवाचक",
        "सार्वनामिक"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "हिन्दी व्याकरण",
      "topic": "विशेषण",
      "exam": "",
      "explanation_hi": "जिन विशेषणों से संज्ञा या सर्वनाम के परिमाण (मात्रा) का बोध होता है, वे परिमाणवाचक विशेषण कहलाते हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989417-1098-aa7j",
      "text_hi": "लाल' रंग किस विशेषण का उदाहरण है?",
      "text_en": "",
      "options_hi": [
