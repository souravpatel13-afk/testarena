    },
    {
      "id": "q-sheet-1785335989187-287-1sen",
      "text_hi": "दिल्ली सल्तनत में सेना को सुव्यवस्थित करने के लिए एक अलग सैन्य विभाग 'दीवान-ए-अर्ज' की स्थापना सबसे पहले किसने की थी?",
      "text_en": "",
      "options_hi": [
        "इल्तुतमिश",
        "बलबन",
        "अलाउद्दीन खिलजी",
        "मुहम्मद बिन तुगलक"
