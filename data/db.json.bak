      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "शेर शाह ने भूमि को मापकर विभिन्न प्रकार की फसलों के आधार पर एक अनुसूची तैयार की, जिसके आधार पर कर तय होता था। [71]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989170-229-ozrt",
      "text_hi": "नवंबर 1556 में लड़े गए 'पानीपत के दूसरे युद्ध' में मुगलों (बैरम खान) ने किसे पराजित किया था?",
      "text_en": "",
      "options_hi": [
        "इब्राहिम लोदी",
        "सिकंदर सूर",
        "हेमू (विक्रमाजीत)",
        "बाज़ बहादुर"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "आदिल शाह के सेनापति हेमू ने दिल्ली पर कब्जा कर लिया था, लेकिन इस युद्ध में बैरम खान के नेतृत्व में मुगलों ने उसे हरा दिया। [72]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989171-230-8v3o",
      "text_hi": "अकबर के काल में 'गढ़-कटंगा' (गोंडवाना) की वीर शासिका कौन थीं, जिन्होंने मुगलों से लड़ते हुए प्राण त्याग दिए?",
      "text_en": "",
      "options_hi": [
        "रानी कर्णावती",
        "चांद बीबी",
        "रानी दुर्गावती",
        "रूपमती"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "रानी दुर्गावती ने 1564 में आसफ खान के नेतृत्व वाली मुगल सेना का वीरता से सामना किया और हार निश्चित देखकर आत्महत्या कर ली। [73]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989171-231-4wfz",
      "text_hi": "1576 के प्रसिद्ध 'हल्दीघाटी के युद्ध' में मुगल सेना का नेतृत्व मुख्य रूप से किसने किया था?",
      "text_en": "",
      "options_hi": [
        "बैरम खान",
        "राजा मान सिंह",
        "राजा टोडरमल",
        "अब्दुर रहीम खान-ए-खानां"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "अकबर ने आमेर के राजा मान सिंह को राणा प्रताप के खिलाफ मुगल सेना का नेतृत्व सौंपा था। [74]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989171-232-a6bp",
      "text_hi": "हल्दीघाटी के युद्ध में राणा प्रताप की सेना के हरावल (Van - अग्रिम पंक्ति) का नेतृत्व कौन कर रहा था?",
      "text_en": "",
      "options_hi": [
        "राजा टोडरमल",
        "हकीम खान सूर",
        "राव मालदेव",
        "जयमल"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "राणा प्रताप की सेना के अग्रिम दल का नेतृत्व अफगान सेनापति हकीम खान सूर कर रहा था, जो दर्शाता है कि यह हिंदू-मुस्लिम युद्ध नहीं था। [74, 75]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989171-233-zbyy",
      "text_hi": "अकबर के शासनकाल में 1580 में भू-राजस्व की 'दहसाला' (Dahsala) प्रणाली किसने विकसित करने में प्रमुख भूमिका निभाई?",
      "text_en": "",
      "options_hi": [
        "बीरबल",
        "राजा मान सिंह",
        "राजा टोडरमल",
        "मुनीम खान"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "पिछले 10 वर्षों के औसत उत्पादन और कीमतों के आधार पर टोडरमल और अन्य राजस्व अधिकारियों ने दहसाला प्रणाली लागू की। [76, 77]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989172-234-k0jy",
      "text_hi": "मुगल प्रशासन में 'मनसबदारी' प्रणाली के अंतर्गत 'ज़ात' (Zat) रैंक क्या दर्शाता था?",
      "text_en": "",
      "options_hi": [
        "रखे जाने वाले घुड़सवारों की संख्या",
        "अधिकारी की व्यक्तिगत स्थिति और वेतन",
        "प्रशासनिक पद",
        "जागीर का क्षेत्रफल"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "ज़ात' रैंक मनसबदार का व्यक्तिगत स्टेटस और उसका वेतन तय करता था, जबकि 'सवार' रैंक घुड़सवारों की संख्या बताता था। [78]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989172-235-q0u6",
      "text_hi": "अकबर ने 1564 में गैर-मुस्लिमों पर लगने वाले किस कर को समाप्त कर दिया था?",
      "text_en": "",
      "options_hi": [
