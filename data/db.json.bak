    },
    {
      "id": "q-sheet-1785335989339-826-u7nw",
      "text_hi": "पूरे भारत में 'टिन' (Tin) का एकमात्र व्यावसायिक उत्पादक राज्य कौन सा है?",
      "text_en": "",
      "options_hi": [
        "झारखण्ड",
        "ओडिशा",
        "छत्तीसगढ़",
        "मध्य प्रदेश"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "छत्तीसगढ़ का भूगोल",
      "topic": "खनिज संसाधन",
      "exam": "",
      "explanation_hi": "छत्तीसगढ़ पूरे देश में टिन का एकमात्र उत्पादक राज्य है। टिन का अयस्क 'कैसीटेराइट' (Cassiterite) दंतेवाड़ा और सुकमा जिलों में मिलता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989340-827-nx2f",
      "text_hi": "कैसीटेराइट' (Cassiterite) नामक खनिज किसका प्रमुख अयस्क है, जो मुख्य रूप से दण्डकारण्य क्षेत्र के कटेकल्याण और तोंगपाल में पाया जाता है?",
      "text_en": "",
      "options_hi": [
