      "options_en": [],
      "correctAnswer": 0,
      "subject": "हिन्दी व्याकरण",
      "topic": "समास",
      "exam": "",
      "explanation_hi": "आजीवन' (जीवन भर) में प्रथम पद अव्यय होने के कारण यह अव्ययीभाव समास है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989430-1140-5h1g",
      "text_hi": "राजकुमार' शब्द किस समास का उदाहरण है?",
      "text_en": "",
      "options_hi": [
        "तत्पुरुष समास",
        "अव्ययीभाव समास",
        "द्वन्द्व समास",
        "बहुव्रीहि समास"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "हिन्दी व्याकरण",
      "topic": "समास",
      "exam": "",
      "explanation_hi": "राजकुमार' का विग्रह 'राजा का कुमार' होता है, जो कि संबंध तत्पुरुष समास का उदाहरण है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989430-1141-nkw0",
      "text_hi": "दशानन' शब्द किस समास का उदाहरण है?",
      "text_en": "",
      "options_hi": [
        "द्विगु समास",
        "द्वन्द्व समास",
        "बहुव्रीहि समास",
        "कर्मधारय समास"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "हिन्दी व्याकरण",
      "topic": "समास",
      "exam": "",
      "explanation_hi": "दशानन' (दश + आनन) अर्थात् रावण का बोध कराता है, अतः यह बहुव्रीहि समास तथा योगरूढ़ शब्द है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989430-1142-h4x7",
      "text_hi": "पंकज' शब्द में कौन सा समास है?",
      "text_en": "",
      "options_hi": [
