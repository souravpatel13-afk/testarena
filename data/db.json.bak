      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "अहदी बहुत ही विश्वसनीय 'जेंटलमैन ट्रूपर्स' होते थे जिनकी भर्ती स्वयं सम्राट करता था और उनका वेतन बहुत अधिक होता था।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989202-343-4eme",
      "text_hi": "मुगल काल में उपज का बँटवारा करने की 'बटाई' (Batai) या 'गल्ला बख्शी' प्रणाली में राज्य का हिस्सा उपज के किस चरण पर लिया जाता था?",
      "text_en": "",
      "options_hi": [
        "खेत बोने से पहले",
        "खड़ी फसल पर",
        "फसल कटने और खलिहान में पहुंचने पर",
        "मंडी में बिकने पर"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "गल्ला बख्शी में फसल कटने के बाद खलिहान (Thrashing floor) में अनाज के ढेरों में से राज्य का हिस्सा (आमतौर पर एक-तिहाई) लिया जाता था।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989202-344-2kf7",
      "text_hi": "दिल्ली सल्तनत में सैनिकों और अमीरों को नकद वेतन के बजाय जमीन के लगान वसूलने का अधिकार दिया जाता था, इस व्यवस्था को क्या कहते थे?",
      "text_en": "",
      "options_hi": [
        "ज़ब्ती",
        "मनसबदारी",
        "जागीर",
        "इक्ता (Iqta)"
