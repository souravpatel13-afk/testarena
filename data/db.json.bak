      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "आधुनिक भारत",
      "exam": "",
      "explanation_hi": "बख्त खान एक सूबेदार थे जिन्होंने बरेली से आकर दिल्ली में विद्रोही सैनिकों की एक अदालत (Court) बनाई और वास्तविक रूप से सैन्य संचालन का कार्य संभाला।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989252-508-6kj4",
      "text_hi": "किस ब्रिटिश अधिनियम के माध्यम से भारत में पहली बार 'सिखों' के लिए भी 'पृथक निर्वाचक मंडल' (Separate Electorate) का विस्तार किया गया?",
      "text_en": "",
      "options_hi": [
