      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "हिन्दी व्याकरण",
      "topic": "समास",
      "exam": "",
      "explanation_hi": "राजारंक' का विग्रह 'राजा और रंक' होता है, जो कि द्वन्द्व समास का उदाहरण है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989429-1139-fdco",
      "text_hi": "आजीवन' शब्द में कौन सा समास है?",
      "text_en": "",
      "options_hi": [
