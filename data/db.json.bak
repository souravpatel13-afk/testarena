        "₹10 लाख से अधिक और ₹50 लाख तक"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बैंकिंग प्रणाली",
      "exam": "",
      "explanation_hi": "MUDRA (माइक्रो यूनिट्स डेवलपमेंट एंड रिफाइनेंस एजेंसी) योजना के तहत तीन श्रेणियों में संपार्श्विक-मुक्त (collateral-free) ऋण दिए जाते हैं: 1) शिशु: ₹50,000 तक, 2) किशोर: ₹50,000 से अधिक और ₹5 लाख तक, 3) तरुण: ₹5 लाख से अधिक और ₹10 लाख तक।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989512-1449-ew3i",
      "text_hi": "सार्वजनिक क्षेत्र के बैंकों (PSBs) के पुनर्पूंजीकरण के लिए जारी किए गए 'शून्य कूपन बांड' (Zero Coupon Bonds) की क्या विशेषता होती है?",
      "text_en": "",
      "options_hi": [
        "इन पर सबसे अधिक 15% का ब्याज मिलता है",
        "इन पर 0% ब्याज दर अंकित होती है, लेकिन इन्हें डिस्काउंट पर बेचा जाता है और परिपक्वता पर फेस वैल्यू पर वापस खरीदा जाता है",
        "ये केवल विदेशी निवेशकों के लिए जारी किए जाते हैं",
        "इन्हें केवल भुगतान बैंक खरीद सकते हैं"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बैंकिंग प्रणाली",
      "exam": "",
      "explanation_hi": "शून्य कूपन बांड' (Zero Coupon Bonds) पर 0% ब्याज दर (कूपन रेट) उल्लिखित होती है। सरकार या जारीकर्ता इन्हें 'डिस्काउंट' (छूट) पर जारी करता है और परिपक्वता (Maturity) पर इनके पूर्ण मूल्य (Face Value) पर वापस खरीदता है, और इन दोनों मूल्यों के बीच का अंतर ही निवेशक का लाभ होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989512-1450-gjzq",
      "text_hi": "ईज़' (EASE - Enhanced Access and Service Excellence) एजेंडा किस क्षेत्र में सुधार के लिए लाया गया था?",
      "text_en": "",
      "options_hi": [
        "कृषि क्षेत्र में उर्वरकों के वितरण के लिए",
        "शेयर बाजार में विदेशी निवेश (FDI) के नियमों को सरल बनाने के लिए",
        "सार्वजनिक क्षेत्र के बैंकों (PSBs) में सुशासन, जवाबदेही और ग्राहक सेवाओं में सुधार के लिए",
        "भारत की रक्षा खरीद प्रक्रिया को तेज करने के लिए"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बैंकिंग प्रणाली",
      "exam": "",
      "explanation_hi": "2018 में वित्त मंत्रालय के वित्तीय सेवा विभाग ने सार्वजनिक क्षेत्र के बैंकों (PSBs) को अधिक उत्तरदायी (Responsive) और जिम्मेदार बनाने के लिए 6-स्तंभों वाला 'EASE' (Enhanced Access and Service Excellence) ढांचा जारी किया था, जिसमें ग्राहक सेवा, सुशासन और गैर-निष्पादित संपत्तियों (NPA) में कमी लाना शामिल था।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989513-1451-lwl2",
      "text_hi": "अखिल भारतीय वित्तीय संस्थान (AIFI) के अंतर्गत निम्नलिखित में से कौन सी संस्था शामिल नहीं है?",
      "text_en": "",
      "options_hi": [
        "राष्ट्रीय कृषि और ग्रामीण विकास बैंक (NABARD)",
        "भारतीय लघु उद्योग विकास बैंक (SIDBI)",
        "भारतीय जीवन बीमा निगम (LIC)",
        "भारतीय निर्यात-आयात बैंक (EXIM)"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बैंकिंग प्रणाली",
      "exam": "",
      "explanation_hi": "अखिल भारतीय वित्तीय संस्थान (AIFI) संसद के विशेष अधिनियमों द्वारा स्थापित किए जाते हैं और विशिष्ट क्षेत्रों में ऋण/पुनर्वित्त प्रदान करते हैं। इसमें EXIM, NABARD, NHB और SIDBI शामिल हैं। LIC एक सार्वजनिक क्षेत्र की बीमा कंपनी है, AIFI नहीं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989513-1452-1yq9",
      "text_hi": "प्रच्छन्न या छिपी हुई बेरोजगारी' (Disguised Unemployment) का सटीक अर्थ क्या है?",
      "text_en": "",
      "options_hi": [
        "जब लोग अपनी इच्छा से काम नहीं करना चाहते",
        "जब एक व्यक्ति अपनी योग्यता से कम स्तर की नौकरी कर रहा हो",
        "जब श्रमिक स्पष्ट रूप से काम करते दिखते हैं लेकिन उनकी सीमांत उत्पादकता (Marginal Productivity) शून्य होती है",
        "जब अर्थव्यवस्था में मंदी के कारण छंटनी होती है"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बेरोजगारी और श्रम बाजार",
      "exam": "",
      "explanation_hi": "प्रच्छन्न बेरोजगारी का अर्थ है कि किसी कार्य में आवश्यकता से अधिक लोग लगे हुए हैं। यदि उनमें से कुछ लोगों को हटा भी दिया जाए, तो कुल उत्पादन पर कोई फर्क नहीं पड़ेगा। यह भारतीय कृषि क्षेत्र की सबसे बड़ी समस्या है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989513-1453-mi76",
      "text_hi": "यदि अर्थव्यवस्था में मंदी (Recession) के कारण कारों की बिक्री कम हो जाती है और मारुति जैसी कंपनी अपने 3000 कर्मचारियों को नौकरी से निकाल देती है, तो यह किस प्रकार की बेरोजगारी है?",
      "text_en": "",
      "options_hi": [
        "संरचनात्मक बेरोजगारी",
        "चक्रीय बेरोजगारी (Cyclical Unemployment)",
        "मौसमी बेरोजगारी",
        "प्रतिरोधात्मक बेरोजगारी"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बेरोजगारी और श्रम बाजार",
      "exam": "",
      "explanation_hi": "चक्रीय बेरोजगारी (Cyclical Unemployment) अर्थव्यवस्था में 'बूम-बस्ट' (तेजी और मंदी) चक्रों के कारण उत्पन्न होती है। जब अर्थव्यवस्था में मंदी आती है, तो मांग घट जाती है और कंपनियों को बड़े पैमाने पर अपने श्रमिकों की छंटनी करनी पड़ती है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989513-1454-1ocf",
      "text_hi": "जब कोई व्यक्ति अपनी पुरानी नौकरी छोड़कर नई नौकरी की तलाश कर रहा होता है, तो उस संक्रमण काल (Transition time) के दौरान वह किस प्रकार की बेरोजगारी का सामना करता है?",
      "text_en": "",
      "options_hi": [
        "प्रतिरोधात्मक बेरोजगारी (Frictional)",
        "अल्परोजगार (Underemployment)",
        "ऐच्छिक बेरोजगारी (Voluntary)",
        "संरचनात्मक बेरोजगारी (Structural)"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बेरोजगारी और श्रम बाजार",
      "exam": "",
      "explanation_hi": "प्रतिरोधात्मक या घर्षणात्मक बेरोजगारी (Frictional Unemployment) तब होती है जब कोई व्यक्ति एक नौकरी से बाहर होता है और दूसरी नई नौकरी की तलाश कर रहा होता है। यह नौकरी बदलने के बीच के समय की एक अस्थायी बेरोजगारी है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989514-1455-ul9a",
      "text_hi": "एक M.Tech डिग्री धारक युवक को अपनी योग्यता के अनुसार नौकरी नहीं मिलती और वह किसी बैंक में क्लर्क या फूड डिलीवरी बॉय के रूप में काम करता है। इसे अर्थशास्त्र में क्या कहा जाएगा?",
      "text_en": "",
      "options_hi": [
        "तकनीकी बेरोजगारी",
        "ऐच्छिक बेरोजगारी",
        "प्रच्छन्न बेरोजगारी",
        "अल्परोजगार या शिक्षित बेरोजगारी (Underemployment)"
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बेरोजगारी और श्रम बाजार",
      "exam": "",
      "explanation_hi": "अल्परोजगार (Underemployment) या शिक्षित बेरोजगारी तब होती है जब कोई व्यक्ति कार्यरत तो होता है, लेकिन उसे अपनी शैक्षणिक योग्यता या क्षमता के अनुरूप पद या वेतन नहीं मिल रहा होता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989514-1456-mp9w",
      "text_hi": "अर्थव्यवस्था में 'संरचनात्मक बेरोजगारी' (Structural / Open Unemployment) मुख्य रूप से किस कारण से उत्पन्न होती है?",
      "text_en": "",
      "options_hi": [
        "कृषि में मौसमी बदलाव के कारण",
        "जब बाजार में उपलब्ध नौकरियों और श्रमिकों के कौशल/योग्यता (Skills) के बीच भारी बेमेल (Mismatch) होता है",
        "जब श्रमिक काम करने के इच्छुक नहीं होते",
        "जब मशीनें पूरी तरह से खराब हो जाती हैं"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बेरोजगारी और श्रम बाजार",
      "exam": "",
      "explanation_hi": "संरचनात्मक बेरोजगारी तब होती है जब बाजार में नौकरियां तो उपलब्ध होती हैं, लेकिन श्रमिकों के पास उन नौकरियों को करने के लिए आवश्यक कौशल (Skills) नहीं होता है। उदाहरण के लिए- नौकरी 'पायथन' (Python) प्रोग्रामर की है, लेकिन उम्मीदवार केवल C++ जानता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989514-1457-6ka9",
      "text_hi": "राष्ट्रीय सांख्यिकी कार्यालय (NSO) द्वारा जारी 'आवधिक श्रम बल सर्वेक्षण' (PLFS) की शुरुआत किस वर्ष की गई थी?",
      "text_en": "",
      "options_hi": [
        "38108",
        "40878",
        "2017",
        "2020"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बेरोजगारी और श्रम बाजार",
      "exam": "",
      "explanation_hi": "NSO द्वारा पहले हर 5 साल में रोजगार सर्वेक्षण किया जाता था (अंतिम 2011-12 में हुआ था)। इसके बाद 2017 से सरकार ने इसे वार्षिक आधार पर मापने के लिए 'आवधिक श्रम बल सर्वेक्षण' (Periodic Labour Force Survey - PLFS) की शुरुआत की है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989514-1458-749e",
      "text_hi": "बेरोजगारी दर' (Unemployment Rate) की गणना का सही सूत्र क्या है?",
      "text_en": "",
      "options_hi": [
        "(कुल बेरोजगार व्यक्ति / देश की कुल जनसंख्या) × 100",
        "(अनैच्छिक बेरोजगारों की संख्या / श्रम बल) × 100",
        "(कुल रोजगार प्राप्त व्यक्ति / श्रम बल) × 100",
        "(कुल बेरोजगार व्यक्ति / कुल रोजगार प्राप्त व्यक्ति) × 100"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बेरोजगारी और श्रम बाजार",
      "exam": "",
      "explanation_hi": "बेरोजगारी दर निकालने के लिए केवल 'श्रम बल' (Labour Force) को ही आधार माना जाता है, कुल जनसंख्या को नहीं। श्रम बल में वे लोग आते हैं जो काम कर रहे हैं (Employed) और जो काम की तलाश में हैं (अनैच्छिक बेरोजगार)। सूत्र: (अनैच्छिक बेरोजगार / श्रम बल) × 100।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989515-1459-4v7h",
      "text_hi": "NSO के रोजगार सर्वेक्षण में 'वर्तमान साप्ताहिक स्थिति' (Current Weekly Status - CWS) के तहत किसी व्यक्ति को बेरोजगार कब माना जाता है?",
      "text_en": "",
      "options_hi": [
        "यदि वह पूरे एक वर्ष में 6 महीने काम नहीं करता।",
        "यदि वह दिए गए एक सप्ताह में 1 घंटे का भी रोजगार प्राप्त नहीं कर पाता है।",
        "यदि उसे पूरे एक महीने तक कोई काम नहीं मिलता।",
        "यदि वह अपनी इच्छा से एक सप्ताह तक काम पर नहीं जाता है।"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बेरोजगारी और श्रम बाजार",
      "exam": "",
      "explanation_hi": "NSO रोजगार मापने के लिए अलग-अलग पैमानों का उपयोग करता है। 'वर्तमान साप्ताहिक स्थिति' (CWS) के तहत यदि किसी व्यक्ति को संदर्भ सप्ताह (दिए गए सप्ताह) के दौरान 1 घंटे का भी रोजगार नहीं मिलता है, तो उसे बेरोजगार माना जाता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989516-1460-43yd",
      "text_hi": "भारत की जनगणना-2011 के वर्गीकरण के अनुसार, 'मुख्य श्रमिक' (Main Worker) वह व्यक्ति है जिसने एक वर्ष में कम से कम कितने दिन काम किया हो?",
      "text_en": "",
      "options_hi": [
        "100 दिन",
        "150 दिन",
        "183 दिन (6 महीने या उससे अधिक)",
        "270 दिन"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बेरोजगारी और श्रम बाजार",
      "exam": "",
      "explanation_hi": "जनगणना-2011 के अनुसार, श्रमिकों को दो भागों में बांटा गया है। 'मुख्य श्रमिक' (Main worker) वह है जिसने वर्ष में कम से कम 6 महीने (सटीक रूप से 183 दिन) या उससे अधिक काम किया हो। 6 महीने से कम काम करने वाले को 'सीमांत श्रमिक' (Marginal worker) कहते हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989516-1461-qoyt",
      "text_hi": "गिग वर्कर' (Gig Worker) के संबंध में निम्नलिखित में से कौन सा कथन सबसे सटीक है?",
      "text_en": "",
      "options_hi": [
        "ये कृषि क्षेत्र में काम करने वाले स्थायी मजदूर होते हैं।",
        "ये डिजिटल टेक्नोलॉजी से लैस दो-तरफा बाजार (जैसे- उबर, जोमैटो, अमेज़न) में काम करने वाले स्वतंत्र ठेकेदार/फ्रीलांसर होते हैं।",
        "ये सरकारी कारखानों में काम करने वाले पेंशनभोगी कर्मचारी होते हैं।",
        "ये बैंकिंग क्षेत्र के शीर्ष प्रबंधन अधिकारी होते हैं।"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बेरोजगारी और श्रम बाजार",
      "exam": "",
      "explanation_hi": "गिग वर्कर (Gig workers) डिजिटल प्लेटफॉर्म आधारित 'दो-तरफा बाजार' में काम करते हैं। कंपनी के रिकॉर्ड में इन्हें 'कर्मचारी' न मानकर 'स्वतंत्र सेवा प्रदाता/ठेकेदार' (Independent contractor) माना जाता है, इसलिए इन्हें सामान्यतः EPFO/ESIC जैसी सामाजिक सुरक्षा का लाभ नहीं मिलता।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989516-1462-5e5y",
      "text_hi": "अनौपचारिक मजदूर' (Informal Worker) के संबंध में कौन सा कथन सत्य है?",
      "text_en": "",
      "options_hi": [
        "वे केवल ग्रामीण कृषि क्षेत्रों में पाए जाते हैं।",
        "उनका कंपनी के साथ कोई औपचारिक अनुबंध नहीं होता और वे 'संगठित क्षेत्र' की कंपनियों में भी हो सकते हैं।",
        "उन्हें हमेशा भविष्य निधि (EPFO) का लाभ मिलता है।",
        "वे सरकार द्वारा निर्धारित न्यूनतम वेतन से अधिक कमाते हैं।"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बेरोजगारी और श्रम बाजार",
      "exam": "",
      "explanation_hi": "अनौपचारिक मजदूर (Informal worker) वह है जिसका कंपनी के साथ कोई औपचारिक अनुबंध (Formal Contract) नहीं होता। ये असंगठित क्षेत्र के साथ-साथ बड़ी 'संगठित क्षेत्र' की कंपनियों (जैसे किसी बड़ी कंपनी में ठेके पर रखा गया ड्राइवर या गार्ड) में भी कार्य कर सकते हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989516-1463-ci50",
      "text_hi": "आवधिक श्रम बल सर्वेक्षण (PLFS) के आंकड़ों के अनुसार, भारत में 'श्रमिकों की श्रेणी' (Types of workers) में सबसे अधिक संख्या किसकी है?",
      "text_en": "",
      "options_hi": [
        "नियमित वेतनभोगी कर्मचारी (Salaried Employees)",
        "स्व-रोजगारी (Own account workers / Self-employed)",
        "अनियत कर्मचारी (Casual workers)",
        "नियोक्ता (Employer)"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बेरोजगारी और श्रम बाजार",
      "exam": "",
      "explanation_hi": "PLFS डेटा के अनुसार, भारत में काम करने वालों में सबसे बड़ी संख्या 'स्व-रोजगारी' (Self-employed / Own account workers) की है। ये वे लोग हैं जो अपना खुद का काम करते हैं (जैसे- किसान, छोटे दुकानदार) और किसी अन्य को अपनी श्रम शक्ति 'वेतन' के लिए नहीं बेचते।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989517-1464-xu27",
      "text_hi": "अर्थशास्त्र में 'जनसांख्यिकीय लाभांश' (Demographic Dividend) की स्थिति कब प्राप्त होती है?",
      "text_en": "",
      "options_hi": [
        "जब देश में वृद्धों की आबादी बच्चों से अधिक हो जाए।",
        "जब देश की कुल जनसंख्या में 'कार्यशील आयु' (Working-age) वाले लोगों का हिस्सा 'आश्रित जनसंख्या' (Dependent) से अधिक हो जाता है।",
        "जब देश की कुल जनसंख्या वृद्धि दर शून्य हो जाए।",
        "जब महिला और पुरुष जनसंख्या का अनुपात एकदम बराबर हो जाए।"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बेरोजगारी और श्रम बाजार",
      "exam": "",
      "explanation_hi": "जनसांख्यिकीय लाभांश (Demographic dividend) तब होता है जब कार्यशील आयु वर्ग (15 से 59 वर्ष) की आबादी, आश्रित आबादी (15 वर्ष से कम और 65 वर्ष से अधिक) की तुलना में अधिक होती है। भारत की 65% से अधिक आबादी 35 वर्ष से कम आयु की है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989517-1465-jxs7",
      "text_hi": "फिलिप्स वक्र (Phillips Curve) के अनुसार, यदि सरकार मुद्रास्फीति (Inflation) को पूरी तरह से शून्य करने का प्रयास करती है, तो बेरोजगारी पर क्या प्रभाव पड़ेगा?",
      "text_en": "",
      "options_hi": [
        "बेरोजगारी कम हो जाएगी",
        "बेरोजगारी भी शून्य हो जाएगी",
        "बेरोजगारी में भारी वृद्धि होगी",
        "बेरोजगारी पर कोई प्रभाव नहीं पड़ेगा"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बेरोजगारी और श्रम बाजार",
      "exam": "",
      "explanation_hi": "फिलिप्स वक्र के अनुसार मुद्रास्फीति (Inflation) और बेरोजगारी (Unemployment) के बीच 'विपरीत' (Inverse) संबंध होता है। जब मुद्रास्फीति कम होती है (आर्थिक मंदी/मांग में कमी), तो उत्पादन गिरता है और कंपनियों को छंटनी करनी पड़ती है, जिससे बेरोजगारी बढ़ती है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989517-1466-3may",
      "text_hi": "भारत में 'महिला श्रम बल भागीदारी दर' (Female LFPR) में वर्ष 2004 से 2017 के बीच गिरावट दर्ज की गई। इसका एक प्रमुख कारण क्या नहीं है?",
      "text_en": "",
      "options_hi": [
        "कृषि और पशुपालन में मशीनीकरण का बढ़ना",
        "महिलाओं का उच्च शिक्षा (Higher studies) की ओर अग्रसर होना जिससे नौकरी में प्रवेश में देरी हुई",
        "शहरीकरण के कारण महिलाओं के लिए काम के अधिक और सुरक्षित अवसर उत्पन्न होना",
        "ग्रामीण पुरुषों की आय बढ़ने से उनकी पत्नियों का मजदूरी छोड़ केवल गृहिणी की भूमिका निभाना"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बेरोजगारी और श्रम बाजार",
      "exam": "",
      "explanation_hi": "भारत में महिला LFPR में गिरावट के कई कारण रहे हैं: उच्च शिक्षा में महिलाओं की वृद्धि, कृषि में मशीनीकरण, पुरुषों की आय बढ़ने से महिलाओं का मजदूरी छोड़ना, और सामाजिक/सांस्कृतिक बाधाएं। शहरीकरण से सुरक्षित अवसर बढ़ने चाहिए, लेकिन सामाजिक बंधनों के कारण यह LFPR बढ़ाने में पर्याप्त सफल नहीं रहा है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989517-1467-9ru4",
      "text_hi": "महात्मा गांधी राष्ट्रीय ग्रामीण रोजगार गारंटी अधिनियम (MGNREGA) के तहत रोजगार की प्रकृति क्या है?",
      "text_en": "",
      "options_hi": [
        "यह केवल कुशल (Skilled) श्रमिकों को तकनीकी रोजगार देता है।",
        "यह ग्रामीण परिवारों के वयस्क सदस्यों को वर्ष में 100 दिनों के 'अकुशल शारीरिक श्रम' (Unskilled manual work) की गारंटी देता है।",
        "यह केवल गरीबी रेखा से नीचे (BPL) के परिवारों के लिए आरक्षित है।",
        "यह केवल महिलाओं के लिए बनाया गया रोजगार कार्यक्रम है।"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बेरोजगारी और श्रम बाजार",
      "exam": "",
      "explanation_hi": "मनरेगा (MGNREGA) ग्रामीण क्षेत्रों में प्रत्येक उस परिवार के वयस्क सदस्यों को एक वित्तीय वर्ष में 100 दिनों के 'अकुशल शारीरिक श्रम' (Unskilled manual work) की कानूनी गारंटी देता है, जो काम करने के इच्छुक हैं। यह किसी विशेष जाति या केवल BPL तक सीमित नहीं है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989518-1468-u76g",
      "text_hi": "भारत में असंगठित क्षेत्र (Unorganized Sector) के श्रमिकों के संबंध में निम्नलिखित में से कौन सा कथन सही है?",
      "text_en": "",
      "options_hi": [
        "उन्हें अनिवार्य रूप से न्यूनतम वेतन (Minimum wages) और ईपीएफओ (EPFO) का लाभ मिलता है।",
        "देश में संगठित क्षेत्र की तुलना में असंगठित क्षेत्र में काम करने वाले श्रमिकों की संख्या अधिक है।",
        "उनका रोजगार वर्ष भर पूरी तरह से सुरक्षित रहता है।",
        "ये सभी श्रमिक अनिवार्य रूप से किसी ट्रेड यूनियन के सदस्य होते हैं।"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बेरोजगारी और श्रम बाजार",
      "exam": "",
      "explanation_hi": "भारत में संगठित क्षेत्र की तुलना में 'असंगठित क्षेत्र' (Unorganized sector) में काम करने वाले मजदूरों की संख्या बहुत अधिक है। असंगठित क्षेत्र की फर्में पंजीकृत नहीं होती हैं और इनके श्रमिकों को नौकरी की सुरक्षा, नियमित वेतन या ईपीएफओ जैसी सामाजिक सुरक्षा का लाभ नहीं मिलता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989518-1469-wxez",
      "text_hi": "निम्नलिखित में से किसे 'श्रम बल' (Labour Force) में शामिल नहीं किया जाता है?",
      "text_en": "",
      "options_hi": [
        "एक व्यक्ति जो पूर्णकालिक नौकरी कर रहा है।",
        "एक बेरोजगार युवा जो नौकरी की तलाश कर रहा है।",
        "एक गृहिणी जो घर का काम करती है और बाहर नौकरी की तलाश नहीं कर रही है।",
        "एक व्यक्ति जो हफ्ते में केवल 2 दिन कैजुअल लेबर का काम करता है।"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बेरोजगारी और श्रम बाजार",
      "exam": "",
      "explanation_hi": "श्रम बल' (Labour Force) में केवल वे लोग शामिल होते हैं जो या तो 'काम कर रहे हैं' (Employed) या 'अनैच्छिक रूप से बेरोजगार' हैं और काम की तलाश में हैं। जो लोग अपनी इच्छा से काम नहीं करना चाहते (जैसे गृहिणी या छात्र), वे श्रम बल का हिस्सा नहीं माने जाते।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989518-1470-a0k4",
      "text_hi": "यदि अर्थव्यवस्था में नई तकनीकों (जैसे- ऑटोमेशन या एआई) के आने से जो नौकरियां समाप्त होती हैं, उनकी तुलना में नई नौकरियों के सृजन के लिए श्रमिकों को फिर से प्रशिक्षित (Reskill) किया जाए, तो किस प्रकार की बेरोजगारी को रोका जा सकता है?",
      "text_en": "",
      "options_hi": [
        "चक्रीय बेरोजगारी",
        "मौसमी बेरोजगारी",
        "तकनीकी और संरचनात्मक बेरोजगारी",
        "प्रच्छन्न बेरोजगारी"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बेरोजगारी और श्रम बाजार",
      "exam": "",
      "explanation_hi": "नई तकनीकों के आने से मशीनें इंसानों की जगह ले लेती हैं, जिससे 'तकनीकी बेरोजगारी' आती है। यदि श्रमिकों के कौशल और नई तकनीक के बीच मेल नहीं होता, तो यह 'संरचनात्मक बेरोजगारी' बन जाती है। री-स्किलिंग (Re-skilling) के माध्यम से इन दोनों प्रकार की बेरोजगारी से निपटा जा सकता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989518-1471-g25x",
      "text_hi": "श्रम बल भागीदारी दर' (Labour Force Participation Rate - LFPR) का सूत्र क्या है?",
      "text_en": "",
      "options_hi": [
        "(कुल रोजगार प्राप्त लोग / कुल जनसंख्या) × 100",
        "(रोजगार प्राप्त लोग + अनैच्छिक रूप से बेरोजगार लोग) / देश की कुल जनसंख्या × 100",
        "(अनैच्छिक रूप से बेरोजगार लोग / कुल जनसंख्या) × 100",
        "(कुल रोजगार प्राप्त लोग / श्रम बल) × 100"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "बेरोजगारी और श्रम बाजार",
      "exam": "",
      "explanation_hi": "श्रम बल भागीदारी दर (LFPR) यह मापता है कि देश की कुल जनसंख्या में से कितने प्रतिशत लोग श्रम बल (Labour Force) का हिस्सा हैं। श्रम बल में रोजगार प्राप्त (Employed) और नौकरी की तलाश कर रहे अनैच्छिक बेरोजगार (Involuntarily unemployed) दोनों शामिल होते हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989519-1472-pok7",
      "text_hi": "राजकोषीय नीति' (Fiscal Policy) का प्रमुख उपकरण निम्नलिखित में से क्या है?",
      "text_en": "",
      "options_hi": [
        "रेपो रेट",
        "खुले बाजार की क्रियाएं",
        "कराधान (Taxation) और सार्वजनिक व्यय",
        "विदेशी मुद्रा भंडार"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "सार्वजनिक वित्त एवं कराधान",
      "exam": "",
      "explanation_hi": "राजकोषीय नीति (Fiscal Policy) सरकार के कराधान (taxation), व्यय और सब्सिडी से संबंधित निर्णयों का समूह है जो अर्थव्यवस्था को दिशा देती है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989519-1473-aejf",
      "text_hi": "भारत में आयकर (Income Tax) किस प्रकार के कर का उदाहरण है?",
      "text_en": "",
      "options_hi": [
        "प्रतिगामी कर (Regressive)",
        "प्रगामी कर (Progressive)",
        "आनुपातिक कर (Proportional)",
        "अप्रत्यक्ष कर (Indirect)"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "कराधान (Taxation)",
      "exam": "",
      "explanation_hi": "आयकर एक प्रगामी (Progressive) कर है, क्योंकि व्यक्ति की आय बढ़ने के साथ-साथ कर की दर भी बढ़ती है। इससे धन की असमानता कम होती है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989519-1474-52vk",
      "text_hi": "उपकर' (Cess) और 'अधिभार' (Surcharge) के बीच मुख्य अंतर क्या है?",
      "text_en": "",
      "options_hi": [
        "उपकर केवल राज्यों द्वारा लगाया जाता है",
        "अधिभार का एक विशिष्ट उद्देश्य होता है",
        "उपकर एक विशिष्ट उद्देश्य के लिए लगाया जाता है, जबकि अधिभार का कोई विशिष्ट पूर्व-निर्धारित उद्देश्य नहीं होता",
        "दोनों को राज्यों के साथ वित्त आयोग के फॉर्मूले से बांटा जाता है"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "कराधान (Taxation)",
      "exam": "",
      "explanation_hi": "उपकर (Cess) हमेशा किसी स्पष्ट उद्देश्य (जैसे कृषि कल्याण, स्वास्थ्य) के लिए लिया जाता है, जबकि अधिभार (Surcharge) 'कर के ऊपर कर' है जिसका कोई विशिष्ट उद्देश्य बताना अनिवार्य नहीं है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989519-1475-hp5h",
      "text_hi": "न्यूनतम वैकल्पिक कर' (MAT) मुख्य रूप से किस पर लगाया जाता है?",
      "text_en": "",
      "options_hi": [
        "कृषि आय पर",
        "शून्य लाभ (Zero Profit) दिखाने वाली कंपनियों पर",
        "केवल विदेशी निवेशकों पर",
        "शेयर बाजार के छोटे निवेशकों पर"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "कराधान (Taxation)",
      "exam": "",
      "explanation_hi": "MAT उन कंपनियों पर लगाया जाता है जो कर-छूट और लेखांकन (accounting) के तरीकों का उपयोग करके अपना लाभ शून्य दिखाती हैं और निगम कर (Corporation Tax) से बच जाती हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989520-1476-r768",
      "text_hi": "समकारी लेवी' (Equalisation Levy), जिसे आम बोलचाल में 'गूगल टैक्स' कहा जाता है, किस पर लागू होता है?",
      "text_en": "",
      "options_hi": [
        "भारत में बनने वाले स्मार्टफोन पर",
        "भारत में डिजिटल विज्ञापन और ई-कॉमर्स से लाभ कमाने वाली विदेशी कंपनियों पर",
        "विदेश जाने वाले भारतीय पर्यटकों पर",
        "भारतीय आईटी कंपनियों के सॉफ्टवेयर निर्यात पर"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "कराधान (Taxation)",
      "exam": "",
      "explanation_hi": "यह भारत में डिजिटल विज्ञापन (जैसे Google, Facebook) और ई-कॉमर्स सेवाओं से लाभ कमाने वाली विदेशी कंपनियों पर लगने वाला कर है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989520-1477-tsem",
      "text_hi": "संपत्ति, शेयर या आभूषण जैसी पूंजीगत संपत्तियों को लाभ पर बेचने पर कौन सा कर लगाया जाता है?",
      "text_en": "",
      "options_hi": [
        "वस्तु एवं सेवा कर (GST)",
        "निगम कर (Corporation Tax)",
        "पूंजीगत लाभ कर (Capital Gains Tax)",
        "लाभांश वितरण कर (DDT)"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "कराधान (Taxation)",
      "exam": "",
      "explanation_hi": "पूंजीगत लाभ कर (CGT) तब लगाया जाता है जब कोई संपत्ति का मालिक अपनी पूंजीगत संपत्ति (जैसे शेयर, जमीन, आभूषण) को लाभ पर बेचता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989520-1478-biwa",
      "text_hi": "कर अपवंचन (Tax Evasion) को रोकने के लिए 'स्रोत पर कर कटौती' (TDS) का मुख्य उद्देश्य क्या है?",
      "text_en": "",
      "options_hi": [
        "गरीबों को सब्सिडी देना",
        "भुगतान के समय ही कर का एक हिस्सा काट कर सरकार को जमा करना",
        "आयातित वस्तुओं पर सीमा शुल्क बढ़ाना",
        "कृषि उत्पादों पर कर लगाना"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "कराधान (Taxation)",
      "exam": "",
      "explanation_hi": "TDS के तहत भुगतानकर्ता भुगतान करते समय ही कर का एक हिस्सा काट कर आयकर विभाग को जमा कर देता है, जिससे कर चोरी पर अंकुश लगता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989520-1479-n4pr",
      "text_hi": "पिगोवियन कर' (Pigouvian Tax) का संबंध निम्नलिखित में से किससे है?",
      "text_en": "",
      "options_hi": [
        "केवल अमीर व्यक्तियों की संपत्ति पर कर",
        "प्रदूषण या तंबाकू जैसी नकारात्मक बाह्यताएं (Negative Externalities) उत्पन्न करने वाली गतिविधियों पर कर",
        "सभी प्रकार के विदेशी आयातों पर कर",
        "केवल कृषि आय पर कर"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "कराधान (Taxation)",
      "exam": "",
      "explanation_hi": "अर्थशास्त्री आर्थर सी. पिगौ के नाम पर यह कर उन गतिविधियों पर लगाया जाता है जो समाज पर नकारात्मक प्रभाव (प्रदूषण, स्वास्थ्य हानि) डालती हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989521-1480-q06p",
      "text_hi": "अप्रत्यक्ष करों के संदर्भ में 'कैस्केडिंग प्रभाव' (Cascading Effect) का क्या अर्थ है?",
      "text_en": "",
      "options_hi": [
        "करों की चोरी",
        "कर के ऊपर कर (Tax on Tax) लगने से वस्तुओं का महंगा होना",
        "करों में छूट मिलना",
        "करों का विदेशी मुद्रा में भुगतान"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "कराधान (Taxation)",
      "exam": "",
      "explanation_hi": "कैस्केडिंग प्रभाव तब होता है जब आपूर्ति श्रृंखला में हर स्तर पर कर लगता है और पुराने कर पर भी नया कर लग जाता है, जिससे वस्तुएं महंगी हो जाती हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989521-1481-cg0a",
      "text_hi": "वस्तु एवं सेवा कर (GST) को लागू करने के लिए भारतीय संविधान में कौन सा संशोधन किया गया था?",
      "text_en": "",
      "options_hi": [
        "100वां संशोधन अधिनियम",
        "101वां संशोधन अधिनियम",
        "102वां संशोधन अधिनियम",
        "103वां संशोधन अधिनियम"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "कराधान (Taxation)",
      "exam": "",
      "explanation_hi": "101वें संवैधानिक संशोधन अधिनियम, 2016 के माध्यम से भारत में GST व्यवस्था लागू की गई, जिसने केंद्र और राज्यों के कई अप्रत्यक्ष करों को एक में मिला दिया।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989521-1482-l4hs",
      "text_hi": "संविधान के अनुच्छेद 279-A के तहत गठित 'GST परिषद' (GST Council) का अध्यक्ष कौन होता है?",
      "text_en": "",
      "options_hi": [
        "प्रधानमंत्री",
        "भारतीय रिज़र्व बैंक के गवर्नर",
        "केंद्रीय वित्त मंत्री",
        "नीति आयोग के उपाध्यक्ष"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "कराधान (Taxation)",
      "exam": "",
      "explanation_hi": "GST परिषद एक संवैधानिक निकाय है, जिसकी अध्यक्षता केंद्रीय वित्त मंत्री करते हैं। इसमें सभी राज्यों के प्रतिनिधि शामिल होते हैं जो कर की दरों पर निर्णय लेते हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989522-1483-pqhz",
      "text_hi": "निम्नलिखित में से किस वस्तु को GST के दायरे से पूरी तरह बाहर रखा गया है (अर्थात इस पर राज्य उत्पाद शुल्क और वैट लगता है)?",
      "text_en": "",
      "options_hi": [
        "स्वर्ण और आभूषण",
        "मानव उपभोग के लिए शराब (Alcoholic liquor)",
        "प्रसंस्कृत खाद्य पदार्थ",
        "मोबाइल फोन"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "कराधान (Taxation)",
      "exam": "",
      "explanation_hi": "संविधान के अनुसार 'मानव उपभोग के लिए शराब' को GST से बाहर रखा गया है। इस पर राज्य सरकारें अपना उत्पाद शुल्क (State Excise) और वैट (VAT) लगाती हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989522-1484-4c0e",
      "text_hi": "निम्नलिखित में से कौन सा कर (Tax) GST में शामिल (Subsumed) नहीं किया गया है?",
      "text_en": "",
      "options_hi": [
        "केंद्रीय उत्पाद शुल्क (Central Excise Duty)",
        "सेवा कर (Service Tax)",
        "राज्यों का वैट (State VAT)",
        "सीमा शुल्क (Customs Duty)"
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "कराधान (Taxation)",
      "exam": "",
      "explanation_hi": "GST केवल अप्रत्यक्ष करों को प्रतिस्थापित करता है, लेकिन आयात-निर्यात पर लगने वाला सीमा शुल्क (Customs Duty) GST में शामिल नहीं है; आयातित वस्तुओं पर सीमा शुल्क के साथ IGST लगता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989522-1485-lpny",
      "text_hi": "GST प्रणाली में 'इनपुट टैक्स क्रेडिट' (ITC) का क्या लाभ है?",
      "text_en": "",
      "options_hi": [
        "यह कैस्केडिंग प्रभाव (कर पर कर) को समाप्त करता है",
        "यह केवल निर्यातकों को दिया जाने वाला नकद अनुदान है",
        "यह आयकर (Income Tax) में छूट देता है",
        "यह बैंक ऋणों पर ब्याज कम करता है"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "कराधान (Taxation)",
      "exam": "",
      "explanation_hi": "ITC के तहत एक व्यवसायी अपने कच्चे माल की खरीद पर पहले ही चुकाए गए कर का 'क्रेडिट' प्राप्त कर सकता है, जिससे कर पर कर (Cascading effect) की समस्या समाप्त होती है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989522-1486-q9al",
      "text_hi": "GST क्षतिपूर्ति उपकर' (GST Compensation Cess) किस उद्देश्य से लगाया गया था?",
      "text_en": "",
      "options_hi": [
        "केंद्र सरकार का राजकोषीय घाटा कम करने के लिए",
        "GST लागू होने से राज्यों को होने वाले राजस्व नुकसान की 5 वर्षों तक भरपाई करने के लिए",
        "किसानों को न्यूनतम समर्थन मूल्य देने के लिए",
        "विदेशी कर्ज चुकाने के लिए"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "कराधान (Taxation)",
      "exam": "",
      "explanation_hi": "GST क्षतिपूर्ति अधिनियम 2017 के तहत लागू की गई, ताकि नई गंतव्य-आधारित GST व्यवस्था के कारण विनिर्माण करने वाले राज्यों के राजस्व नुकसान की 5 वर्षों तक भरपाई की जा सके।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989523-1487-pf3y",
      "text_hi": "राष्ट्रीय मुनाफाखोरी निरोधक प्राधिकरण' (NAA) का गठन क्यों किया गया है?",
      "text_en": "",
      "options_hi": [
        "बैंकों के NPA वसूलने के लिए",
        "यह सुनिश्चित करने के लिए कि GST दरों में कमी या ITC का लाभ कंपनियों द्वारा उपभोक्ताओं को दिया जाए",
        "आयकर दाताओं की जांच करने के लिए",
        "शेयर बाजार के घोटालों को रोकने के लिए"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय अर्थव्यवस्था",
      "topic": "कराधान (Taxation)",
      "exam": "",
      "explanation_hi": "NAA यह सुनिश्चित करता है कि जब GST दरें घटें या इनपुट क्रेडिट मिले, तो उत्पादक/विक्रेता अपनी वस्तुओं की कीमतें घटाकर इसका लाभ आम ग्राहकों (Consumers) तक पहुंचाएं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989523-1488-rj1l",
      "text_hi": "15वें वित्त आयोग (एन.के. सिंह समिति) ने केंद्रीय करों के विभाज्य पूल (Divisible Pool) में से राज्यों को कितने प्रतिशत हिस्सा देने की सिफारिश की है?",
      "text_en": "",
      "options_hi": [
        "0.32",
        "0.42",
        "0.41",
        "0.5"
      ],
      "options_en": [],
