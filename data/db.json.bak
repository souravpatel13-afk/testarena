    {
      "id": "q-sheet-1785335989238-462-ffb6",
      "text_hi": "भारत में 'सिविल सेवा का जनक' (Father of Civil Services in India) किसे माना जाता है?",
      "text_en": "",
      "options_hi": [
        "वारेन हेस्टिंग्स",
        "लॉर्ड वेलेज़ली",
        "लॉर्ड कॉर्नवालिस",
        "लॉर्ड डलहौजी"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "आधुनिक भारत",
      "exam": "",
      "explanation_hi": "लॉर्ड कॉर्नवालिस ने भारत में सिविल सेवा का यूरोपीयकरण किया और इसे संगठित तथा भ्रष्टाचार मुक्त बनाने के लिए कड़े नियम लागू किए, इसलिए उन्हें इसका जनक माना जाता है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989239-463-vowe",
      "text_hi": "भारत के प्राचीन इतिहास और संस्कृति के अध्ययन के लिए 1784 में बंगाल में 'एशियाटिक सोसाइटी' (Asiatic Society) की स्थापना किसने की थी?",
      "text_en": "",
      "options_hi": [
        "जेम्स प्रिंसेप",
        "मैक्स मूलर",
        "सर विलियम जोंस",
        "चार्ल्स विल्किंस"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "आधुनिक भारत",
      "exam": "",
      "explanation_hi": "कलकत्ता सुप्रीम कोर्ट के न्यायाधीश और प्राच्यविद् सर विलियम जोंस ने 1784 में वारेन हेस्टिंग्स के समय भारतीय साहित्य और संस्कृति के शोध हेतु इस संस्था की स्थापना की थी।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989239-464-gnuv",
      "text_hi": "किस अधिनियम के माध्यम से ब्रिटिश सरकार ने ईस्ट इंडिया कंपनी के वाणिज्यिक (Commercial) और राजनीतिक (Political) कार्यों को अलग-अलग कर दिया?",
      "text_en": "",
      "options_hi": [
        "रेग्युलेटिंग एक्ट 1773",
        "पिट्स इंडिया एक्ट 1784",
        "चार्टर एक्ट 1813",
        "चार्टर एक्ट 1833"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "आधुनिक भारत",
      "exam": "",
      "explanation_hi": "पिट्स इंडिया एक्ट (1784) के तहत राजनीतिक मामलों के लिए 'बोर्ड ऑफ कंट्रोल' और व्यापारिक मामलों के लिए 'कोर्ट ऑफ डायरेक्टर्स' की व्यवस्था कर द्वैध नियंत्रण स्थापित किया गया।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989239-465-v7ca",
      "text_hi": "19वीं शताब्दी में पंजाब में 'कूका आंदोलन' (Kuka Movement) को मुख्य रूप से किसने संगठित किया था, जिसका उद्देश्य सिख धर्म में सुधार और अंग्रेजों को बाहर निकालना था?",
      "text_en": "",
      "options_hi": [
        "गुरु राम दास",
        "रणजीत सिंह",
        "बाबा राम सिंह",
        "गुरु गोविंद सिंह"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "आधुनिक भारत",
      "exam": "",
      "explanation_hi": "नामधारी संप्रदाय (कूका) के नेता बाबा राम सिंह ने पंजाब में इस सामाजिक-धार्मिक और राजनीतिक आंदोलन का नेतृत्व किया, जिन्हें बाद में अंग्रेजों ने रंगून निर्वासित कर दिया था।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989240-466-y44i",
      "text_hi": "भारतीय राष्ट्रीय कांग्रेस की अध्यक्ष बनने वाली 'पहली भारतीय महिला' (First Indian Woman President) कौन थीं?",
      "text_en": "",
      "options_hi": [
        "एनी बेसेंट",
        "सरोजिनी नायडू",
        "सुचेता कृपलानी",
        "अरुणा आसफ़ अली"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "आधुनिक भारत",
      "exam": "",
      "explanation_hi": "सरोजिनी नायडू 1925 में कांग्रेस के कानपुर अधिवेशन की अध्यक्ष बनीं। (ध्यान दें: पहली महिला अध्यक्ष एनी बेसेंट थीं, लेकिन पहली 'भारतीय' महिला सरोजिनी नायडू थीं)।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989240-467-ausl",
      "text_hi": "भारत में प्रकाशित होने वाला पहला समाचार पत्र (First Newspaper) कौन सा था, जिसे 1780 में शुरू किया गया था?",
      "text_en": "",
      "options_hi": [
        "द हिंदू",
        "बंगाल गज़ट (Bengal Gazette)",
        "मिरत-उल-अखबार",
        "बॉम्बे क्रॉनिकल"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "आधुनिक भारत",
      "exam": "",
      "explanation_hi": "जेम्स ऑगस्टस हिक्की ने 1780 में 'कलकत्ता जनरल एडवरटाइजर' या 'बंगाल गज़ट' नामक पहला अंग्रेजी समाचार पत्र शुरू किया था।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989240-468-bid3",
      "text_hi": "1882 में किस वायसराय ने लॉर्ड लिटन द्वारा लागू किए गए 'वर्नाक्यूलर प्रेस एक्ट' (Vernacular Press Act) को रद्द कर दिया था?",
      "text_en": "",
      "options_hi": [
        "लॉर्ड डफरिन",
        "लॉर्ड कर्ज़न",
        "लॉर्ड रिपन",
        "लॉर्ड लैंसडाउन"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "आधुनिक भारत",
      "exam": "",
      "explanation_hi": "लॉर्ड रिपन, जिन्हें भारत में एक उदार वायसराय माना जाता था, ने 1882 में इस विवादित कानून को निरस्त कर देशी भाषाओं के अखबारों को अंग्रेजी अखबारों के समान स्वतंत्रता दी।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989241-469-yujv",
      "text_hi": "1839 में राजा राममोहन रॉय के विचारों का प्रचार करने के लिए 'तत्वबोधिनी सभा' (Tattvabodhini Sabha) की स्थापना किसने की थी?",
      "text_en": "",
      "options_hi": [
        "केशव चंद्र सेन",
        "ईश्वर चंद्र विद्यासागर",
        "देवेंद्रनाथ टैगोर",
        "रवींद्रनाथ टैगोर"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "आधुनिक भारत",
      "exam": "",
      "explanation_hi": "रवींद्रनाथ टैगोर के पिता देवेंद्रनाथ टैगोर ने बंगाली युवाओं में उपनिषदों के ज्ञान और ब्रह्म समाज के दर्शन को फैलाने के लिए यह सभा स्थापित की थी।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989241-470-8gce",
      "text_hi": "1917 में चंपारण के नील किसानों की दुर्दशा की ओर महात्मा गांधी का ध्यान आकर्षित करने और उन्हें वहाँ ले जाने का श्रेय किस किसान नेता को जाता है?",
      "text_en": "",
      "options_hi": [
        "राजेंद्र प्रसाद",
        "राजकुमार शुक्ल",
        "जे. बी. कृपलानी",
        "अनुग्रह नारायण सिन्हा"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "आधुनिक भारत",
      "exam": "",
      "explanation_hi": "राजकुमार शुक्ल 1916 के लखनऊ अधिवेशन में गांधीजी से मिले थे और उनके प्रबल आग्रह पर ही गांधीजी ने तिनकठिया प्रथा के खिलाफ चंपारण सत्याग्रह किया।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989241-471-itci",
      "text_hi": "1919 के 'जलियांवाला बाग हत्याकांड' के समय भारत का वायसराय कौन था?",
      "text_en": "",
      "options_hi": [
        "लॉर्ड मिंटो",
        "लॉर्ड चेम्सफोर्ड",
        "लॉर्ड इरविन",
        "लॉर्ड रीडिंग"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "आधुनिक भारत",
      "exam": "",
      "explanation_hi": "1916 से 1921 तक लॉर्ड चेम्सफोर्ड भारत के वायसराय थे; इन्हीं के कार्यकाल में रॉलेट एक्ट, जलियांवाला बाग हत्याकांड और असहयोग आंदोलन शुरू हुए थे।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989241-472-5dji",
      "text_hi": "भारत में पहली रेलवे लाइन 1853 में बंबई (बोरीबंदर) से ठाणे के बीच किस गवर्नर-जनरल के कार्यकाल में बिछाई गई थी?",
      "text_en": "",
      "options_hi": [
        "लॉर्ड कैनिंग",
        "लॉर्ड हार्डिंग",
        "लॉर्ड डलहौजी",
        "लॉर्ड कॉर्नवालिस"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "आधुनिक भारत",
      "exam": "",
      "explanation_hi": "लॉर्ड डलहौजी को भारत में रेलवे का जनक माना जाता है; सामरिक और वाणिज्यिक उद्देश्यों के लिए 1853 में यह 34 किमी लंबी पहली ट्रेन चलाई गई थी।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989242-473-dw0e",
      "text_hi": "लॉर्ड वेलेज़ली की 'सहायक संधि' (Subsidiary Alliance) को स्वीकार करने वाला भारत का पहला देशी राज्य कौन सा था?",
      "text_en": "",
      "options_hi": [
        "अवध",
        "मैसूर",
        "मराठा",
        "हैदराबाद"
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "भारतीय इतिहास",
      "topic": "आधुनिक भारत",
      "exam": "",
      "explanation_hi": "हैदराबाद के निज़ाम ने फ्रांसीसी खतरे और मराठों के डर से 1798 में सबसे पहले अंग्रेजों की सहायक संधि स्वीकार की थी।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989242-474-jtts",
      "text_hi": "1857 के स्वतंत्रता संग्राम (सिपाही विद्रोह) के गुप्त संदेश के रूप में क्रांतिकारियों ने किस प्रतीक (Symbol) का प्रयोग किया था?",
      "text_en": "",
      "options_hi": [
        "तलवार और ढाल",
        "कमल का फूल और रोटी (चपाती)",
        "लाल झंडा",
        "बंदूक और तीर"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "आधुनिक भारत",
      "exam": "",
      "explanation_hi": "विद्रोह का संदेश एक गाँव से दूसरे गाँव और एक छावनी से दूसरी छावनी तक पहुँचाने के लिए कमल के फूल और रोटियों का प्रतीक के रूप में उपयोग किया गया था।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989242-475-65v8",
      "text_hi": "1857 के विद्रोह के दौरान बिहार (विशेषकर जगदीशपुर) में ब्रिटिश सेना के खिलाफ विद्रोह का नेतृत्व किसने किया था?",
      "text_en": "",
      "options_hi": [
        "खान बहादुर खान",
        "लियाकत अली",
        "बाबू कुंवर सिंह",
        "बख्त खान"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "आधुनिक भारत",
      "exam": "",
      "explanation_hi": "80 वर्षीय जमींदार बाबू कुंवर सिंह ने जगदीशपुर (आरा) में विद्रोहियों का सफल नेतृत्व किया और अपनी मृत्यु तक अंग्रेजों के खिलाफ अजेय रहे।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989242-476-tfwy",
      "text_hi": "1911 में जब दिल्ली दरबार में भारत की राजधानी कलकत्ता से दिल्ली स्थानांतरित करने की घोषणा की गई, तब वायसराय कौन था?",
      "text_en": "",
      "options_hi": [
        "लॉर्ड मिंटो",
        "लॉर्ड हार्डिंग द्वितीय (Lord Hardinge II)",
        "लॉर्ड कर्ज़न",
        "लॉर्ड रीडिंग"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "आधुनिक भारत",
      "exam": "",
      "explanation_hi": "लॉर्ड हार्डिंग द्वितीय के समय दिसंबर 1911 में जॉर्ज पंचम भारत आए थे और दिल्ली दरबार में बंगाल विभाजन रद्द करने तथा नई राजधानी की घोषणा हुई थी।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989243-477-mh8m",
      "text_hi": "भारतीय स्वतंत्रता संग्राम पर आधारित प्रसिद्ध पुस्तक 'इंडिया विंस फ्रीडम' (India Wins Freedom) के लेखक कौन हैं?",
      "text_en": "",
      "options_hi": [
        "जवाहरलाल नेहरू",
        "महात्मा गांधी",
        "सुभाष चंद्र बोस",
        "मौलाना अबुल कलाम आज़ाद"
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "भारतीय इतिहास",
      "topic": "आधुनिक भारत",
      "exam": "",
      "explanation_hi": "स्वतंत्र भारत के पहले शिक्षा मंत्री मौलाना अबुल कलाम आज़ाद ने इस आत्मकथात्मक पुस्तक में स्वतंत्रता आंदोलन और विभाजन के दर्द का स्पष्ट वर्णन किया है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989243-478-k6k5",
      "text_hi": "1946 में भारत आए 'कैबिनेट मिशन' (Cabinet Mission) में तीन ब्रिटिश कैबिनेट मंत्री शामिल थे। इनमें से कौन उसका सदस्य नहीं था?",
      "text_en": "",
      "options_hi": [
        "लॉर्ड पैथिक लॉरेंस",
        "सर स्टैफोर्ड क्रिप्स",
        "लॉर्ड वेवेल (Lord Wavell)",
        "ए. वी. अलेक्जेंडर"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "आधुनिक भारत",
      "exam": "",
      "explanation_hi": "कैबिनेट मिशन में केवल तीन सदस्य थे- पैथिक लॉरेंस (भारत सचिव), स्टैफोर्ड क्रिप्स और ए.वी. अलेक्जेंडर। लॉर्ड वेवेल उस समय भारत के वायसराय थे, मिशन के सदस्य नहीं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989243-479-zilh",
      "text_hi": "9 दिसंबर 1946 को संविधान सभा (Constituent Assembly) की पहली बैठक में 'अस्थायी अध्यक्ष' (Temporary President) के रूप में किसे चुना गया था?",
      "text_en": "",
      "options_hi": [
        "डॉ. राजेंद्र प्रसाद",
        "बी. एन. राव",
        "डॉ. सच्चिदानंद सिन्हा",
        "डॉ. बी. आर. अंबेडकर"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "आधुनिक भारत",
      "exam": "",
      "explanation_hi": "फ्रांसीसी परंपरा का पालन करते हुए संविधान सभा के सबसे वयोवृद्ध सदस्य डॉ. सच्चिदानंद सिन्हा को अस्थायी अध्यक्ष चुना गया था। 11 दिसंबर को डॉ. राजेंद्र प्रसाद स्थायी अध्यक्ष बने।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989244-480-2tga",
      "text_hi": "मोहनदास करमचंद गांधी को 'महात्मा' (Mahatma) की उपाधि सबसे पहले किसने प्रदान की थी?",
      "text_en": "",
      "options_hi": [
        "सुभाष चंद्र बोस",
        "गोपाल कृष्ण गोखले",
        "रवींद्रनाथ टैगोर",
        "विंस्टन चर्चिल"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
