    },
    {
      "id": "q-sheet-1785335989384-970-dbh4",
      "text_hi": "निम्नलिखित को सुमेलित कीजिए- कॉलम-I (विकास की अवस्था) कॉलम-II (मुख्य विशेषता)। (a) शैशवावस्था (0-2 वर्ष) (b) पूर्व बाल्यावस्था (2-6 वर्ष) (c) उत्तर बाल्यावस्था (6-12 वर्ष) (d) किशोरावस्था (12-18 वर्ष)। (i) इन्द्रियों से सीखना (Senses are teachers) (ii) टोली/समूह आयु (Gang age) (iii) अमूर्त चिंतन व नायक पूजा (Hero worship) (iv) नकल व अनुकरण (Imitative age)।",
      "text_en": "",
      "options_hi": [
        "a-ii, b-i, c-iv, d-iii",
        "a-i, b-iv, c-ii, d-iii",
        "a-iv, b-iii, c-i, d-ii",
        "a-i, b-ii, c-iii, d-iv"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "बाल विकास एवं शिक्षा शास्त्र",
      "topic": "विकास की अवस्थाएं एवं विशेषताएँ",
      "exam": "",
      "explanation_hi": "शैशवावस्था में बालक इन्द्रियों (Senses) से सीखता है। पूर्व बाल्यावस्था नकल/अनुकरण (Imitative) की अवस्था है। उत्तर बाल्यावस्था टोली (Gang) बनाने की अवस्था है। किशोरावस्था में अमूर्त चिंतन व नायक पूजा (Hero worship) की भावना प्रबल होती है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989384-971-jpmb",
      "text_hi": "निर्देश - नीचे दिए गए कथन [A] और कारण [R] के लिए सही विकल्प चुनिए। कथन [A]: उत्तर बाल्यावस्था (6-12 वर्ष) को सिगमंड फ्रायड ने 'सुप्त अवस्था' (Latency Stage) कहा है। कारण [R]: इस अवस्था में बालक का शारीरिक विकास शैशवावस्था की तुलना में अत्यंत तीव्र (Fastest) हो जाता है।",
      "text_en": "",
