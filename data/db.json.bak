      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "हिन्दी व्याकरण",
      "topic": "सर्वनाम",
      "exam": "",
      "explanation_hi": "बोलने वाले वक्ता को उत्तम पुरुष कहते हैं (जैसे- मैं, हम)।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989416-1093-gin4",
      "text_hi": "कोई' और 'कुछ' किस प्रकार के सर्वनाम हैं?",
