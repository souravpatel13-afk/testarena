        "मीर सामान",
        "काज़ी"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "मीर बख्शी सेना की भर्ती, वेतन और मनसबदारों की सिफारिशों के लिए जिम्मेदार था और उसे अमीरों का प्रमुख माना जाता था। [81]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989173-238-nxls",
      "text_hi": "अहमदनगर की रक्षा के लिए मुगलों (अकबर की सेना) के विरुद्ध बहादुरी से लड़ने वाली महिला शासिका कौन थीं?",
      "text_en": "",
      "options_hi": [
        "रज़िया सुल्तान",
        "चांद बीबी",
        "रानी दुर्गावती",
        "जीजाबाई"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "चांद बीबी ने 1595-96 में मुगलों (राजकुमार मुराद) की घेराबंदी के दौरान अहमदनगर के किले की डटकर रक्षा की थी। [82, 83]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989174-239-0pa2",
      "text_hi": "दक्कन में मुगलों के विस्तार को रोकने के लिए 'मलिक अंबर' (Malik Ambar) ने किस राज्य में छापामार युद्ध प्रणाली को सफलता से लागू किया?",
      "text_en": "",
      "options_hi": [
        "बीजापुर",
        "गोलकुंडा",
        "अहमदनगर",
        "खानदेश"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "मलिक अंबर एक हब्शी (Abyssinian) था जिसने अहमदनगर को पुनर्जीवित किया और मराठा सैनिकों (Bargis) की मदद से मुगलों को रोके रखा। [84, 85]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989174-240-slq8",
      "text_hi": "जहांगीर के शासनकाल में 1613 में किस राजपूत राज्य के साथ मुगलों का लंबा संघर्ष समाप्त हुआ और शांति समझौता हुआ?",
      "text_en": "",
      "options_hi": [
        "मारवाड़",
        "मेवाड़",
        "आमेर",
        "बीकानेर"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "जहांगीर के समय राजकुमार खुर्रम के अभियान के बाद मेवाड़ के राणा अमर सिंह ने मुगलों की अधीनता स्वीकार कर ली। [86, 87]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989174-241-pewq",
      "text_hi": "जहांगीर द्वारा मनसबदारी व्यवस्था में शुरू की गई 'दु-अस्पा सिह-अस्पा' प्रणाली का क्या अर्थ था?",
      "text_en": "",
      "options_hi": [
        "ज़ात रैंक को बढ़ाना",
