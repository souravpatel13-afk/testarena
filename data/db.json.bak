          "stage": "प्रश्न पत्र - I: सामान्य अध्ययन (GS Paper 1)",
          "duration": "2 घंटे (120 मिनट)",
          "totalQuestions": "100 प्रश्न",
          "totalMarks": "200 अंक",
          "negativeMarking": "1/3 नकारात्मक अंकन (-0.66 अंक)"
