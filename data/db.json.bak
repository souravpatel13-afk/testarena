    },
    {
      "id": "q-sheet-1785335989403-1047-fekl",
      "text_hi": "सुमेलित कीजिए- (a) तैराक (b) घबराहट (c) बुढ़ापा (d) मिठास :: (i) आहट (ii) आस (iii) आक (iv) आपा (प्रत्यय)",
      "text_en": "",
