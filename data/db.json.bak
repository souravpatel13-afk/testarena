    {
      "id": "q-sheet-1785335989573-1661-e33c",
      "text_hi": "अद्वैत वेदांत (Non-dualism) के प्रतिपादक कौन माने जाते हैं?",
      "text_en": "",
      "options_hi": [
        "रामानुजाचार्य",
        "माधवाचार्य",
        "शंकराचार्य",
        "वल्लभाचार्य"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "प्राचीन भारत",
      "exam": "",
      "explanation_hi": "8वीं सदी में शंकराचार्य ने अद्वैत दर्शन दिया और चार दिशाओं में चार मठ स्थापित किए।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989573-1662-b4jc",
      "text_hi": "कामसूत्र' के रचयिता कौन हैं?",
      "text_en": "",
      "options_hi": [
        "चरक",
        "सुश्रुत",
        "वात्स्यायन",
        "पतंजलि"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "प्राचीन भारत",
      "exam": "",
      "explanation_hi": "वात्स्यायन प्राचीन भारत के एक महान ऋषि थे जिन्होंने इसकी रचना की थी।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989573-1663-zb0l",
      "text_hi": "आठवीं शताब्दी के मध्य (लगभग 750 ई.) में पाल वंश की स्थापना किसने की थी?",
      "text_en": "",
      "options_hi": [
        "धर्मपाल",
        "देवपाल",
        "गोपाल",
        "रामपाल"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "पाल वंश की स्थापना 750 ई. में गोपाल द्वारा की गई थी, जिसे क्षेत्र में व्याप्त अराजकता को समाप्त करने के लिए प्रमुख लोगों ने चुना था। [1]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989573-1664-0f6c",
      "text_hi": "प्रसिद्ध विक्रमशिला विश्वविद्यालय की स्थापना किस पाल शासक द्वारा की गई थी?",
      "text_en": "",
      "options_hi": [
        "गोपाल",
        "धर्मपाल",
        "देवपाल",
        "महिपाल"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "पाल शासक धर्मपाल ने मगध में गंगा नदी के तट पर विक्रमशिला विश्वविद्यालय की स्थापना की थी जो बौद्ध शिक्षा का प्रमुख केंद्र बना। [2]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989573-1665-vjly",
      "text_hi": "किस राष्ट्रकूट शासक ने कन्नौज पर अधिकार के लिए प्रतिहारों और पालों दोनों को पराजित किया था?",
      "text_en": "",
      "options_hi": [
        "दंतिदुर्ग",
        "अमोघवर्ष",
        "कृष्ण प्रथम",
        "ध्रुव"
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "राष्ट्रकूट शासक ध्रुव ने उत्तर भारत में अभियान कर प्रतिहार और पाल शासकों को हराया, जिसके बाद वह वापस दक्कन लौट गया। [1]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989574-1666-on8s",
      "text_hi": "राष्ट्रकूट साम्राज्य की स्थापना किसने की थी?",
      "text_en": "",
      "options_hi": [
        "दंतिदुर्ग",
        "कृष्ण प्रथम",
        "गोविंद तृतीय",
        "इंद्र तृतीय"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "दंतिदुर्ग ने राष्ट्रकूट साम्राज्य की स्थापना की और मान्यखेत (मल्खेड़) को अपनी राजधानी बनाया था। [3]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989574-1667-satx",
      "text_hi": "अरब यात्री सुलेमान ने 9वीं शताब्दी के मध्य में भारत की यात्रा की, उसने किस साम्राज्य को 'रुहमा' (Ruhma) कहा था?",
      "text_en": "",
      "options_hi": [
        "प्रतिहार साम्राज्य",
        "पाल साम्राज्य",
        "राष्ट्रकूट साम्राज्य",
        "चोल साम्राज्य"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "अरब व्यापारी सुलेमान ने पाल साम्राज्य को रुहमा (Dharma या धर्मपाल का संक्षिप्त रूप) कहा और इसकी सैन्य शक्ति का वर्णन किया। [2]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989574-1668-la6i",
      "text_hi": "बगदाद के निवासी अल-मसूदी ने 915-16 ई. में भारत की यात्रा की। उसने किस गुर्जर-प्रतिहार शासक के समय का वर्णन किया है?",
      "text_en": "",
      "options_hi": [
        "मिहिर भोज",
        "नागभट्ट द्वितीय",
        "महिपाल",
        "इंद्र तृतीय"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "अल-मसूदी ने प्रतिहार साम्राज्य को 'अल-जुज़्र' कहा और राजा को 'बौरा' कहा। यह महिपाल के शासनकाल का समय था। [4]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989575-1669-h19c",
      "text_hi": "एलोरा में चट्टान काटकर बनाए गए प्रसिद्ध शिव मंदिर का निर्माण किस राष्ट्रकूट राजा ने करवाया था?",
      "text_en": "",
      "options_hi": [
        "अमोघवर्ष",
        "कृष्ण प्रथम",
        "दंतिदुर्ग",
        "इंद्र तृतीय"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "एलोरा के प्रसिद्ध रॉक-कट शिव मंदिर का निर्माण 9वीं शताब्दी में राष्ट्रकूट राजा कृष्ण प्रथम ने करवाया था। [5]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989575-1670-1eo6",
      "text_hi": "कन्नड़ भाषा में काव्यशास्त्र (Poetics) पर पहली पुस्तक लिखने का श्रेय किस राष्ट्रकूट शासक को जाता है?",
      "text_en": "",
      "options_hi": [
        "गोविंद तृतीय",
        "दंतिदुर्ग",
        "अमोघवर्ष",
        "कृष्ण तृतीय"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "राष्ट्रकूट शासक अमोघवर्ष (814-878) का झुकाव युद्ध से अधिक धर्म और साहित्य की ओर था, और उसने कन्नड़ में काव्यशास्त्र पर पुस्तक लिखी। [6]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989575-1671-2bb5",
      "text_hi": "चोल साम्राज्य का संस्थापक कौन था, जिसने 850 ई. में तंजौर पर कब्जा किया था?",
      "text_en": "",
      "options_hi": [
        "राजराजा प्रथम",
        "राजेंद्र प्रथम",
        "विजयालय",
        "परांतक प्रथम"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "विजयालय, जो पहले पल्लवों का सामंत था, ने 850 ई. में तंजौर पर कब्जा कर चोल साम्राज्य की नींव रखी। [7]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989576-1672-okei",
      "text_hi": "तंजौर का प्रसिद्ध 'बृहदीश्वर मंदिर' किस चोल शासक द्वारा बनवाया गया था?",
      "text_en": "",
      "options_hi": [
        "विजयालय",
        "राजेंद्र प्रथम",
        "परांतक",
        "राजराजा प्रथम"
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "राजराजा प्रथम (985-1014) ने तंजौर में शिव को समर्पित बृहदीश्वर मंदिर (राजराजेश्वर मंदिर) बनवाया जो 1010 में पूरा हुआ। [8]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989576-1673-virm",
      "text_hi": "कलिंग और बंगाल के राजाओं को हराने के बाद किस चोल शासक ने 'गंगईकोंडचोल' की उपाधि धारण की?",
      "text_en": "",
      "options_hi": [
        "राजराजा प्रथम",
        "राजेंद्र प्रथम",
        "राजेंद्र द्वितीय",
        "कुलोत्तुंग प्रथम"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "राजेंद्र प्रथम की सेना ने 1022 में गंगा नदी पार कर विजय प्राप्त की, जिसकी याद में उसने 'गंगईकोंडचोल' की उपाधि ली और नई राजधानी बसाई। [8, 9]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989576-1674-v0sv",
      "text_hi": "श्री विजय साम्राज्य (सुमात्रा, मलाया) के खिलाफ सफल नौसैनिक अभियान किस चोल शासक ने भेजा था?",
      "text_en": "",
      "options_hi": [
        "राजराजा प्रथम",
        "राजेंद्र प्रथम",
        "विजयालय",
        "परांतक"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "राजेंद्र प्रथम ने चीन के साथ व्यापारिक मार्ग की बाधाओं को दूर करने के लिए श्री विजय साम्राज्य के खिलाफ एक शक्तिशाली नौसेना भेजी थी। [9, 10]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989576-1675-5bwl",
      "text_hi": "चोल प्रशासन में ब्राह्मणों की बस्तियों वाली स्वायत्त गाँव की सभा (Assembly) को क्या कहा जाता था?",
      "text_en": "",
      "options_hi": [
        "उर",
        "नाडू",
        "महासभा (सभा)",
        "मंडलम"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "महासभा या सभा चोल प्रशासन में ब्राह्मण गाँवों (अग्रहारम) के वयस्क पुरुषों की एक स्वायत्त संस्था थी जो गाँव का प्रबंधन करती थी। [11]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989577-1676-6twj",
      "text_hi": "चोल काल में द्रविड़ वास्तुकला शैली के तहत गर्भगृह के ऊपर बनी बहुमंजिला संरचना को क्या कहा जाता था?",
      "text_en": "",
      "options_hi": [
        "मंडप",
        "गोपुरम",
        "विमान",
        "शिखर"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "द्रविड़ शैली में मुख्य देवता के कक्ष (गर्भगृह) के ऊपर 5 से 7 मंजिला ऊँची संरचना बनाई जाती थी जिसे 'विमान' (Vimana) कहा जाता था। [12]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989577-1677-amsg",
      "text_hi": "ग्यारहवीं-बारहवीं शताब्दी के किस कवि को तमिल साहित्य के 'स्वर्ण युग' का प्रतीक माना जाता है और जिन्होंने 'तमिल रामायण' लिखी?",
      "text_en": "",
      "options_hi": [
        "तोलकाप्पियर",
        "नन्नैया",
        "कंबन",
        "तिक्कन्ना"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "चोल दरबार से जुड़े कवि कंबन की रामायण को तमिल साहित्य का एक क्लासिक ग्रंथ (स्वर्ण युग) माना जाता है। [13]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989578-1678-v294",
      "text_hi": "दक्षिण भारत में अलवार और नयनार संतों द्वारा चलाए गए 'भक्ति आंदोलन' ने मुख्य रूप से किस भाषा का प्रयोग किया?",
      "text_en": "",
      "options_hi": [
        "संस्कृत",
        "तेलुगु",
        "कन्नड़",
        "तमिल"
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "इन संतों ने आम जनता तक अपना संदेश पहुँचाने के लिए संस्कृत के बजाय स्थानीय भाषा 'तमिल' का प्रयोग किया। [14]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989578-1679-9xn3",
      "text_hi": "12वीं शताब्दी में कर्नाटक में 'लिंगायत' (वीर शैव) आंदोलन की स्थापना किसने की थी?",
      "text_en": "",
      "options_hi": [
        "रामानुज",
        "बासव और चन्नाबासव",
        "माधवाचार्य",
        "शंकराचार्य"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "लिंगायत आंदोलन की स्थापना कलचुरी राजाओं के दरबार से जुड़े बासव और उनके भतीजे चन्नाबासव ने की थी। [15]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989578-1680-ju2c",
      "text_hi": "अद्वैतवाद (Non-dualism) के दर्शन का प्रतिपादन किसने किया था?",
      "text_en": "",
      "options_hi": [
        "रामानुज",
        "माधवाचार्य",
        "शंकराचार्य",
        "वल्लभाचार्य"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "केरल में जन्मे शंकराचार्य ने 'अद्वैतवाद' का दर्शन दिया, जिसके अनुसार ईश्वर और निर्मित विश्व एक ही हैं (ब्रह्म सत्य, जगत मिथ्या)। [16]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989578-1681-ykdb",
      "text_hi": "शाहनामा' की रचना किसने की, जिसमें प्राचीन ईरानी नायकों का महिमामंडन किया गया है?",
      "text_en": "",
      "options_hi": [
        "अल-बरूनी",
        "उत्बी",
        "फिरदौसी",
        "अमीर खुसरो"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "महमूद गजनवी के राजकवि फिरदौसी ने 'शाहनामा' की रचना की, जो ईरानी पुनर्जागरण और देशभक्ति का प्रतीक बना। [17]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989579-1682-cqsf",
      "text_hi": "महमूद गजनवी ने गुजरात के प्रसिद्ध सोमनाथ मंदिर पर किस वर्ष आक्रमण किया था?",
      "text_en": "",
      "options_hi": [
        "1015",
        "1018",
        "1025",
        "1030"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "1025 में महमूद गजनवी ने मुल्तान और जैसलमेर के रास्ते सोमनाथ पर हमला कर मंदिर को नष्ट किया और भारी संपत्ति लूटी। [18]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989579-1683-ih31",
      "text_hi": "तराइन का प्रथम युद्ध (1191) किन दो शासकों के बीच लड़ा गया था?",
      "text_en": "",
      "options_hi": [
        "महमूद गजनवी और जयपाल",
        "मुइज़ुद्दीन मुहम्मद (गोरी) और पृथ्वीराज चौहान",
        "बाबर और इब्राहिम लोदी",
        "अलाउद्दीन खिलजी और राणा हम्मीर"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "1191 में लड़े गए तराइन के प्रथम युद्ध में पृथ्वीराज चौहान ने मुइज़ुद्दीन मुहम्मद (मुहम्मद गोरी) को बुरी तरह पराजित किया था। [19]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989579-1684-k2lc",
      "text_hi": "बिहार के प्रसिद्ध बौद्ध मठों - नालंदा और विक्रमशिला को किस तुर्क सेनापति ने नष्ट किया था?",
      "text_en": "",
      "options_hi": [
        "कुतुबुद्दीन ऐबक",
        "बख्तियार खिलजी",
        "इल्तुतमिश",
        "महमूद गजनवी"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "बख्तियार खिलजी ने बिहार पर अपने छापों के दौरान नालंदा और विक्रमशिला के बौद्ध मठों पर हमला कर उन्हें नष्ट कर दिया था। [20]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989579-1685-ge7x",
      "text_hi": "1210 ई. में 'चौगान' (पोलो) खेलते समय घोड़े से गिरने के कारण किस शासक की मृत्यु हो गई थी?",
      "text_en": "",
      "options_hi": [
        "मुहम्मद गोरी",
        "इल्तुतमिश",
        "कुतुबुद्दीन ऐबक",
        "बलबन"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "तुर्क शासक कुतुबुद्दीन ऐबक की मृत्यु 1210 में चौगान खेलते समय घोड़े से गिरने से लगी चोटों के कारण हुई थी। [21]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989579-1686-fkf4",
      "text_hi": "उत्तर भारत में तुर्क विजयों का वास्तविक सुदृढ़कर्ता (Consolidator) किसे माना जाता है?",
      "text_en": "",
      "options_hi": [
        "कुतुबुद्दीन ऐबक",
        "इल्तुतमिश",
        "बलबन",
        "रज़िया"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "इल्तुतमिश (1210-36) ने विद्रोहों को कुचला और मंगोल खतरे से दिल्ली को बचाकर तुर्क शासन को वास्तव में सुदृढ़ किया। [21]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989580-1687-x8gc",
      "text_hi": "इल्तुतमिश के समय भारत की उत्तर-पश्चिमी सीमा पर किस खूंखार मंगोल नेता का आक्रमण का खतरा मंडरा रहा था?",
      "text_en": "",
      "options_hi": [
        "तैमूर लंग",
        "चंगेज खान",
        "हलाकू",
        "दवा खान"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "ख्वारिज़्मी साम्राज्य को नष्ट करने के बाद 1221 में चंगेज खान जलालुद्दीन का पीछा करते हुए सिंधु नदी तक आ पहुँचा था। [22, 23]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989580-1688-ozzg",
      "text_hi": "दिल्ली सल्तनत की गद्दी पर बैठने वाली एकमात्र महिला शासिका कौन थी?",
      "text_en": "",
      "options_hi": [
        "चांद बीबी",
        "रानी दुर्गावती",
        "रज़िया सुल्तान",
        "नूरजहां"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "इल्तुतमिश ने अपने अयोग्य पुत्रों के बजाय अपनी पुत्री रज़िया (1236-39) को अपना उत्तराधिकारी नामित किया था। [24]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989580-1689-lkbx",
      "text_hi": "दिल्ली सल्तनत के किस शासक ने मेवाती और अन्य विद्रोहियों का दमन करने के लिए 'रक्त और लौह' (Blood and Iron) की नीति अपनाई?",
      "text_en": "",
      "options_hi": [
        "इल्तुतमिश",
        "अलाउद्दीन खिलजी",
        "मोहम्मद बिन तुगलक",
        "बलबन"
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "बलबन ने कानून और व्यवस्था बनाए रखने के लिए यह कठोर नीति अपनाई और विद्रोहियों का क्रूरतापूर्वक दमन किया। [25]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989581-1690-pnnt",
      "text_hi": "बलबन ने दरबार में सुल्तान की गरिमा बढ़ाने के लिए कौन सी गैर-इस्लामी ईरानी प्रथाएँ शुरू कीं?",
      "text_en": "",
      "options_hi": [
        "नवरोज़ और दाग",
        "सिजदा और पैबोस",
        "इक्ता और खलीसा",
        "चेहरा और दाग"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "बलबन ने 'सिजदा' (साष्टांग प्रणाम) और 'पैबोस' (सुल्तान के पैर चूमना) जैसी ईरानी दरबार की प्रथाओं को अनिवार्य कर दिया था। [26]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989581-1691-0cia",
      "text_hi": "1290 ई. में गुलाम वंश (इल्बारी तुर्क) को उखाड़ फेंककर दिल्ली में खिलजी वंश की स्थापना किसने की?",
      "text_en": "",
      "options_hi": [
        "अलाउद्दीन खिलजी",
        "जलालुद्दीन खिलजी",
        "बख्तियार खिलजी",
        "कुतुबुद्दीन मुबारक़ शाह"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "गैर-तुर्की गुट के नेता जलालुद्दीन खिलजी ने 1290 में दिल्ली में खिलजी वंश की स्थापना की। [27, 28]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989581-1692-v6m2",
      "text_hi": "दिल्ली सल्तनत का वह कौन सा सुल्तान था जिसने आवश्यक वस्तुओं की कीमतें नियंत्रित करने के लिए बाज़ार नियंत्रण प्रणाली (Market Control) लागू की?",
      "text_en": "",
      "options_hi": [
        "इल्तुतमिश",
        "बलबन",
        "अलाउद्दीन खिलजी",
        "सिकंदर लोदी"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "अलाउद्दीन खिलजी ने एक बड़ी सेना को कम वेतन पर बनाए रखने के लिए खाद्यान्न से लेकर घोड़ों तक की कीमतें तय कर दी थीं। [29, 30]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989581-1693-kvg1",
      "text_hi": "दोआब क्षेत्र में भूमि की पैमाइश (Measurement) के आधार पर भू-राजस्व का निर्धारण करने वाला दिल्ली का पहला सुल्तान कौन था?",
      "text_en": "",
      "options_hi": [
        "गयासुद्दीन तुगलक",
        "फिरोज शाह तुगलक",
        "अलाउद्दीन खिलजी",
        "मुहम्मद बिन तुगलक"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "अलाउद्दीन खिलजी ने ज़ब्ती प्रणाली की नींव रखी और पैमाइश के आधार पर कर लगाया ताकि अमीर जमींदार अपना बोझ गरीबों पर न डाल सकें। [31]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989582-1694-fgm4",
      "text_hi": "अलाउद्दीन खिलजी के दक्षिण अभियानों (विशेषकर वारंगल और द्वारसमुद्र) का नेतृत्व किस सेनापति ने किया था?",
      "text_en": "",
      "options_hi": [
        "उलूग खान",
        "ज़फ़र खान",
        "मलिक काफूर",
        "अल्प खान"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "अलाउद्दीन के गुलाम सेनापति मलिक काफूर ने दक्षिण भारत में सुदूर मदुरै तक सफल सैन्य अभियान किए और अपार धन लूटा। [32, 33]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989582-1695-60rd",
      "text_hi": "देवगिरि को अपनी दूसरी राजधानी बनाने का प्रयोग किस सुल्तान ने किया था जिसे बाद में 'दौलताबाद' नाम दिया गया?",
      "text_en": "",
      "options_hi": [
        "अलाउद्दीन खिलजी",
        "मुहम्मद बिन तुगलक",
        "फिरोज शाह तुगलक",
        "बलबन"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "दक्षिण भारत को बेहतर तरीके से नियंत्रित करने के लिए मुहम्मद बिन तुगलक ने राजधानी को दिल्ली से देवगिरि (दौलताबाद) स्थानांतरित करने का प्रयास किया। [34]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989582-1696-dngh",
      "text_hi": "मुहम्मद बिन तुगलक ने चांदी की कमी के कारण किस धातु की 'प्रतीक मुद्रा' (Token Currency) चलाई थी?",
      "text_en": "",
      "options_hi": [
        "सोना",
        "लोहा",
        "तांबा",
        "कांस्य (Bronze)"
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "मुहम्मद तुगलक ने चांदी के टंका के मूल्य के बराबर कांस्य (Bronze) के सिक्के चलाए, लेकिन जालसाजी के कारण यह प्रयोग विफल रहा। [35]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989582-1697-2vff",
      "text_hi": "मुहम्मद बिन तुगलक ने कृषि के विस्तार और सुधार के लिए कौन सा नया विभाग स्थापित किया था?",
      "text_en": "",
      "options_hi": [
        "दीवान-ए-अर्ज",
        "दीवान-ए-रिसालत",
        "दीवान-ए-अमीर-ए-कोही",
        "दीवान-ए-इंशा"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "उसने खेती का विस्तार करने और किसानों को ऋण (तकावी) देने के लिए 'दीवान-ए-अमीर-ए-कोही' नामक अलग विभाग बनाया था। [36]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989583-1698-ji0f",
      "text_hi": "सल्तनत काल में सिंचाई के लिए सतलज से हांसी तक लंबी नहर का निर्माण और हिसार, जौनपुर जैसे नए नगर किस सुल्तान ने बसाए?",
      "text_en": "",
      "options_hi": [
        "अलाउद्दीन खिलजी",
        "मुहम्मद बिन तुगलक",
        "फिरोज शाह तुगलक",
        "सिकंदर लोदी"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "फिरोज शाह तुगलक (1351-88) ने लोक निर्माण विभाग स्थापित किया, नहरें बनवाईं और फिरोजाबाद, हिसार जैसे नगर बसाए। [37]",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989583-1699-bztu",
      "text_hi": "1398 ई. में दिल्ली पर किस विदेशी आक्रमणकारी ने भयानक हमला कर भारी लूटपाट और कत्लेआम किया?",
      "text_en": "",
      "options_hi": [
        "चंगेज खान",
