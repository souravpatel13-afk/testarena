      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "दारा शिकोह ने उपनिषदों का फारसी अनुवाद 'सिर्र-ए-अकबर' (महान रहस्य) के नाम से किया, जिसने भारतीय दर्शन को यूरोप तक पहुंचाया।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989202-341-en90",
      "text_hi": "औरंगजेब ने सार्वजनिक स्थानों पर इस्लामी नियमों (शरिया) का पालन सुनिश्चित करने और शराब-जुए को रोकने के लिए किस अधिकारी की नियुक्ति की थी?",
      "text_en": "",
      "options_hi": [
