      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "हिन्दी व्याकरण",
      "topic": "संज्ञा",
      "exam": "",
      "explanation_hi": "जिस संज्ञा से व्यक्तियों या वस्तुओं के समूह का बोध हो, उसे समूहवाचक संज्ञा कहते हैं, जैसे- परिवार, सेना।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989415-1089-jw7b",
      "text_hi": "नदी' शब्द किस संज्ञा के अंतर्गत आता है?",
      "text_en": "",
      "options_hi": [
        "भाववाचक",
        "व्यक्तिवाचक",
        "जातिवाचक",
        "समूहवाचक"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "हिन्दी व्याकरण",
      "topic": "संज्ञा",
      "exam": "",
      "explanation_hi": "नदी' शब्द से पूरी जाति का बोध होता है, अतः यह जातिवाचक संज्ञा है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989415-1090-dz72",
      "text_hi": "इनमें से कौन सा व्यक्तिवाचक संज्ञा का उदाहरण है?",
      "text_en": "",
      "options_hi": [
        "राम",
        "पानी",
        "मिठास",
        "भीड़"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "हिन्दी व्याकरण",
      "topic": "संज्ञा",
      "exam": "",
      "explanation_hi": "राम एक विशेष व्यक्ति का नाम है, इसलिए यह व्यक्तिवाचक संज्ञा है।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989415-1091-k3eb",
      "text_hi": "हिन्दी में मूल सर्वनामों की संख्या कितनी होती है?",
      "text_en": "",
      "options_hi": [
        "6",
        "11",
        "4",
        "8"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "हिन्दी व्याकरण",
      "topic": "सर्वनाम",
      "exam": "",
      "explanation_hi": "हिन्दी में कुल 11 सर्वनाम (मैं, तुम, आप, यह, वह, जो, सो, कोई, कुछ, कौन, क्या) होते हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989415-1092-zill",
      "text_hi": "मैं' और 'हम' किस पुरुषवाचक सर्वनाम के उदाहरण हैं?",
      "text_en": "",
      "options_hi": [
        "उत्तम पुरुष",
        "मध्यम पुरुष",
        "अन्य पुरुष",
