      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "सामूगढ़ के निर्णायक युद्ध में औरंगजेब ने दारा शिकोह की मुख्य सेना को हरा दिया, जिससे उसका दिल्ली के तख्त पर बैठना तय हो गया।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989201-340-lpz5",
      "text_hi": "शाहजहां के बड़े बेटे 'दारा शिकोह' ने बनारस के ब्राह्मणों की मदद से 52 उपनिषदों का फारसी में अनुवाद किस नाम से किया था?",
      "text_en": "",
      "options_hi": [
        "मज्म-उल-बहरीन",
        "रज़्मनामा",
