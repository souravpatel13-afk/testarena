        "चिटनिस"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "सुमंत या दबीर विदेशी मामलों का मंत्री होता था जो दूसरे राज्यों से आने वाले दूतों का स्वागत और संधियों का कार्य देखता था।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989194-314-krwf",
      "text_hi": "मराठों द्वारा उन क्षेत्रों से वसूला जाने वाला कर क्या कहलाता था जो कानूनी रूप से मुगलों या अन्य के अधीन थे, ताकि वहां मराठा आक्रमण न हो?",
      "text_en": "",
      "options_hi": [
        "सरदेशमुखी",
        "जजिया",
        "ज़कात",
        "चौथ (Chauth)"
      ],
      "options_en": [],
      "correctAnswer": 3,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "चौथ मुग़ल या पड़ोसी राज्यों की कुल राजस्व आय का 25% (एक-चौथाई) होता था जिसे मराठा सुरक्षा कर के रूप में वसूलते थे।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989194-315-iwp7",
      "text_hi": "शिवाजी के बाद किसने मुगलों की कैद से छूटकर 1707 में 'खेड़ा के युद्ध' में ताराबाई को हराकर मराठा गद्दी प्राप्त की?",
      "text_en": "",
      "options_hi": [
        "शंभाजी",
        "राजाराम",
        "साहू (Shahu)",
        "बाजीराव प्रथम"
      ],
      "options_en": [],
      "correctAnswer": 2,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "शिवाजी के पोते साहू को मुगलों (आजम शाह) ने 1707 में रिहा कर दिया, जिसके बाद उसने अपनी चाची ताराबाई को खेड़ा के युद्ध में हराया।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989195-316-t96z",
      "text_hi": "विजयनगर साम्राज्य में समाज को मुख्य रूप से दो वर्गों में विभाजित देखा गया, वे दो प्रमुख व्यापारी/कारीगर समूह कौन से थे?",
      "text_en": "",
      "options_hi": [
        "ब्राह्मण और क्षत्रिय",
        "इदांगई (Idangai) और वलंगई (Valangai)",
        "वैश्य और शूद्र",
        "नट और चिट्टियार"
      ],
      "options_en": [],
      "correctAnswer": 1,
      "subject": "भारतीय इतिहास",
      "topic": "मध्यकालीन भारत",
      "exam": "",
      "explanation_hi": "दक्षिण भारत में जातियां वामपंथी (Idangai - मुख्य रूप से कारीगर) और दक्षिणपंथी (Valangai - कृषक/व्यापारी) समूहों में बंटी हुई थीं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989195-317-0hay",
      "text_hi": "विजयनगर साम्राज्य के सबसे महान शासक 'कृष्णदेव राय' के दरबार में आठ महान तेलुगु कवियों के समूह को क्या कहा जाता था?",
