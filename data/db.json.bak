    {
      "id": "q-sheet-1785335989429-1138-jju6",
      "text_hi": "राजा-रंक' शब्द में कौन सा समास है?",
      "text_en": "",
      "options_hi": [
        "तत्पुरुष समास",
        "बहुव्रीहि समास",
        "द्विगु समास",
