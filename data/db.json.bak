    {
      "id": "q-sheet-1785335989402-1042-hlhz",
      "text_hi": "निर्देश- नीचे दिए गए कथन [As] और कारण [R] के लिए सही विकल्प चुनें: कथन [As]: 'दही' और 'मोती' हिन्दी में पुर्लिंग शब्द माने जाते हैं। कारण [R]: हिन्दी में प्रायः ईकारांत (अंत में 'ई' की मात्रा वाले) संज्ञाएँ स्त्रीलिंग होती हैं, परंतु दही, मोती, पानी, घी इसके अपवाद हैं।",
      "text_en": "",
      "options_hi": [
        "[As] और [R] दोनों सत्य हैं, और [R], [As] की सही व्याख्या है।",
        "[As] और [R] दोनों सत्य हैं, लेकिन [R], [As] की सही व्याख्या नहीं है।",
        "[As] सत्य है, लेकिन [R] असत्य है।",
        "[As] असत्य है, लेकिन [R] सत्य है।"
      ],
      "options_en": [],
      "correctAnswer": 0,
      "subject": "हिन्दी व्याकरण",
      "topic": "लिंग",
      "exam": "",
      "explanation_hi": "ईकारांत शब्द साधारणतः स्त्रीलिंग होते हैं (जैसे- नदी, रोटी), लेकिन 'दही, मोती, पानी, घी' इसके प्रमुख अपवाद हैं और पुर्लिंग होते हैं।",
      "explanation_en": ""
    },
    {
      "id": "q-sheet-1785335989402-1043-oy4y",
      "text_hi": "निर्देश- नीचे दिए गए कथन [As] और कारण [R] के लिए सही विकल्प चुनें: कथन [As]: 'प्राण', 'आँसू' और 'दर्शन' शब्द हमेशा बहुवचन में प्रयुक्त होते हैं। कारण [R]: कुछ शब्द अपने अर्थ में बहुलता या सम्मान को दर्शाने के कारण सदैव बहुवचन रूप में ही व्यवहार में लाए जाते हैं।",
